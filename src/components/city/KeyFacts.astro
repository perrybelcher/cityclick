---
import SourceNote from './SourceNote.astro';
import type { SourcedQuestion } from '../../lib/city-v2';
interface Props { questions: SourcedQuestion[]; }
const { questions } = Astro.props;
---
{questions.length > 0 && <section class="section" id="key-facts" aria-labelledby="facts-title">
  <div class="section-heading"><p class="eyebrow">The evidence, in plain English</p><h2 id="facts-title">Key facts & questions</h2></div>
  <div class="faq-grid">{questions.map(f => <article class="faq" data-fact-paths={f.paths.join(' ')}>
    <h3>{f.q}</h3><p data-answer>{f.a}</p><SourceNote source={f.source} />
  </article>)}</div>
</section>}
