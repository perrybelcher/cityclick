---
import Sources from './Sources.astro';
import { percent, type CityView } from '../../lib/city-v2';
interface Props { city: CityView; }
const { city } = Astro.props;
const tax = city.tax;
---
{tax && <section class="section" id="taxes" aria-labelledby="tax-title">
  <div class="section-heading"><p class="eyebrow">Jurisdiction matters</p><h2 id="tax-title">Sales-tax context</h2><p>This is the named jurisdiction in the source table—not a claim that every address with the city’s postal name has the same rate.</p></div>
  <div class="tax-grid">
    {[['Combined rate', 'combinedSalesTaxRate'], ['State component', 'stateTaxRate'], ['Local component', 'localTaxRate']].map(([label, field]) => <div class="tax-stat"><p>{label}</p><strong data-value-path={`permitsAndTax.${field}`} data-format="fraction-percent">{percent(tax[field as 'combinedSalesTaxRate' | 'stateTaxRate' | 'localTaxRate'])}</strong></div>)}
  </div>
  <Sources sources={[tax.sourceNote]} />
  <p class="small">Confirm the applicable jurisdiction, transaction type and current rate before using it in a business decision.</p>
</section>}
