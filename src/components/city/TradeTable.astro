---
import Sources from './Sources.astro';
import { number, type CityView } from '../../lib/city-v2';
import { tradeChartRows } from '../../lib/city-charts';
interface Props { city: CityView; }
const { city } = Astro.props;
const rows = city.industries;
const chart = tradeChartRows(rows);
const summaryGroups = [{ title: 'Highest relative density', rows: chart.slice(0, 5) }, { title: 'Lowest relative density', rows: chart.slice(-5).reverse() }];
const belowCount = chart.filter(r => r.direction === 'below').length;
---
{rows.length > 0 && <section class="section" id="trade-density" aria-labelledby="trade-title">
  <div class="section-heading"><p class="eyebrow">Employer establishments · postal-area context</p><h2 id="trade-title">A different view of the business landscape</h2><p>ZIP-area density, not city competition. Counts cover employer establishments in the source’s postal ZIP set. The resident denominator uses corresponding statistical ZIP areas. Neither boundary is the city limit.</p></div>
  <div class="scope-note"><strong>Read the boundary before the number.</strong> Density is a descriptive ratio, not evidence of unmet demand, available capacity or profitability. Nonemployer businesses are outside this count.</div>
  {chart.length > 0 && <div class="density-summary">
    <h3>Top {Math.min(5, chart.length)} highest and lowest vs national reference</h3>
    <p>ZIP areas concentrate employers, so most trades read above the national figure; read it as a relative comparison, not as market saturation.</p>
    <p class="small">{belowCount} of {chart.length} trades are below reference. “Lowest” does not mean “below.”</p>
    <div class="density-summary-grid">{summaryGroups.map(g => <div><h4>{g.title}</h4><ul>{g.rows.map(r => <li data-summary-index={r.index}><strong>{r.label}</strong><span>ZIP area <b data-value-path={`industries.${r.index}.per10kResidents`} data-format="number">{number(r.per10kResidents)}</b> / National <b data-value-path={`industries.${r.index}.usAvgPer10k`} data-format="number">{number(r.usAvgPer10k)}</b><em>{r.direction === 'equal' ? 'At reference' : r.direction === 'below' ? 'Below reference' : 'Above reference'}</em></span></li>)}</ul></div>)}</div>
  </div>}
  {chart.length > 0 && <details class="chart-disclosure"><summary>Explore all {chart.length} trade comparisons</summary><figure class="trade-chart" aria-labelledby="density-caption">
    <figcaption id="density-caption"><strong>ZIP-area density against the national reference</strong><span>Employer establishments per ten thousand residents. Sorted by relative difference, highest first. Bar length shows relative difference from each trade’s national value; the center line is that reference.</span></figcaption>
    <div class="chart-legend"><span class="below-key">Below reference</span><span class="above-key">Above reference</span></div>
    <div class="trade-axis" aria-hidden="true"><span>Below</span><span>National reference</span><span>Above</span></div>
    <ul class="chart-rows">{chart.map(r => <li class="chart-row" data-chart-index={r.index} data-direction={r.direction}>
      <div class="chart-label"><strong>{r.label}</strong><span class="chart-values">ZIP area <b data-value-path={`industries.${r.index}.per10kResidents`} data-format="number">{number(r.per10kResidents)}</b> / National <b data-value-path={`industries.${r.index}.usAvgPer10k`} data-format="number">{number(r.usAvgPer10k)}</b> · {r.direction === 'equal' ? 'At reference' : `${r.direction === 'above' ? 'Above' : 'Below'} reference`}</span></div>
      <div class="bar-track" aria-hidden="true"><span class={`density-bar ${r.direction}`} style={`left:${r.left}%;width:${r.width}%`}></span><span class="national-line"></span></div>
    </li>)}</ul>
  </figure></details>}
  <details class="table-disclosure"><summary>Full data table & classifications</summary>
    <div class="table-scroll trade-scroll" role="region" aria-label="ZIP-area trade density" tabindex="0">
      <table class="trade-table"><caption>ZIP-area employer density per ten thousand residents</caption>
        <thead><tr><th scope="col">Industry / classification</th><th scope="col">Employer establishments</th><th scope="col">ZIP-area density</th><th scope="col">National reference</th></tr></thead>
        <tbody>{rows.map(r => <tr data-fact-path={`industries.${r.index}`}>
          <th scope="row">{r.label}<span class="classification">NAICS <span data-value-path={`industries.${r.index}.naicsCode`} data-format="text">{r.naicsCode}</span></span></th>
          <td data-value-path={`industries.${r.index}.establishments`} data-format="number">{number(r.establishments)}</td>
          <td data-value-path={`industries.${r.index}.per10kResidents`} data-format="number">{number(r.per10kResidents)}</td>
          <td data-value-path={`industries.${r.index}.usAvgPer10k`} data-format="number">{number(r.usAvgPer10k)}</td>
        </tr>)}</tbody>
      </table>
    </div>
  </details>
  <Sources sources={rows.map(r => r.sourceNote)}>
    <div class="denominator-notes"><h3>Boundary & denominator evidence by trade</h3>{rows.map(r => <p data-evidence-path={`industries.${r.index}.provenance.evidenceQuote`}><strong>{r.label}: </strong>{r.provenance.evidenceQuote}</p>)}</div>
  </Sources>
</section>}
