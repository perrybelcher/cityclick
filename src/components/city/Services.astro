---
import Card from './Card.astro';
import HospitalList from './HospitalList.astro';
import Sources from './Sources.astro';
import { number, type CityView } from '../../lib/city-v2';
interface Props { city: CityView; includeWater?: boolean; }
const { city, includeWater = false } = Astro.props;
const water = includeWater ? city.water : undefined;
const hospitals = city.hospitals;
---
{(water || hospitals) && <section class="section" id="services" aria-labelledby="services-title">
  <div class="section-heading"><p class="eyebrow">Practical context</p><h2 id="services-title">Services to check</h2><p>Directory records are a starting point. Confirm current services directly with the provider.</p></div>
  {water && <Card title="Water-system record" class="water-card">
    <p class="entity-name">{water.providerName}</p>
    <dl class="detail-list">
      <div><dt>System ID</dt><dd data-value-path="waterUtility.pwsid" data-format="text">{water.pwsid}</dd></div>
      <div><dt>Water source</dt><dd>{water.sourceType}</dd></div>
      <div><dt>System population served</dt><dd data-value-path="waterUtility.populationServed" data-format="number">{number(water.populationServed)}</dd></div>
    </dl>
    <p class="small">A utility-system population, not the city population. Confirm service at your address. This record does not establish current water quality.</p>
  </Card>}
  {hospitals && <div class="hospital-directory" data-hospital-list>
    <p class="eyebrow">CMS hospital directory · {city.name}</p><h3>Hospitals with emergency departments</h3>
    <p class="small">Listed in record order, without a recommendation. This directory is not medical routing advice or a live availability check.</p>
    <HospitalList rows={hospitals.rows.slice(0, 4)} />
    {hospitals.rows.length > 4 && <details class="hospital-more"><summary><span class="show-all">Show all {hospitals.rows.length} hospitals</span><span class="show-less">Show fewer hospitals</span></summary><HospitalList rows={hospitals.rows.slice(4)} /></details>}
  </div>}
  <Sources sources={[...(water ? [water.sourceNote] : []), ...(hospitals ? [hospitals.sourceNote] : [])]} />
</section>}
