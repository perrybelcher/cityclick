---
import IntentNav from './IntentNav.astro';
import LegacyIntent from './LegacyIntent.astro';
import KeyFacts from './KeyFacts.astro';
import StatStrip from './StatStrip.astro';
import Airport from './Airport.astro';
import { factGroups, intentQuestions } from '../../lib/city-charts';
import FactTable from './FactTable.astro';
import Climate from './Climate.astro';
import Services from './Services.astro';
import TradeTable from './TradeTable.astro';
import TaxBlock from './TaxBlock.astro';
import LeaseWorksheet from './LeaseWorksheet.astro';
import { cityRoute, intentLabels, pageCopy, type CityView, type Intent, type Metric } from '../../lib/city-v2';
import { CITY_V2_SITE, CITY_V2_MEDIA, CITY_V2_INDEXABLE } from '../../data/city-v2';
import './city.css';
import './city-r2.css';
interface Props { city: CityView; intent: Intent; }
const { city, intent } = Astro.props;
const copy = pageCopy(city, intent);
const canonical = new URL(cityRoute(city.slug, intent), CITY_V2_SITE.origin).href;
const media = CITY_V2_MEDIA[city.slug];
if (copy.title.length >= 60) throw new Error('Pilot metadata gate failed');
const image = media ? new URL(media.src, CITY_V2_SITE.origin).href : undefined;
const breadcrumbs = [{ name: 'Cities', url: '/' }, { name: city.stateName, url: `/${city.stateCode}/` }, { name: city.name, url: cityRoute(city.slug) }];
if (intent !== 'overview') breadcrumbs.push({ name: intentLabels[intent], url: cityRoute(city.slug, intent) });
// Keep FAQ schema order identical to the themed, visible disclosure groups.
const questions = factGroups.flatMap(g => intentQuestions(city.keyFacts, intent).filter(f => f.paths.some(p => g.prefixes.some(prefix => p.startsWith(prefix)))));
const graph = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: copy.title, description: copy.description, ...(image ? { primaryImageOfPage: { '@type': 'ImageObject', url: image } } : {}), about: { '@type': 'City', '@id': `${new URL(cityRoute(city.slug), CITY_V2_SITE.origin).href}#place`, name: city.name }, breadcrumb: { '@id': `${canonical}#breadcrumbs` } },
  { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumbs`, itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.url, CITY_V2_SITE.origin).href })) },
  ...(questions.length ? [{ '@type': 'FAQPage', mainEntity: questions.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
] };
const safeJson = JSON.stringify(graph).replaceAll('<', String.raw`\u003c`);
const overviewStats = [...city.population, city.stats[0], city.housing[1]].filter((metric): metric is Metric => metric !== undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title><meta name="description" content={copy.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={CITY_V2_INDEXABLE ? 'index, follow' : 'noindex, follow'} />
    <meta name="cityclick-template" content="city-v2-pilot" />
    <meta property="og:type" content="website" /><meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} /><meta property="og:url" content={canonical} />
    {image && <><meta property="og:image" content={image} /><meta property="og:image:alt" content={`${city.name}, ${city.stateName}`} /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={safeJson} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="container header-inner"><a class="wordmark" href="/">{CITY_V2_SITE.name}<span aria-hidden="true">/</span></a><span class="header-note">The city decision desk</span><a href="#sources" class="header-source">Read the evidence ↗</a></div></header>
    <main id="main" class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{breadcrumbs.map((b, i) => <li>{i < breadcrumbs.length - 1 ? <a href={b.url}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol></nav>
      <div class="pilot-note">Research preview · Not for indexing</div>
      <section class:list={["hero", { "hero-text-only": !media }]} aria-labelledby="page-title">
        <div class="hero-copy"><p class="eyebrow">{intentLabels[intent]} / {city.stateCode.toUpperCase()}</p><h1 id="page-title">{copy.h1}</h1><p class="lead">{copy.lead}</p><p class="byline">{CITY_V2_SITE.imprint}</p></div>
        {media && <figure class="hero-photo"><img src={media.heroSrc} srcset={media.srcset} sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1248px) 46vw, 550px" width={media.width} height={media.height} alt={`${city.name}, ${city.stateName}`} loading="eager" fetchpriority="high" decoding="async" /></figure>}
        {media && <p class="hero-credit">Image credit: local project photograph; rights not yet verified.</p>}
      </section>
      <IntentNav slug={city.slug} intent={intent} sticky />
      {intent === 'overview' && <>
        {overviewStats.length > 0 && <section class="section snapshot-section" aria-labelledby="snapshot-title"><div class="section-heading"><p class="eyebrow">Start with the definitions</p><h2 id="snapshot-title">A city snapshot, with the evidence attached</h2><p>Population estimates and survey figures describe different measures and periods. They are not today’s prices or a quote for your next home.</p></div><StatStrip metrics={overviewStats} strip /></section>}
        <Airport airport={city.airport} />
        <section class="section decision-section" aria-labelledby="decision-title"><div><p class="eyebrow">Choose your next question</p><h2 id="decision-title">Same city.<br />Different decisions.</h2><p>Keep broad context separate from the specifics of your address, property and plans.</p></div><div class="decision-links">
          <a href={cityRoute(city.slug, 'business')}><span class="eyebrow">For an owner or operator</span><h3>What would your lease need to earn?</h3><p>Read ZIP-area employer density, review sourced taxes and test your own numbers.</p><span class="text-link">Open the business guide ↗</span></a>
          <a href={cityRoute(city.slug, 'moving-to')}><span class="eyebrow">For a future resident</span><h3>What do the housing figures actually measure?</h3><p>Separate home values from sale prices, gross rent from asking rent, and a tax proxy from a tax bill.</p><span class="text-link">Open the moving guide ↗</span></a>
          <a href={cityRoute(city.slug, 'visit')}><span class="eyebrow">For a scouting visit</span><h3>What practical context is on record?</h3><p>Airport context, historical climate and emergency-department records, without invented itineraries or travel times.</p><span class="text-link">Open the visitor brief ↗</span></a>
        </div></section>
      </>}
      {intent === 'business' && <>
        {(city.industries.length > 0 || city.tax) && <nav class="on-page" aria-label="On this page"><span>In this guide</span>{city.industries.length > 0 && <a href="#trade-density">Trade density</a>}{city.tax && <><a href="#lease-worksheet">Lease worksheet</a><a href="#taxes">Taxes</a></>}</nav>}
        {city.stats.length > 0 && <section class="section"><div class="section-heading"><p class="eyebrow">City context · a different geography from the trade table</p><h2>Resident income context</h2></div><StatStrip metrics={city.stats.slice(0, 2)} /></section>}
        <TradeTable city={city} />
        {city.tax && <LeaseWorksheet tax={city.tax} />}
        <TaxBlock city={city} />
      </>}
      {intent === 'moving-to' && <>
        {(city.housing.length > 0 || city.climate.length > 0 || city.water || city.hospitals) && <nav class="on-page" aria-label="On this page"><span>In this guide</span>{city.housing.length > 0 && <a href="#housing">Housing & tax proxy</a>}{city.climate.length > 0 && <a href="#climate">Climate</a>}{(city.water || city.hospitals) && <a href="#services">Services</a>}</nav>}
        {city.housing.length > 0 && <section class="section" id="housing"><div class="section-heading"><p class="eyebrow">Household economics</p><h2>Housing values, rents and taxes</h2><p>Use these historical estimates to frame questions. Obtain current housing quotes and parcel-specific taxes separately.</p></div><FactTable metrics={city.housing} caption="Housing estimates and the property-tax proxy" /></section>}
        {city.stats.length > 0 && <section class="section"><div class="section-heading"><p class="eyebrow">Resident context</p><h2>Income and age</h2></div><StatStrip metrics={city.stats} /></section>}
        <Climate metrics={city.climate} /><Services city={city} includeWater />
      </>}
      {intent === 'visit' && <><nav class="on-page" aria-label="In this brief"><span>A practical visit brief</span>{city.airport && <a href="#airport">Arrival</a>}{city.climate.length > 0 && <a href="#climate">Climate</a>}{city.hospitals && <a href="#services">Emergency departments</a>}</nav><Airport airport={city.airport} /><Climate metrics={city.climate} /><Services city={city} /><aside class="coverage-note" aria-labelledby="coverage-title"><h2 id="coverage-title">What we cannot yet verify</h2><p>This brief omits attractions, hotels, restaurants, opening hours, transit schedules, driving times and travel costs. Those topics do not have verified coverage here.</p></aside></>}
      <KeyFacts questions={questions} />
      <section id="sources" class="source-ledger"><div><p class="eyebrow">Scope & limitations</p><h2>Follow the source. Keep the boundary.</h2></div><div><p>Each data section groups its evidence in a Sources & dates block. A checked date is not a new data vintage. Statistical estimates, postal areas and service-system populations describe different things.</p><p>This limited research preview omits unsupported facts. Source links are not a claim of independent certification. No city-wide financial recommendation, medical routing or current-price guarantee is made.</p><a href="/methodology/" class="text-link">Read the methodology ↗</a></div></section>

    </main>
    <footer class="site-footer"><div class="container"><span>{CITY_V2_SITE.imprint}</span><a href="/">Explore cities ↗</a></div></footer>
    {intent === 'overview' && <LegacyIntent slug={city.slug} />}
  </body>
</html>
