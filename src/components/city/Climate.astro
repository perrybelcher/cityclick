---
import Sources from './Sources.astro';
import { formatMetric, type Metric } from '../../lib/city-v2';
interface Props { metrics: Metric[]; }
const { metrics } = Astro.props;
const high = metrics.find(m => m.path === 'climateNormals.peakSummerHighF');
const low = metrics.find(m => m.path === 'climateNormals.winterLowF');
const rain = metrics.find(m => m.path === 'climateNormals.annualRainfallInches');
// Reference scale is a plotting axis, not an observed temperature or comparison.
// Extend for another record rather than clipping its exact values.
const floor = Math.min(0, low?.value ?? 0, high?.value ?? 0);
const ceiling = Math.max(110, low?.value ?? 110, high?.value ?? 110);
const position = (v: number) => (v - floor) / (ceiling - floor) * 100;
---
{high && low && rain && <section class="section climate-section" id="climate" aria-labelledby="climate-title">
  <div class="section-heading"><p class="eyebrow">Seasonal context</p><h2 id="climate-title">Climate, not a forecast</h2><p>Historical reanalysis averages, not station normals.<br />Use them for seasonal context, not a travel forecast.</p></div>
  <div class="climate-graphic" data-climate-chart>
    <div class="temperature-range">
      <div class="climate-endpoints">{[low, high].map(m => <div><h3>{m.label}</h3><p data-value-path={m.path} data-format={m.format}>{formatMetric(m)}</p></div>)}</div>
      <div class="thermometer" role="img" aria-label={`${low.label}: ${formatMetric(low)}; ${high.label}: ${formatMetric(high)}. Temperature scale ${floor} to ${ceiling} degrees Fahrenheit.`}>
        <div class="temperature-track"><span class="temperature-fill" style={`left:${position(low.value)}%;width:${position(high.value)-position(low.value)}%`}></span>{[low,high].map(m => <span class="temperature-marker" data-temperature-path={m.path} style={`left:${position(m.value)}%`}></span>)}</div>
        <div class="temperature-axis" aria-hidden="true"><span>{floor}°F</span><span>{(floor+ceiling)/2}°F</span><span>{ceiling}°F</span></div>
      </div>
      <p class="small">January low → July high. Different months, not a daily temperature range.</p>
    </div>
    <div class="rain-total"><h3>{rain.label}</h3><p class="rain-value" data-value-path={rain.path} data-format={rain.format}>{formatMetric(rain)}</p><p class="small">Historical annual total<br />Rainfall has no temperature scale.</p></div>
  </div>
  <Sources sources={metrics.map(m => m.source)} />
</section>}
