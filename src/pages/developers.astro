---
import Layout from '../layouts/Layout.astro';
import { CERTIFIED_FLAGSHIPS } from '../config/flagships';
---

<Layout
  title="Developer REST API Documentation — CityClick"
  description="Open public REST API access to Census ACS demographics, housing and effective property tax rates, state retail sales tax, and ZBP trade density across US cities."
>
  <section class="bg-gradient-to-b from-[#EDF4FC] to-white py-16 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-4">
        REST API v1 · Open Public Read Access
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-[#152438] tracking-tight">
        Developer API Documentation
      </h1>
      <p class="text-base text-slate-600 mt-3 leading-relaxed">
        Query primary-sourced municipal demographics, housing and effective property tax rates, combined retail sales tax, and underserved Census ZBP trade categories via JSON. Standard public read requests require no API key.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3 text-xs font-bold">
        <a
          href="/openapi.json"
          class="px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-[#1D68F2] text-[#152438] hover:text-[#1D68F2] transition"
        >
          OpenAPI 3.1 Spec (/openapi.json) →
        </a>
        <a
          href="/methodology/"
          class="px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-[#1D68F2] text-[#152438] hover:text-[#1D68F2] transition"
        >
          Data Methodology &amp; Sources →
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <!-- Endpoint Spec -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-xl font-bold text-[#152438]">Endpoint: Get City Summary</h2>
        <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">
          No API Key Required
        </span>
      </div>
      <p class="text-sm text-slate-600 leading-relaxed">
        Returns Census ACS 2023 5-Year and Population Estimates indicators, effective property tax rate, state/local combined retail sales tax, primary-source certification flag (<code>certified</code>), time zone, and underserved NAICS trade labels for a city by two-letter state code and city slug.
      </p>

      <div class="bg-[#152438] rounded-2xl p-5 text-white font-mono text-xs overflow-x-auto space-y-2">
        <div class="text-emerald-400 font-bold">GET https://cityclick.com/api/v1/cities/:state/:city</div>
        <div class="text-slate-400">// Example: https://cityclick.com/api/v1/cities/tx/austin</div>
      </div>

      <h3 class="text-base font-bold text-[#152438] pt-2">Verified Response Example (<code>tx/austin</code>)</h3>
      <div class="bg-slate-900 rounded-2xl p-5 text-blue-300 font-mono text-xs overflow-x-auto">
<pre>&#123;
  "status": "success",
  "data": &#123;
    "slug": "tx/austin",
    "name": "Austin",
    "state": "Texas",
    "stateCode": "tx",
    "population": 979882,
    "medianHouseholdIncome": 91461,
    "popChange2020to2023Pct": 1.9,
    "medianHomeValue": 512700,
    "medianGrossRent": 1655,
    "effectivePropertyTaxRatePct": 1.52,
    "source": "US Census Bureau ACS 2023 5-year; Population Estimates 2023",
    "certified": true,
    "combinedSalesTax": 0.0825,
    "timeZone": "CT",
    "topUnderservedTrades": []
  &#125;
&#125;</pre>
      </div>
    </div>

    <!-- Live Endpoint Tester -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-5">
      <div class="space-y-1">
        <h2 class="text-xl font-bold text-[#152438]">Interactive Live Endpoint Tester</h2>
        <p class="text-sm text-slate-600">
          Execute a real <code>GET /api/v1/cities/:state/:city</code> request directly from your browser against any certified flagship city.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <label for="api-test-slug" class="sr-only">Select certified city</label>
        <select
          id="api-test-slug"
          class="flex-1 px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-sm font-semibold text-slate-800"
        >
          {CERTIFIED_FLAGSHIPS.map((f) => (
            <option value={f.slug}>{f.slug} — {f.name}, {f.stateCode}</option>
          ))}
        </select>
        <button
          id="api-test-btn"
          type="button"
          class="px-6 py-2.5 rounded-xl bg-[#1D68F2] hover:bg-blue-600 text-white font-bold text-sm transition cursor-pointer"
        >
          Try Live Endpoint
        </button>
      </div>

      <div id="api-test-result-wrap" class="hidden space-y-2">
        <div id="api-test-status" class="text-xs font-mono font-bold text-emerald-700"></div>
        <pre
          id="api-test-output"
          class="bg-slate-900 rounded-2xl p-5 text-emerald-300 font-mono text-xs overflow-x-auto max-h-96"
        ></pre>
      </div>
    </div>

    <!-- Bulk & Commercial Integration Contact -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-4">
      <h2 class="text-xl font-bold text-[#152438]">Bulk Data &amp; Commercial Integration Inquiries</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        Standard read requests to <code>/api/v1/cities/:state/:city</code> are open without authentication and cached at the edge. For high-volume batch integrations, custom webhooks, or attribution questions, contact our data engineering desk directly at <a href="mailto:api@cityclick.com" class="text-[#1D68F2] font-bold hover:underline">api@cityclick.com</a>.
      </p>
      <div class="pt-1">
        <a
          href="mailto:api@cityclick.com?subject=CityClick%20API%20Integration%20Inquiry"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition"
        >
          Email api@cityclick.com →
        </a>
      </div>
    </div>
  </section>

  <script>
    const testBtn = document.getElementById('api-test-btn') as HTMLButtonElement | null;
    const slugSelect = document.getElementById('api-test-slug') as HTMLSelectElement | null;
    const resultWrap = document.getElementById('api-test-result-wrap');
    const statusEl = document.getElementById('api-test-status');
    const outputEl = document.getElementById('api-test-output');

    testBtn?.addEventListener('click', async () => {
      const slug = slugSelect?.value || 'tx/austin';
      const url = `/api/v1/cities/${slug}`;
      resultWrap?.classList.remove('hidden');
      if (statusEl) statusEl.textContent = `GET ${url} ...`;
      if (outputEl) outputEl.textContent = '';

      try {
        const t0 = performance.now();
        const res = await fetch(url);
        const elapsed = Math.round(performance.now() - t0);
        const body = await res.json();
        if (statusEl) {
          statusEl.textContent = `HTTP ${res.status} ${res.statusText} · ${url} (${elapsed} ms)`;
        }
        if (outputEl) {
          outputEl.textContent = JSON.stringify(body, null, 2);
        }
      } catch (err: any) {
        if (statusEl) {
          statusEl.textContent = `Request failed for ${url}`;
        }
        if (outputEl) {
          outputEl.textContent = err?.message || 'Network error while reaching API endpoint.';
        }
      }
    });
  </script>
</Layout>
