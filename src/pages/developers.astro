---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Developer API & Municipal Data Feed — CityClick"
  description="Programmatic REST API access to demographic benchmarks, NAICS market saturation, and municipal permit feeds across US metropolitan areas."
>
  <section class="bg-gradient-to-b from-[#EDF4FC] to-white py-16 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-[#1D68F2] text-xs font-bold mb-4">
        REST API v1
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-[#152438] tracking-tight">
        Developer API Documentation
      </h1>
      <p class="text-base text-slate-600 mt-3 leading-relaxed">
        Power your commercial real estate CRM, franchise development portal, or location analysis engine with verified federal and municipal intelligence.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
      <h2 class="text-xl font-bold text-[#152438]">Endpoint: Get City Dossier</h2>
      <p class="text-sm text-slate-600">
        Retrieve demographic baselines, viable scores, and verified municipal permit requirements for a city by state and city slug.
      </p>

      <div class="bg-[#152438] rounded-2xl p-5 text-white font-mono text-xs overflow-x-auto space-y-4">
        <div class="text-emerald-400 font-bold">GET https://cityclick.com/api/v1/cities/:state/:city</div>
        <div class="text-slate-400">// Example: https://cityclick.com/api/v1/cities/tx/austin</div>
      </div>

      <h3 class="text-base font-bold text-[#152438] pt-2">Response Example</h3>
      <div class="bg-slate-900 rounded-2xl p-5 text-blue-300 font-mono text-xs overflow-x-auto">
<pre>&#123;
  "status": "success",
  "data": &#123;
    "slug": "tx/austin",
    "name": "Austin",
    "state": "Texas",
    "stateCode": "tx",
    "population": 979882,
    "popChange2020to2023Pct": 1.9,
    "medianHomeValue": 512700,
    "medianGrossRent": 1655,
    "medianHouseholdIncome": 91461,
    "combinedSalesTax": 0.0825,
    "timeZone": "CT",
    "topUnderservedTrades": [
      "Coin-Operated Laundromats",
      "Barber Shops",
      "Convenience Retail Stores"
    ]
  &#125;
&#125;</pre>
      </div>
    </div>

    <!-- API Key Request Form -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-4">
      <h2 class="text-xl font-bold text-[#152438]">Request Free Developer Key</h2>
      <p class="text-sm text-slate-600">
        Free tier includes 500 requests/month with full access to demographics and NAICS saturation indices.
      </p>
      <form class="space-y-4 max-w-lg pt-2" onsubmit="event.preventDefault(); alert('API Key request received. Keys are being provisioned.');">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Work Email</label>
          <input type="email" placeholder="name@company.com" required class="w-full px-4 py-2.5 border rounded-xl text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Company / Organization</label>
          <input type="text" placeholder="Acme Real Estate Ventures" required class="w-full px-4 py-2.5 border rounded-xl text-sm" />
        </div>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-[#1D68F2] hover:bg-blue-600 text-white font-semibold text-sm transition">
          Generate API Key
        </button>
      </form>
    </div>
  </section>
</Layout>
