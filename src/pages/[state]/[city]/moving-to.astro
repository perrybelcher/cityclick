---
import CityPage from '../../../components/city/CityPage.astro';
import { buildCityView } from '../../../lib/city-v2';
import { CITY_V2_SLUGS } from '../../../data/city-v2';
import { ALL_CITIES } from '../../../data/catalog';
export function getStaticPaths() {
  return CITY_V2_SLUGS.map(slug => {
    const [state, city] = slug.split('/');
    return { params: { state, city }, props: { city: buildCityView(ALL_CITIES.find(c => c.slug === slug)) } };
  });
}
const { city } = Astro.props;
---
<CityPage city={city} intent="moving-to" />
