                </div>
              </div>
              <p class="text-[11px] text-slate-500">
                {city.housingAndTaxes?.homesteadExemptionNote ?? (isAustin ? 'Texas levies 0% state personal income tax, compensated by municipal and school district ad-valorem property tax rates.' : isBoise ? 'Idaho homestead exemption covers 50% of home value up to state cap; low effective ad-valorem rate.' : isTampa ? 'Florida levies 0% personal income tax with Save Our Homes 3% assessment growth cap.' : `Statutory residential ad-valorem tax rates administered by ${city.countyName}.`)}
              </p>
            </div>
          </section>
        </div>

        <!-- ========================================== -->
        <!-- PILLAR 3: DOING BUSINESS                  -->
        <!-- ========================================== -->
        <div id="pillar-business" class="pillar-panel hidden space-y-8" data-industries={JSON.stringify(industriesWithDefaults)}>
