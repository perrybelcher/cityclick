                    class="w-full text-center py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm shadow-lg hover:shadow-xl transition flex items-center justify-center gap-2 cursor-pointer"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                    Print / Save {city.name} Dossier PDF Now
                  </button>
                )}
              </div>
              <div class="mt-2.5 text-center text-[11px] text-slate-500 font-medium">
                Print the figures on this page
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Interactive Scripts (Pillars, Tickers, Leaflet Map, and Sliders) -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>

  <script is:inline>
    function initCityClick() {
      // 1. Live Ticker Switcher
      const tickerBtnEvents = document.getElementById('ticker-btn-events');
      const tickerBtnCommercial = document.getElementById('ticker-btn-commercial');
      const tickerPanelEvents = document.getElementById('ticker-panel-events');
      const tickerPanelCommercial = document.getElementById('ticker-panel-commercial');

      if (tickerBtnEvents && tickerBtnCommercial) {
        tickerBtnEvents.addEventListener('click', () => {
          tickerBtnEvents.classList.add('bg-[#1D68F2]', 'text-white');
          tickerBtnEvents.classList.remove('text-slate-400');
          tickerBtnCommercial.classList.remove('bg-[#1D68F2]', 'text-white');
          tickerBtnCommercial.classList.add('text-slate-400');

          tickerPanelEvents?.classList.remove('hidden');
          tickerPanelCommercial?.classList.add('hidden');
        });

        tickerBtnCommercial.addEventListener('click', () => {
          tickerBtnCommercial.classList.add('bg-[#1D68F2]', 'text-white');
          tickerBtnCommercial.classList.remove('text-slate-400');
          tickerBtnEvents.classList.remove('bg-[#1D68F2]', 'text-white');
          tickerBtnEvents.classList.add('text-slate-400');

          tickerPanelCommercial?.classList.remove('hidden');
          tickerPanelEvents?.classList.add('hidden');
        });
      }

      // 2. The 3 Primary Pillar Switchers
      const pillarBtns = document.querySelectorAll('.pillar-btn');
      const pillarPanels = document.querySelectorAll('.pillar-panel');

      pillarBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-pillar');

          // Reset all card styles
          pillarBtns.forEach((b) => {
            b.classList.remove('border-[#1D68F2]', 'bg-blue-50/70', 'shadow-sm');
            b.classList.add('border-slate-200', 'bg-white');
            const arrow = b.querySelector('.pillar-arrow');
            if (arrow) {
              arrow.classList.remove('text-[#1D68F2]');
              arrow.classList.add('text-slate-300', 'hidden');
            }
          });

          // Activate clicked card
          btn.classList.add('border-[#1D68F2]', 'bg-blue-50/70', 'shadow-sm');
          btn.classList.remove('border-slate-200', 'bg-white');
          const activeArrow = btn.querySelector('.pillar-arrow');
          if (activeArrow) {
            activeArrow.classList.add('text-[#1D68F2]');
            activeArrow.classList.remove('text-slate-300', 'hidden');
          }

          // Toggle Panels
          pillarPanels.forEach((p) => p.classList.add('hidden'));
          const active = document.getElementById(target);
          if (active) active.classList.remove('hidden');

          // Toggle Matching 4-Fact Stats Strip
          document.querySelectorAll('.stats-strip').forEach(s => s.classList.add('hidden'));
          if (target === 'pillar-travel') {
            document.getElementById('stats-strip-travel')?.classList.remove('hidden');
          } else if (target === 'pillar-moving') {
            document.getElementById('stats-strip-moving')?.classList.remove('hidden');
          } else if (target === 'pillar-business') {
            document.getElementById('stats-strip-business')?.classList.remove('hidden');
          }

          // Toggle Matching Adaptive Right Sidebar
          document.querySelectorAll('.sidebar-panel').forEach(s => s.classList.add('hidden'));
          if (target === 'pillar-travel') {
            document.getElementById('sidebar-travel')?.classList.remove('hidden');
          } else if (target === 'pillar-moving') {
            document.getElementById('sidebar-moving')?.classList.remove('hidden');
          } else if (target === 'pillar-business') {
            document.getElementById('sidebar-business')?.classList.remove('hidden');
          }

          // Sync Ticker with selected pillar
          if (target === 'pillar-travel' && tickerBtnEvents) {
            tickerBtnEvents.click();
          } else if (target === 'pillar-business' && tickerBtnCommercial) {
            tickerBtnCommercial.click();
          }

          // Sync Map Layer with selected pillar
          if (target === 'pillar-travel' && window.switchCityMapLayer) {
            window.switchCityMapLayer('visiting');
          } else if (target === 'pillar-moving' && window.switchCityMapLayer) {
            window.switchCityMapLayer('living');
          } else if (target === 'pillar-business' && window.switchCityMapLayer) {
            window.switchCityMapLayer('business');
          }

          if (window.cityClickMap) {
            setTimeout(() => window.cityClickMap.invalidateSize(), 80);
          }
        });
      });

      // 3. Multi-Audience Leaflet Map Initialization
      const mapEl = document.getElementById('city-leaflet-map');
      if (window.L && mapEl) {
        const centerLat = parseFloat(mapEl.getAttribute('data-lat') || '30.2672');
        const centerLng = parseFloat(mapEl.getAttribute('data-lng') || '-97.7431');
        const zoom = parseInt(mapEl.getAttribute('data-zoom') || '13', 10);
        const cityName = mapEl.getAttribute('data-cityname') || 'City';

        const map = L.map('city-leaflet-map', {
          center: [centerLat, centerLng],
          zoom: zoom,
          zoomControl: false,
          scrollWheelZoom: false,
        });
        window.cityClickMap = map;

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap contributors',
          maxZoom: 19,
        }).addTo(map);

        L.control.zoom({ position: 'topright' }).addTo(map);

        const markerLayer = L.layerGroup().addTo(map);

        const cityData = JSON.parse(mapEl.getAttribute('data-map-pins') || '{"visiting":[],"living":[],"business":[]}');

        function switchMapLayer(layer) {
          const btnVisiting = document.getElementById('map-layer-visiting');
          const btnLiving = document.getElementById('map-layer-living');
          const btnBusiness = document.getElementById('map-layer-business');
          const statusEl = document.getElementById('map-pin-status');
          const legendDot = document.getElementById('map-layer-legend-dot');
          const legendText = document.getElementById('map-layer-legend-text');
          const pingIndicator = document.getElementById('map-ping-indicator');

          [btnVisiting, btnLiving, btnBusiness].forEach(btn => {
            if (btn) {
              btn.className = 'map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer text-slate-600 hover:text-slate-900';
            }
          });

          markerLayer.clearLayers();

          let places = cityData[layer] || cityData.visiting;
          let color = '#1D68F2';
          let label = 'Airport';

          if (layer === 'living') {
            color = '#059669';
            label = 'Hospitals with emergency departments';
            if (btnLiving) btnLiving.className = 'map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer bg-emerald-600 text-white shadow-xs';
          } else if (layer === 'business') {
            color = '#7C3AED';
            label = 'Commercial corridors';
            if (btnBusiness) btnBusiness.className = 'map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer bg-purple-600 text-white shadow-xs';
          } else {
            if (btnVisiting) btnVisiting.className = 'map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer bg-[#1D68F2] text-white shadow-xs';
          }

          if (legendDot) legendDot.style.backgroundColor = color;
          if (pingIndicator) pingIndicator.style.backgroundColor = color;
          if (legendText) legendText.innerText = label;
          if (statusEl) statusEl.innerText = places.length + ' places mapped · Click any pin';

          const pinHtml = '<div style="background-color: ' + color + '; width: 14px; height: 14px; border-radius: 50%; border: 3px solid #FFFFFF; box-shadow: 0 0 10px ' + color + 'B3;"></div>';
          const customIcon = L.divIcon({
            className: 'custom-pin-icon',
            html: pinHtml,
            iconSize: [14, 14],
            iconAnchor: [7, 7],
          });

          places.forEach(place => {
            L.marker([place.lat, place.lng], { icon: customIcon })
              .bindPopup(
                '<div style="font-family: inherit; padding: 4px; min-width: 180px;">' +
                  '<div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: ' + color + ';">' + place.category + '</div>' +
                  '<div style="font-weight: 800; font-size: 13px; color: #152438; margin-top: 2px;">' + place.name + '</div>' +
                  (place.address ? '<div style="font-size: 11px; color: #64748B; margin-top: 2px;">' + place.address + '</div>' : '') +
                '</div>'
              )
              .addTo(markerLayer);
          });
        }

        switchMapLayer('visiting');

        document.getElementById('map-layer-visiting')?.addEventListener('click', () => switchMapLayer('visiting'));
        document.getElementById('map-layer-living')?.addEventListener('click', () => switchMapLayer('living'));
        document.getElementById('map-layer-business')?.addEventListener('click', () => switchMapLayer('business'));

        window.switchCityMapLayer = switchMapLayer;
      }

      // 4. Reactive Breakeven Slider Calculation
      const sSqft = document.getElementById('slider-sqft');
      const sRent = document.getElementById('slider-rent');
      const sTicket = document.getElementById('slider-ticket');
      const sCogs = document.getElementById('slider-cogs');
      const sOverhead = document.getElementById('slider-overhead');

      function salesTaxRateOk() { const t = parseFloat(sRent.dataset.tax); return t >= 0 && t < 0.2; }
      function recalculate() {
        if (!sSqft || !sRent || !sTicket || !sCogs || !sOverhead) return;
        const sqft = parseFloat(sSqft.value);
        const rent = parseFloat(sRent.value);
        if (!(rent > 0) || !(salesTaxRateOk())) {
          document.getElementById('label-rent').innerText = 'enter your quote';
          ['output-daily-customers','output-monthly-revenue','output-monthly-fixed'].forEach((id) => { const e = document.getElementById(id); if (e) e.innerText = '—'; });
          return;
        }
        const ticket = parseFloat(sTicket.value);
        const cogsPct = parseFloat(sCogs.value) / 100;
        const overhead = parseFloat(sOverhead.value);

        document.getElementById('label-sqft').innerText = sqft.toLocaleString() + ' sqft';
        document.getElementById('label-rent').innerText = '$' + rent.toFixed(2) + ' / sqft';
        document.getElementById('label-ticket').innerText = '$' + ticket.toFixed(2);
        document.getElementById('label-cogs').innerText = (cogsPct * 100).toFixed(0) + '%';
        document.getElementById('label-overhead').innerText = '$' + Math.round(overhead).toLocaleString();

        const nnn = 6.50; // illustrative CAM/NNN assumption, disclosed in UI
        const wage = 16.50;
        const hours = 120;
        const salesTaxRate = parseFloat(sRent.dataset.tax);

        const monthlyOcc = (sqft * (rent + nnn)) / 12;
        const monthlyLabor = wage * hours * 4.3482 * 1.18;
        const monthlyFixed = monthlyOcc + monthlyLabor + overhead;

        const netTicket = ticket / (1 + salesTaxRate);
        const contributionMargin = netTicket * (1 - cogsPct);

        if (contributionMargin > 0 && ticket > 0 && cogsPct < 1) {
          const monthlyCust = Math.ceil(monthlyFixed / contributionMargin);
          const dailyCust = Math.ceil(monthlyCust / 30.4375);
          const monthlyRev = monthlyFixed / (1 - cogsPct);

          document.getElementById('output-daily-customers').innerText = dailyCust.toString();
          document.getElementById('output-monthly-revenue').innerText = '$' + Math.round(monthlyRev).toLocaleString();
          document.getElementById('output-monthly-fixed').innerText = '$' + Math.round(monthlyFixed).toLocaleString();
        } else {
          document.getElementById('output-daily-customers').innerText = '—';
          document.getElementById('output-monthly-revenue').innerText = 'Invalid Input';
          document.getElementById('output-monthly-fixed').innerText = '$' + Math.round(monthlyFixed).toLocaleString();
        }
      }

      [sSqft, sRent, sTicket, sCogs, sOverhead].forEach((slider) => {
        if (slider) slider.addEventListener('input', recalculate);
      });

      // Run initial recalculation to ensure parity
      recalculate();

      // 5. Video Player Activation
      const videoBox = document.getElementById('video-tour-container');
      if (videoBox) {
        videoBox.addEventListener('click', () => {
          const vId = videoBox.getAttribute('data-video-id');
          if (vId) {
            videoBox.innerHTML = '<iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/' + vId + '?autoplay=1&rel=0" title="Video Tour" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
          }
        });
      }

      // 6. Dynamic 25-Trade & Custom Enterprise Underwriting Engine
      const tradeSelect = document.getElementById('trade-select');
      const customTradeBox = document.getElementById('custom-trade-box');
      const customBusinessNameInput = document.getElementById('custom-business-name');
      const applyCustomNameBtn = document.getElementById('apply-custom-name-btn');
      const toggleCustomBtn = document.getElementById('toggle-custom-btn');
      const industriesData = JSON.parse(document.getElementById('pillar-business')?.getAttribute('data-industries') || '[]');

      function applyTrade(naicsCode, customTitle) {
        if (naicsCode === 'custom') {
          if (customTradeBox) customTradeBox.classList.remove('hidden');
          const entName = customTitle || (customBusinessNameInput ? customBusinessNameInput.value.trim() : '') || 'Custom Commercial Enterprise';

          const labelEl = document.getElementById('active-trade-label');
          if (labelEl) labelEl.innerText = 'Underwriting Pro-Forma — ' + entName;

          const descEl = document.getElementById('active-trade-desc');
          if (descEl) descEl.innerText = 'User-modeled commercial underwriting pro-forma parameters for ' + entName;

          const countEl = document.getElementById('active-trade-count');
          if (countEl) countEl.innerText = 'Custom';

          const densityEl = document.getElementById('active-trade-density');
          if (densityEl) densityEl.innerText = 'User Modeled';

          const benchEl = document.getElementById('active-trade-benchmark');
          if (benchEl) benchEl.innerText = 'Benchmark: Custom Specification';

          const satEl = document.getElementById('active-trade-saturation');
          if (satEl) satEl.innerHTML = 'Custom <span class="text-xs font-normal text-slate-400">Spec</span>';

          const badge = document.getElementById('active-trade-badge');
          if (badge) {
            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-50 text-[#1D68F2] border border-blue-200';
            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span> Custom Enterprise';
          }

          const heroTradeLabel = document.getElementById('hero-trade-label');
          if (heroTradeLabel) heroTradeLabel.innerText = entName;

          if (tradeSelect && tradeSelect.value !== 'custom') {
            tradeSelect.value = 'custom';
          }

          return;
        }

        // Standard 25-trade preset
        if (customTradeBox) customTradeBox.classList.add('hidden');
        const trade = industriesData.find(i => i.naicsCode === naicsCode);
        if (!trade) return;

        const labelEl = document.getElementById('active-trade-label');
        if (labelEl) labelEl.innerText = 'Commercial Establishment Density — ' + trade.label;

        const descEl = document.getElementById('active-trade-desc');
        if (descEl) descEl.innerText = 'Census County Business Patterns (ZBP 2022) small-business metrics';

        const countEl = document.getElementById('active-trade-count');
        if (countEl) countEl.innerText = trade.establishments.toString();

        const densityEl = document.getElementById('active-trade-density');
        if (densityEl) densityEl.innerText = trade.per10kResidents.toString();

        const benchEl = document.getElementById('active-trade-benchmark');
        if (benchEl) benchEl.innerText = 'National Benchmark: ' + trade.usAvgPer10k;

        const satEl = document.getElementById('active-trade-saturation');
        if (satEl) satEl.innerHTML = trade.saturationIndex + ' <span class="text-xs font-normal text-slate-400">/ 100</span>';

        const badge = document.getElementById('active-trade-badge');
        if (badge) {
          badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ' + (
            trade.status === 'underserved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
            trade.status === 'balanced' ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-rose-50 text-rose-700 border border-rose-200'
          );
          badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-current animate-pulse"></span>' + trade.status;
        }

        const heroTradeLabel = document.getElementById('hero-trade-label');
        if (heroTradeLabel) heroTradeLabel.innerText = trade.label;

        if (tradeSelect && tradeSelect.value !== naicsCode) {
          tradeSelect.value = naicsCode;
        }
      }
      if (toggleCustomBtn) {
        toggleCustomBtn.addEventListener('click', () => {
          applyTrade('custom');
          customBusinessNameInput?.focus();
        });
      }

      if (applyCustomNameBtn && customBusinessNameInput) {
        applyCustomNameBtn.addEventListener('click', () => {
          applyTrade('custom', customBusinessNameInput.value.trim());
        });
        customBusinessNameInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            applyTrade('custom', customBusinessNameInput.value.trim());
          }
        });
      }

      if (tradeSelect) {
        tradeSelect.addEventListener('change', (e) => {
          applyTrade(e.target.value);
        });
      }

      document.querySelectorAll('.trade-row').forEach(row => {
        row.addEventListener('click', () => {
          const naics = row.getAttribute('data-naics');
          if (naics) {
            applyTrade(naics);
            document.getElementById('active-trade-label')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });

      // 7. Save City Local Persistence
      const saveBtn = document.getElementById('save-city-btn');
      if (saveBtn) {
        const slug = saveBtn.getAttribute('data-slug');
        const name = saveBtn.getAttribute('data-name');
        const stateCode = saveBtn.getAttribute('data-state');
        const labelSpan = document.getElementById('save-city-label');

        function checkSavedState() {
          const saved = typeof getSavedCities === 'function' ? getSavedCities() : JSON.parse(localStorage.getItem('cityclick_saved_cities') || '[]');
          const isSaved = saved.some(c => c.slug === slug);
          if (isSaved) {
            saveBtn.classList.add('border-emerald-500', 'text-emerald-400');
            if (labelSpan) labelSpan.innerHTML = '<span class="text-emerald-400 font-bold">✓ Saved</span>';
          } else {
            saveBtn.classList.remove('border-emerald-500', 'text-emerald-400');
            if (labelSpan) labelSpan.innerText = 'Save city';
          }
        }

        checkSavedState();

        saveBtn.addEventListener('click', () => {
          let saved = typeof getSavedCities === 'function' ? getSavedCities() : JSON.parse(localStorage.getItem('cityclick_saved_cities') || '[]');
          const exists = saved.some(c => c.slug === slug);

          if (!exists) {
            saved.push({ slug, name, stateCode });
            if (labelSpan) labelSpan.innerHTML = '<span class="text-emerald-400 font-bold">✓ Saved</span>';
          } else {
            saved = saved.filter(c => c.slug !== slug);
            if (labelSpan) labelSpan.innerText = 'Save city';
          }

          if (typeof setSavedCities === 'function') {
            setSavedCities(saved);
          } else {
            localStorage.setItem('cityclick_saved_cities', JSON.stringify(saved));
          }
          checkSavedState();
        });

        window.addEventListener('cityclick_saved_changed', checkSavedState);
      }

      // 8. URL Parameter & Hash Tab Deep-Link
      const urlParams = new URLSearchParams(window.location.search);
      const tabParam = (urlParams.get('tab') || window.location.hash.replace('#', '')).toLowerCase();
      if (tabParam === 'moving' || tabParam === 'live') {
        document.querySelector('button[data-pillar="pillar-moving"]')?.click();
      } else if (tabParam === 'business' || tabParam === 'biz') {
        document.querySelector('button[data-pillar="pillar-business"]')?.click();
      } else if (tabParam === 'travel' || tabParam === 'visit' || tabParam === 'visiting') {
        document.querySelector('button[data-pillar="pillar-travel"]')?.click();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCityClick);
    } else {
      initCityClick();
    }
  </script>
</Layout>
