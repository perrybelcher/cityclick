                  />
                  <button
                    type="button"
                    id="apply-custom-name-btn"
                    class="px-4 py-2.5 rounded-xl bg-[#1D68F2] hover:bg-blue-600 text-white font-bold text-xs shrink-0 cursor-pointer transition shadow-md"
                  >
                    Underwrite
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Commercial Establishment Density & Saturation Metrics -->
