                      <div id="output-daily-customers" class="text-4xl font-black text-[#152438]">—</div>
                      <div class="text-[11px] text-slate-500">transactions per operating day</div>
                    </div>
                    <div>
                      <span class="text-xs text-slate-600">Monthly Net Revenue Needed</span>
                      <div id="output-monthly-revenue" class="text-xl font-bold text-slate-800">—</div>
                    </div>
                    <div>
                      <span class="text-xs text-slate-600">Monthly Fixed Cost (Lease + Labor + Overhead)</span>
                      <div id="output-monthly-fixed" class="text-base font-semibold text-slate-700">—</div>
                    </div>
                  </div>
                </div>
                <div class="text-[11px] text-slate-500 pt-3 border-t border-blue-200">
