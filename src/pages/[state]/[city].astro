                </div>
                <div>
                  <div class="flex justify-between mb-1">
                    <label class="text-slate-700">Monthly Operating Overhead ($)</label>
                    <span id="label-overhead" class="text-blue-600 font-bold">$1,200</span>
                  </div>
                  <input id="slider-overhead" type="range" min="0" max="5000" step="50" value="1200" class="w-full accent-[#1D68F2] cursor-pointer" />
                  <span class="text-[10px] text-slate-400">Utilities, commercial insurance, POS software baseline</span>
                </div>
              </div>

              <!-- Live Output Card -->
