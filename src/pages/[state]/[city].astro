                      title={`Click to underwrite ${ind.label}`}
                    >
                      <td class="py-3.5 pr-4 font-bold text-slate-800 group-hover:text-[#1D68F2] flex items-center gap-1.5">
                        <span>{ind.label}</span>
                        <span class="text-[10px] text-blue-500 opacity-0 group-hover:opacity-100 transition">↗</span>
                      </td>
                      <td class="py-3.5 px-4 font-semibold text-slate-700">{ind.establishments}</td>
                      <td class="py-3.5 px-4 text-slate-600">{ind.per10kResidents}</td>
                      <td class="py-3.5 px-4 text-slate-400">{ind.usAvgPer10k}</td>
                      <td class="py-3.5 pl-4">
                        <span class={`px-2 py-0.5 rounded-full font-bold text-[10px] uppercase tracking-wider ${
                          ind.status === 'underserved' ? 'bg-emerald-100 text-emerald-800' :
                          ind.status === 'balanced' ? 'bg-blue-100 text-blue-800' : 'bg-rose-100 text-rose-800'
                        }`}>
                          {ind.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- Permit & Regulatory Requirements -->
          <section class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] space-y-6">
            <div>
              <h2 class="text-xl font-black text-[#152438]">Permits, Taxes & Municipal Friction</h2>
              <p class="text-xs text-slate-500 mt-0.5">Statutory approvals required to open a commercial space in {city.name}</p>
            </div>

