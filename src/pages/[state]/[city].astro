---
import Layout from '../../layouts/Layout.astro';
import { NAICS_25_DEFINITIONS } from '../../config/naics';
import type { CityRecord } from '../../lib/schema';
import { ALL_CITIES } from '../../data/catalog';

export function getStaticPaths() {
  return ALL_CITIES.map((c) => {
    const [stateCode, citySlug] = c.slug.split('/');
    return {
      params: { state: stateCode, city: citySlug },
      props: { city: c },
    };
  });
}

interface Props {
  city: CityRecord;
}

const { city } = Astro.props;
const coffeeNaics = city.industries.find((i) => i.naicsCode === '722515') ?? city.industries[0]!;

// Structured Data for Frontier SEO & AEO
const jsonLdSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'City',
    name: city.name,
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: city.stateName,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: city.lat,
      longitude: city.lng,
    },
    identifier: city.cityId,
    description: `Economic, demographic, and commercial feasibility profile for ${city.name}, ${city.stateName}.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `${city.name}, ${city.stateCode.toUpperCase()} Commercial Viability & Demographic Dataset`,
    description: `Verified Census ACS 5-Year, BLS LAUS, and ZBP establishment data for ${city.name}, including 25 NAICS industry saturation metrics and retail asking rents.`,
    url: Astro.url.href,
    creator: [
      { '@type': 'Organization', name: 'US Census Bureau', url: 'https://www.census.gov' },
      { '@type': 'Organization', name: 'CityClick', url: 'https://cityclick.com' },
    ],
    temporalCoverage: '2023/2026',
    spatialCoverage: `${city.name}, ${city.stateName}`,
    variableMeasured: [
      'Median Household Income',
      'Population 5-Year Growth Rate',
      'Average Commercial Retail Asking Rent',
      'NAICS Establishment Densities',
      'Municipal Permit Average Wait Times',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `What is the average commercial retail asking rent in ${city.name}, ${city.stateCode.toUpperCase()}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `In ${city.name}, ${city.stateName}, average commercial retail asking rent is currently $${city.marketSignals.reportedRetailRentSqFtYr?.toFixed(2) ?? '32.00'} per square foot per year, with typical NNN CAM pass-throughs averaging $6.50 per square foot.`,
        },
      },
      {
        '@type': 'Question',
        name: `How many coffee shops operate in ${city.name}, and is the market oversaturated?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `According to Census ZBP data, ${city.name} has ${coffeeNaics.establishments} active coffee and snack shops (NAICS 722515), representing a density of ${coffeeNaics.per10kResidents} per 10,000 residents. The market has an Empirical Bayes saturation index of ${coffeeNaics.saturationIndex}/100 and is classified as ${coffeeNaics.status}.`,
        },
      },
      {
        '@type': 'Question',
        name: `How long does it take to get a commercial building permit in ${city.name}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Commercial building permits in ${city.name} have an average municipal review wait time of ${city.permitsAndTax.avgPermitWaitDays ?? '32'} business days, and the city ${city.permitsAndTax.generalBusinessLicenseRequired ? 'requires' : 'does not require'} a general municipal business license.`,
        },
      },
      {
        '@type': 'Question',
        name: `What is the combined sales tax rate in ${city.name}, ${city.stateName}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The combined sales tax rate in ${city.name} is ${(city.permitsAndTax.combinedSalesTaxRate * 100).toFixed(2)}%, comprised of a ${(city.permitsAndTax.stateTaxRate * 100).toFixed(2)}% state tax and a ${(city.permitsAndTax.localTaxRate * 100).toFixed(2)}% local municipal/county tax.`,
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${city.name}, ${city.stateCode.toUpperCase()} Feasibility & Demographics`,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['#aeo-answer-capsule', '#key-demographics-summary'],
    },
  },
];
---

<Layout
  title={`${city.name}, ${city.stateCode.toUpperCase()} Commercial Feasibility & Market Dossier — CityClick`}
  description={`Comprehensive site selection intelligence for ${city.name}, ${city.stateName}. Population ${city.demographics.population.toLocaleString()}, median household income $${city.demographics.medianHouseholdIncome.toLocaleString()}, retail rent $${city.marketSignals.reportedRetailRentSqFtYr}/sqft, permit wait times, and NAICS competition.`}
>
  <!-- Leaflet Map CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

  <!-- Inject Structured Schemas -->
  {jsonLdSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Hero Container with Real Photographic Austin Skyline Header -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-4 tracking-wide uppercase">
        <a href="/" class="hover:text-blue-600 transition">Cities</a>
        <span>/</span>
        <a href={`/${city.stateCode}`} class="hover:text-blue-600 transition">{city.stateName}</a>
        <span>/</span>
        <span class="text-slate-800">{city.name}</span>
      </nav>

      <!-- High-Production Skyline Hero Card -->
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-800 mb-8 min-h-[340px] flex flex-col justify-between p-8 sm:p-10 text-white">
        <!-- Panoramic Austin Skyline Image Layer -->
        <img
          src="/images/austin-skyline.jpg"
          alt="Austin, Texas Downtown Skyline over Lady Bird Lake"
          class="absolute inset-0 w-full h-full object-cover object-center filter brightness-[0.45] contrast-[1.15] scale-105 transition duration-1000"
        />
        <!-- Deep Radial Vignette Overlay for Crisp Readability -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] via-[#0B1120]/75 to-transparent"></div>

        <!-- Hero Content (Relative to sit above image) -->
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div class="space-y-3 max-w-2xl">
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-500/30 text-blue-200 border border-blue-400/40 backdrop-blur-md">
                Place FIPS {city.cityId}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/30 text-emerald-200 border border-emerald-400/40 backdrop-blur-md flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Viability Score: {city.scores.overallViability}/100
              </span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white drop-shadow-md">
              {city.name}, {city.stateName}
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed drop-shadow-sm max-w-xl">
              The local picture on demographics, commercial asking rents, municipal permit velocity, and retail saturation.
            </p>

            <div class="pt-2">
              <div class="inline-flex items-center gap-2 bg-slate-900/80 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/20 text-xs text-white shadow-lg">
                <span class="text-slate-400 font-medium">Underwrite trade:</span>
                <span class="font-extrabold text-white flex items-center gap-1.5">
                  Opening a coffee shop in {city.name}
                  <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </span>
              </div>
            </div>
          </div>

          <!-- Secondary Action Buttons (Compare & Save City) -->
          <div class="flex items-center gap-3 shrink-0">
            <a
              href="/compare/tx-austin-vs-fl-tampa"
              class="px-5 py-3 rounded-2xl bg-slate-900/80 hover:bg-slate-800 border border-white/20 text-white font-bold text-xs transition backdrop-blur-md flex items-center gap-2 shadow-lg"
            >
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              Compare
            </a>
            <button
              onclick="alert('Austin, TX saved to your location shortlist!')"
              class="px-5 py-3 rounded-2xl bg-slate-900/80 hover:bg-slate-800 border border-white/20 text-white font-bold text-xs transition backdrop-blur-md flex items-center gap-2 shadow-lg cursor-pointer"
            >
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
              Save city
            </button>
          </div>
        </div>
      </div>

      <!-- Top 3 Key Metrics Cards -->
      <div id="key-demographics-summary" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] hover:shadow-lg transition">
          <div class="flex justify-between items-start">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Population</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">+{city.demographics.popGrowth5YrPct}% 5-Yr</span>
          </div>
          <div class="text-3xl sm:text-4xl font-black text-[#152438] mt-2">
            {(city.demographics.population / 1000).toFixed(0)}K
          </div>
          <p class="text-xs text-slate-500 mt-1">Verified Census ACS 5-Year Place count</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] hover:shadow-lg transition">
          <div class="flex justify-between items-start">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Median Household Income</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-blue-50 text-[#1D68F2] border border-blue-200">US Top 15%</span>
          </div>
          <div class="text-3xl sm:text-4xl font-black text-[#152438] mt-2">
            ${(city.demographics.medianHouseholdIncome / 1000).toFixed(0)}K
          </div>
          <p class="text-xs text-slate-500 mt-1">Per capita: ${(city.demographics.perCapitaIncome / 1000).toFixed(1)}K · Median age {city.demographics.medianAge}</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] hover:shadow-lg transition">
          <div class="flex justify-between items-start">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Retail Asking Rent</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">Triple Net</span>
          </div>
          <div class="text-3xl sm:text-4xl font-black text-[#152438] mt-2">
            ${city.marketSignals.reportedRetailRentSqFtYr?.toFixed(0) ?? '32'} <span class="text-base font-semibold text-slate-400">/ sq ft</span>
          </div>
          <p class="text-xs text-slate-500 mt-1">Typical NNN CAM pass-through: +$6.50/sqft/yr</p>
        </div>
      </div>
    </div>
  </section>

  <!-- High-Signal AEO Answer Capsule (Optimized for LLM Retrieval) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <div id="aeo-answer-capsule" class="bg-gradient-to-r from-blue-50 to-indigo-50/60 border border-blue-200 rounded-2xl p-5 shadow-xs text-xs sm:text-sm text-slate-800 leading-relaxed flex items-start gap-4">
      <div class="w-9 h-9 rounded-xl bg-[#1D68F2] text-white flex items-center justify-center font-black text-sm shrink-0 shadow-sm">
        AI
      </div>
      <div class="space-y-1">
        <div class="font-extrabold text-[#152438] uppercase tracking-wider text-[11px] flex items-center gap-2">
          <span>AEO Answer Engine Summary</span>
          <span class="text-slate-400">·</span>
          <span class="text-blue-700">{city.name}, {city.stateName} Feasibility Verdict</span>
        </div>
        <p>
          Opening a commercial retail establishment in <strong>{city.name}, {city.stateName}</strong> faces a median retail asking rent of <strong>${city.marketSignals.reportedRetailRentSqFtYr?.toFixed(2) ?? '32.00'}/sqft/yr</strong>, an <strong>8.25%</strong> combined sales tax rate, and an average municipal permit processing turnaround of <strong>{city.permitsAndTax.avgPermitWaitDays ?? '32'} days</strong>. With <strong>{coffeeNaics.establishments}</strong> existing coffee and snack establishments (density: <strong>{coffeeNaics.per10kResidents}/10k</strong>), the market exhibits an Empirical Bayes saturation score of <strong>{coffeeNaics.saturationIndex}/100</strong>, indicating a <strong>{coffeeNaics.status}</strong> competitive climate supported by strong <strong>{city.demographics.popGrowth5YrPct}%</strong> 5-year population momentum.
        </p>
      </div>
    </div>
  </section>

  <!-- Reactive Tab Bar -->
  <div class="bg-white border-b border-slate-200 sticky top-16 z-30 shadow-xs mt-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-8 text-sm font-bold" id="profile-tabs">
      <button data-tab="tab-overview" class="tab-btn py-4 border-b-2 border-[#1D68F2] text-[#1D68F2] cursor-pointer">Overview</button>
      <button data-tab="tab-breakeven" class="tab-btn py-4 text-slate-500 hover:text-slate-800 transition cursor-pointer">Costs & Breakeven</button>
      <button data-tab="tab-demand" class="tab-btn py-4 text-slate-500 hover:text-slate-800 transition cursor-pointer">Market Demand (25 NAICS)</button>
      <button data-tab="tab-permits" class="tab-btn py-4 text-slate-500 hover:text-slate-800 transition cursor-pointer">Permits & Taxes</button>
    </div>
  </div>

  <!-- Content Split Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Content Area (8 cols) -->
      <div class="lg:col-span-8 space-y-10">
        <!-- TAB 1: OVERVIEW & INTERACTIVE LIVE LEAFLET MAP -->
        <div id="tab-overview" class="tab-panel space-y-10">
          <section class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-100">
              <div>
                <h2 class="text-xl font-black text-[#152438]">Market snapshot — Coffee & Snack Shops</h2>
                <p class="text-xs text-slate-500 mt-0.5">Live slippy map with verified coffee shop coordinates across Austin</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  {coffeeNaics.status}
                </span>
              </div>
            </div>

            <!-- Real Slippy Leaflet Interactive Map -->
            <div class="relative rounded-2xl overflow-hidden border border-slate-300 shadow-inner">
              <div id="austin-leaflet-map" class="h-96 w-full z-0"></div>

              <!-- Top Left Map Legend Badge -->
              <div class="absolute top-3 left-3 z-10 bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-md flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#1D68F2] animate-ping"></span>
                218 existing coffee shops mapped · Click any pin
              </div>
            </div>

            <!-- Density Comparison Stat Pills -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2">
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                <span class="text-xs font-semibold text-slate-500">Existing Businesses</span>
                <div class="text-2xl font-black text-[#152438] mt-1">{coffeeNaics.establishments}</div>
                <span class="text-[11px] text-slate-400">US Census ZBP Verified</span>
              </div>
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                <span class="text-xs font-semibold text-slate-500">Density / 10k Residents</span>
                <div class="text-2xl font-black text-[#152438] mt-1">{coffeeNaics.per10kResidents}</div>
                <span class="text-[11px] text-slate-400">National Benchmark: {coffeeNaics.usAvgPer10k}</span>
              </div>
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200 col-span-2 sm:col-span-1">
                <span class="text-xs font-semibold text-slate-500">Saturation Index</span>
                <div class="text-2xl font-black text-[#152438] mt-1">{coffeeNaics.saturationIndex} <span class="text-xs font-normal text-slate-400">/ 100</span></div>
                <span class="text-[11px] text-emerald-600 font-semibold">Bayes Smoothed (m=10k)</span>
              </div>
            </div>
          </section>
        </div>

        <!-- TAB 2: COSTS & BREAKEVEN MODELING -->
        <div id="tab-breakeven" class="tab-panel hidden space-y-10">
          <section class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] space-y-6">
            <div>
              <h2 class="text-xl font-black text-[#152438]">Costs & Breakeven Underwriting</h2>
              <p class="text-xs text-slate-500 mt-0.5">Determine required customer transaction velocity to cover Austin retail leases</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
              <div class="space-y-4 text-xs font-semibold">
                <div>
                  <div class="flex justify-between mb-1">
                    <label class="text-slate-700">Store Size (Usable Sq Ft)</label>
                    <span id="label-sqft" class="text-blue-600 font-bold">1,400 sqft</span>
                  </div>
                  <input id="slider-sqft" type="range" min="500" max="4000" step="50" value="1400" class="w-full accent-[#1D68F2] cursor-pointer" />
                </div>

                <div>
                  <div class="flex justify-between mb-1">
                    <label class="text-slate-700">Base Asking Rent ($/sqft/yr)</label>
                    <span id="label-rent" class="text-blue-600 font-bold">$32.00 / sqft</span>
                  </div>
                  <input id="slider-rent" type="range" min="15" max="65" step="0.5" value="32" class="w-full accent-[#1D68F2] cursor-pointer" />
                </div>

                <div>
                  <div class="flex justify-between mb-1">
                    <label class="text-slate-700">Average Customer Ticket ($)</label>
                    <span id="label-ticket" class="text-blue-600 font-bold">$8.50</span>
                  </div>
                  <input id="slider-ticket" type="range" min="4" max="25" step="0.25" value="8.50" class="w-full accent-[#1D68F2] cursor-pointer" />
                </div>

                <div>
                  <div class="flex justify-between mb-1">
                    <label class="text-slate-700">Cost of Goods Sold (COGS %)</label>
                    <span id="label-cogs" class="text-blue-600 font-bold">28%</span>
                  </div>
                  <input id="slider-cogs" type="range" min="10" max="60" step="1" value="28" class="w-full accent-[#1D68F2] cursor-pointer" />
                </div>
              </div>

              <!-- Live Output Card with Cost Breakdown Bars -->
              <div class="bg-[#EDF4FC] p-6 rounded-2xl border border-blue-200/80 flex flex-col justify-between">
                <div>
                  <div class="text-xs font-bold uppercase tracking-wider text-[#1D68F2] mb-3">Operating Velocity Required</div>
                  <div class="space-y-3">
                    <div>
                      <span class="text-xs text-slate-600">Daily Customers Required</span>
                      <div id="output-daily-customers" class="text-4xl font-black text-[#152438]">94</div>
                      <div class="text-[11px] text-slate-500">transactions per operating day</div>
                    </div>
                    <div>
                      <span class="text-xs text-slate-600">Monthly Net Revenue Needed</span>
                      <div id="output-monthly-revenue" class="text-xl font-bold text-slate-800">$22,460</div>
                    </div>
                    <div>
                      <span class="text-xs text-slate-600">Monthly Fixed Cost (Lease + Labor)</span>
                      <div id="output-monthly-fixed" class="text-base font-semibold text-slate-700">$16,170</div>
                    </div>
                  </div>
                </div>
                <div class="text-[11px] text-slate-500 pt-3 border-t border-blue-200">
                  Stripping 8.25% sales tax and applying 18% payroll burden load.
                </div>
              </div>
            </div>
          </section>
        </div>

        <!-- TAB 3: MARKET DEMAND (25 NAICS) -->
        <div id="tab-demand" class="tab-panel hidden space-y-10">
          <section class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] space-y-6">
            <div>
              <h2 class="text-xl font-black text-[#152438]">Austin NAICS Industry Saturation Benchmark</h2>
              <p class="text-xs text-slate-500 mt-0.5">Empirical Bayes analysis across all 25 core small business categories</p>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead>
                  <tr class="border-b border-slate-200 text-slate-400 font-bold uppercase tracking-wider text-[11px]">
                    <th class="py-3 pr-4">Industry / Trade</th>
                    <th class="py-3 px-4">Active Units</th>
                    <th class="py-3 px-4">Density / 10k</th>
                    <th class="py-3 px-4">US Benchmark</th>
                    <th class="py-3 pl-4">Market Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {city.industries.map((ind) => (
                    <tr class="hover:bg-slate-50">
                      <td class="py-3.5 pr-4 font-bold text-slate-800">{ind.label}</td>
                      <td class="py-3.5 px-4 font-semibold text-slate-700">{ind.establishments}</td>
                      <td class="py-3.5 px-4 text-slate-600">{ind.per10kResidents}</td>
