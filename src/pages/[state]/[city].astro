                  ✏️ Custom Concept
                </button>
              </div>
              <select
                id="trade-select"
                class="w-full px-4 py-3 rounded-2xl bg-white text-slate-900 font-extrabold text-xs shadow-xl border-2 border-blue-400 focus:ring-2 focus:ring-blue-300 outline-none cursor-pointer"
              >
                <option value="custom" class="font-black text-blue-600">✨ Custom Enterprise (Enter your own concept)...</option>
                <optgroup label="25 Standard NAICS Benchmarks">
                  {industriesWithDefaults.map((ind) => (
                    <option value={ind.naicsCode} selected={ind.naicsCode === '722515'}>
                      {ind.label} — {ind.status.toUpperCase()} ({ind.establishments} units)
                    </option>
                  ))}
