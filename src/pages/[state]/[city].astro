            </div>
            <button
              type="button"
              onclick="document.getElementById('nav-saved-btn')?.click();"
              class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-[#1D68F2] font-bold text-xs transition cursor-pointer"
            >
              View Shortlist →
            </button>
          </div>

          <!-- Request Data Update / Correction -->
          <div class="bg-gradient-to-br from-[#0F172A] to-[#1E293B] rounded-3xl p-6 text-white shadow-lg space-y-3">
            <div class="text-xs font-bold uppercase tracking-wider text-blue-300">{city.name} Data Updates</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Spotted an updated state tax bulletin or municipal utility report for {city.name}? Contact our research desk directly.
            </p>
            <a
              href={`mailto:audit@cityclick.com?subject=${encodeURIComponent(`CityClick Update: ${city.name}, ${city.stateCode.toUpperCase()}`)}`}
              class="block w-full text-center py-2.5 rounded-xl bg-[#1D68F2] hover:bg-blue-600 text-white font-bold text-xs transition"
            >
              Email Research Desk →
            </a>
          </div>
        </div>

        <!-- SIDEBAR 2: MOVING -->
        <div id="sidebar-moving" class="sidebar-panel hidden space-y-6">
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-[0_4px_25px_-2px_rgba(0,0,0,0.08)] space-y-5">
            <div class="bg-gradient-to-br from-emerald-900 to-slate-900 rounded-2xl p-4 text-white shadow-md border border-emerald-700/50">
              <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-emerald-300 mb-1">
                <span>Relocation Resource</span>
                <span class="bg-emerald-500/20 text-emerald-200 px-2 py-0.5 rounded border border-emerald-400/30">Step-by-Step</span>
              </div>
              <div class="font-black text-sm text-white">{city.name} Housing Facts</div>
              <div class="text-[11px] text-slate-300 mt-1">Home value, rent, and property tax on the record</div>
            </div>

            <div>
              <h3 class="text-xl font-black text-[#152438]">Housing facts on this page</h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                Print the housing, healthcare, and tax figures shown for {city.name}. Only fields on the city record are included.
              </p>
            </div>

            <div class="space-y-2.5 py-3 border-y border-slate-100 text-xs text-slate-700 font-medium">
              {city.housingAndTaxes?.medianHomeValue != null && (
                <div class="flex items-start gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5">✓</span>
                  <span><strong>Median home value:</strong> ${city.housingAndTaxes.medianHomeValue.toLocaleString()}</span>
                </div>
              )}
              {city.housingAndTaxes?.medianGrossRent != null && (
                <div class="flex items-start gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5">✓</span>
                  <span><strong>Median gross rent:</strong> ${city.housingAndTaxes.medianGrossRent.toLocaleString()}/mo</span>
                </div>
              )}
              {city.waterUtility && (
                <div class="flex items-start gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5">✓</span>
                  <span><strong>Water system:</strong> {city.waterUtility.providerName}</span>
                </div>
              )}
            </div>

            <button
              type="button"
              onclick="window.print();"
              class="w-full text-center py-4 px-4 rounded-2xl bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-sm shadow-lg hover:shadow-xl transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
              Print / Save Relocation Summary
            </button>
            <div class="text-center text-[11px] text-slate-400 font-medium">
              Free Public Resource · Census & EPA Sourced
            </div>
          </div>

          <!-- Compare Living Costs -->
          <div class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="text-2xl p-2 rounded-xl bg-emerald-50 text-emerald-700">⚖️</span>
              <div>
                <div class="font-bold text-xs text-[#152438]">Cost of Living Comparison</div>
                <div class="text-[11px] text-slate-500">Compare {city.name} with peer markets</div>
              </div>
            </div>
            <a
              href={compareHref}
              class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 font-bold text-xs transition"
            >
              Compare →
            </a>
          </div>
        </div>

        <!-- SIDEBAR 3: DOING BUSINESS -->
        <div id="sidebar-business" class="sidebar-panel hidden space-y-6">
          <div id="report" class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-[0_4px_25px_-2px_rgba(0,0,0,0.08)] space-y-5">
            <div class="bg-gradient-to-br from-[#152438] to-slate-900 rounded-2xl p-4 text-white shadow-md border border-slate-700">
              <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-emerald-400 mb-1">
                <span>CITYCLICK CITY DOSSIER</span>
                <span class="bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded border border-emerald-400/30">100% FREE</span>
              </div>
              <div class="font-black text-sm text-white">{city.name} Commercial Dossier</div>
              <div class="text-[11px] text-slate-300 mt-1">Export verified Census & tax figures</div>
            </div>

            <div>
              <h3 class="text-xl font-black text-[#152438]">Get Complete City Dossier (Free)</h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                Download or print the verified business, housing, and sales-tax figures for {city.name} immediately—no account or email required.
              </p>
            </div>

            <div class="space-y-2.5 py-3 border-y border-slate-100 text-xs text-slate-700 font-medium">
              {city.industries.length > 0 && (
                <div class="flex items-start gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5">✓</span>
                  <span><strong>Trade counts:</strong> {city.industries.length} Census ZBP categories</span>
                </div>
              )}
              {hasVerifiedTax && (
                <div class="flex items-start gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5">✓</span>
                  <span><strong>Sales tax:</strong> {taxPct(city.permitsAndTax.combinedSalesTaxRate)} combined</span>
                </div>
              )}
              {evInfra && (
                <div class="flex items-start gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5">✓</span>
                  <span><strong>EV stations:</strong> {evInfra.totalStations.toLocaleString('en-US')} public locations</span>
                </div>
              )}
            </div>

            <div class="space-y-2.5 pt-1">
              {isAustin ? (
                <a
                  href="/reports/tx-austin-feasibility-dossier.pdf"
                  download="Austin-Texas-Feasibility-Dossier.pdf"
                  target="_blank"
                  class="w-full text-center py-4 px-4 rounded-2xl bg-[#1D68F2] hover:bg-[#1555C7] text-white font-extrabold text-sm shadow-lg hover:shadow-xl transition flex items-center justify-center gap-2 cursor-pointer"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                  Download Austin Dossier (PDF)
                </a>
              ) : (
                <button
                  type="button"
                  onclick="window.print();"
                  class="w-full text-center py-4 px-4 rounded-2xl bg-[#1D68F2] hover:bg-[#1555C7] text-white font-extrabold text-sm shadow-lg hover:shadow-xl transition flex items-center justify-center gap-2 cursor-pointer"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                  Print / Save {city.name} Dossier (PDF)
                </button>
              )}
              <a
                href={`/tools/lease-calculator/?tax=${hasVerifiedTax ? Number((city.permitsAndTax.combinedSalesTaxRate * 100).toFixed(3)) : '8.25'}&city=${encodeURIComponent(city.name)}`}
                class="block w-full text-center py-3 px-4 rounded-2xl bg-slate-100 hover:bg-blue-50 text-slate-800 hover:text-[#1D68F2] font-bold text-xs transition"
              >
                Open Lease & Breakeven Calculator →
              </a>
              <div class="text-center text-[11px] text-slate-400 font-medium">
                Direct Access · Zero Paywall · Primary Federal & State Records
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Interactive Scripts (Pillars, Multi-Layer Map, Trade Switcher, Local Shortlist) -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>

  <script is:inline>
    function initCityClick() {
      // 1. The 3 Primary Pillar Switchers
      const pillarBtns = document.querySelectorAll('.pillar-btn');
      const pillarPanels = document.querySelectorAll('.pillar-panel');

      pillarBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-pillar');

          pillarBtns.forEach((b) => {
            b.classList.remove('border-[#1D68F2]', 'bg-blue-50/70', 'shadow-sm');
            b.classList.add('border-slate-200', 'bg-white');
            const arrow = b.querySelector('.pillar-arrow');
            if (arrow) {
              arrow.classList.remove('text-[#1D68F2]');
              arrow.classList.add('text-slate-300', 'hidden');
            }
          });

          btn.classList.add('border-[#1D68F2]', 'bg-blue-50/70', 'shadow-sm');
          btn.classList.remove('border-slate-200', 'bg-white');
          const activeArrow = btn.querySelector('.pillar-arrow');
          if (activeArrow) {
            activeArrow.classList.add('text-[#1D68F2]');
            activeArrow.classList.remove('text-slate-300', 'hidden');
          }

          pillarPanels.forEach((p) => p.classList.add('hidden'));
          const active = document.getElementById(target);
          if (active) active.classList.remove('hidden');

          document.querySelectorAll('.stats-strip').forEach((s) => s.classList.add('hidden'));
          if (target === 'pillar-travel') {
            document.getElementById('stats-strip-travel')?.classList.remove('hidden');
          } else if (target === 'pillar-moving') {
            document.getElementById('stats-strip-moving')?.classList.remove('hidden');
          } else if (target === 'pillar-business') {
            document.getElementById('stats-strip-business')?.classList.remove('hidden');
          }

          document.querySelectorAll('.sidebar-panel').forEach((s) => s.classList.add('hidden'));
          if (target === 'pillar-travel') {
            document.getElementById('sidebar-travel')?.classList.remove('hidden');
          } else if (target === 'pillar-moving') {
            document.getElementById('sidebar-moving')?.classList.remove('hidden');
          } else if (target === 'pillar-business') {
            document.getElementById('sidebar-business')?.classList.remove('hidden');
          }

          if (target === 'pillar-travel' && window.switchCityMapLayer) {
            window.switchCityMapLayer('visiting');
          } else if (target === 'pillar-moving' && window.switchCityMapLayer) {
            window.switchCityMapLayer('living');
          } else if (target === 'pillar-business' && window.switchCityMapLayer) {
            window.switchCityMapLayer('business');
          }

          if (window.cityClickMap) {
            setTimeout(() => window.cityClickMap.invalidateSize(), 80);
          }
        });
      });

      // 2. Multi-Audience Leaflet Map Initialization
      const mapEl = document.getElementById('city-leaflet-map');
      if (window.L && mapEl) {
        const centerLat = parseFloat(mapEl.getAttribute('data-lat') || '0');
        const centerLng = parseFloat(mapEl.getAttribute('data-lng') || '0');
        const zoom = parseInt(mapEl.getAttribute('data-zoom') || '11', 10);

        const map = L.map('city-leaflet-map', {
          center: [centerLat, centerLng],
          zoom: zoom,
          zoomControl: false,
          scrollWheelZoom: false,
        });
        window.cityClickMap = map;

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap contributors',
          maxZoom: 19,
        }).addTo(map);

        L.control.zoom({ position: 'topright' }).addTo(map);

        const markerLayer = L.layerGroup().addTo(map);
        const cityData = JSON.parse(mapEl.getAttribute('data-map-pins') || '{"visiting":[],"living":[],"business":[]}');

        function switchMapLayer(layer) {
          const btnVisiting = document.getElementById('map-layer-visiting');
          const btnLiving = document.getElementById('map-layer-living');
          const btnBusiness = document.getElementById('map-layer-business');
          const statusEl = document.getElementById('map-pin-status');
          const legendDot = document.getElementById('map-layer-legend-dot');
          const legendText = document.getElementById('map-layer-legend-text');
          const pingIndicator = document.getElementById('map-ping-indicator');

          [btnVisiting, btnLiving, btnBusiness].forEach((btn) => {
            if (btn) {
              btn.className = 'map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer text-slate-600 hover:text-slate-900';
            }
          });

          markerLayer.clearLayers();

          const places = cityData[layer] || [];
          let color = '#1D68F2';
          let label = 'Airport, National Parks & municipal center';

          if (layer === 'living') {
            color = '#059669';
            label = 'CMS emergency hospitals & colleges';
            if (btnLiving) btnLiving.className = 'map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer bg-emerald-600 text-white shadow-xs';
          } else if (layer === 'business') {
            color = '#7C3AED';
            label = 'Public EV charging hubs & campus anchors';
            if (btnBusiness) btnBusiness.className = 'map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer bg-purple-600 text-white shadow-xs';
          } else {
            if (btnVisiting) btnVisiting.className = 'map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer bg-[#1D68F2] text-white shadow-xs';
          }

          if (legendDot) legendDot.style.backgroundColor = color;
          if (pingIndicator) pingIndicator.style.backgroundColor = color;
          if (legendText) legendText.innerText = label;
          if (statusEl) {
            statusEl.innerText =
              places.length === 1
                ? '1 verified place mapped · Click pin'
                : places.length + ' verified places mapped · Click any pin';
          }

          const pinHtml =
            '<div style="background-color: ' +
            color +
            '; width: 14px; height: 14px; border-radius: 50%; border: 3px solid #FFFFFF; box-shadow: 0 0 10px ' +
            color +
            'B3;"></div>';
          const customIcon = L.divIcon({
            className: 'custom-pin-icon',
            html: pinHtml,
            iconSize: [14, 14],
            iconAnchor: [7, 7],
          });

          const latLngs = [];
          places.forEach((place) => {
            if (typeof place.lat === 'number' && typeof place.lng === 'number') {
              latLngs.push([place.lat, place.lng]);
              L.marker([place.lat, place.lng], { icon: customIcon })
                .bindPopup(
                  '<div style="font-family: inherit; padding: 4px; min-width: 180px;">' +
                    '<div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: ' +
                    color +
                    ';">' +
                    place.category +
                    '</div>' +
                    '<div style="font-weight: 800; font-size: 13px; color: #152438; margin-top: 2px;">' +
                    place.name +
                    '</div>' +
                    (place.address
                      ? '<div style="font-size: 11px; color: #64748B; margin-top: 2px;">' + place.address + '</div>'
                      : '') +
                  '</div>'
                )
                .addTo(markerLayer);
            }
          });

          if (latLngs.length > 1) {
            map.fitBounds(latLngs, { padding: [36, 36], maxZoom: 12 });
          } else if (latLngs.length === 1) {
            map.setView(latLngs[0], 11);
          } else {
            map.setView([centerLat, centerLng], zoom);
          }
        }

        switchMapLayer('visiting');

        document.getElementById('map-layer-visiting')?.addEventListener('click', () => switchMapLayer('visiting'));
        document.getElementById('map-layer-living')?.addEventListener('click', () => switchMapLayer('living'));
        document.getElementById('map-layer-business')?.addEventListener('click', () => switchMapLayer('business'));

        window.switchCityMapLayer = switchMapLayer;
      }

      // 3. Video Player Activation
      const videoBox = document.getElementById('video-tour-container');
      if (videoBox) {
        videoBox.addEventListener('click', () => {
          const vId = videoBox.getAttribute('data-video-id');
          if (vId) {
            videoBox.innerHTML =
              '<iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/' +
              vId +
              '?autoplay=1&rel=0" title="Video Tour" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
          }
        });
      }

      // 4. Dynamic NAICS Trade Switcher (Updates BOTH Main Card AND Top 4-Fact Strip)
      const tradeSelect = document.getElementById('trade-select');
      const industriesData = JSON.parse(document.getElementById('pillar-business')?.getAttribute('data-industries') || '[]');

      function applyTrade(naicsCode) {
        const trade = industriesData.find((i) => i.naicsCode === naicsCode);
        if (!trade) return;

        const labelEl = document.getElementById('active-trade-label');
        if (labelEl) labelEl.innerText = 'Commercial Establishment Density: ' + trade.label;

        const countEl = document.getElementById('active-trade-count');
        if (countEl) countEl.innerText = trade.establishments.toString();

        const densityEl = document.getElementById('active-trade-density');
        if (densityEl) densityEl.innerText = trade.per10kResidents.toString();

        const benchEl = document.getElementById('active-trade-benchmark');
        if (benchEl) benchEl.innerText = 'National Benchmark: ' + trade.usAvgPer10k;

        const satEl = document.getElementById('active-trade-saturation');
        if (satEl) satEl.innerHTML = trade.saturationIndex + ' <span class="text-xs font-normal text-slate-400">/ 100</span>';

        const badge = document.getElementById('active-trade-badge');
        if (badge) {
          badge.className =
            'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ' +
            (trade.status === 'underserved'
              ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
              : trade.status === 'balanced'
              ? 'bg-blue-50 text-blue-700 border border-blue-200'
              : 'bg-rose-50 text-rose-700 border border-rose-200');
          badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-current animate-pulse"></span>' + trade.status;
        }

        // Sync Top Doing Business 4-Fact Strip
        const stripCount = document.getElementById('strip-trade-count');
        if (stripCount) stripCount.innerText = trade.establishments.toString();
        const stripLabel = document.getElementById('strip-trade-label');
        if (stripLabel) stripLabel.innerText = trade.label;
        const stripSat = document.getElementById('strip-trade-saturation');
        if (stripSat) stripSat.innerText = trade.saturationIndex + ' / 100';
        const stripStatus = document.getElementById('strip-trade-status');
        if (stripStatus) stripStatus.innerText = trade.status;

        if (tradeSelect && tradeSelect.value !== naicsCode) {
          tradeSelect.value = naicsCode;
        }
      }

      if (tradeSelect) {
        tradeSelect.addEventListener('change', (e) => {
          applyTrade(e.target.value);
        });
      }

      document.querySelectorAll('.trade-row').forEach((row) => {
        row.addEventListener('click', () => {
          const naics = row.getAttribute('data-naics');
          if (naics) {
            applyTrade(naics);
            document.getElementById('active-trade-label')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });

      // 5. Save City Local Persistence
      const saveBtn = document.getElementById('save-city-btn');
      if (saveBtn) {
        const slug = saveBtn.getAttribute('data-slug');
        const name = saveBtn.getAttribute('data-name');
        const stateCode = saveBtn.getAttribute('data-state');
        const labelSpan = document.getElementById('save-city-label');

        function checkSavedState() {
          const saved =
            typeof getSavedCities === 'function'
              ? getSavedCities()
              : JSON.parse(localStorage.getItem('cityclick_saved_cities') || '[]');
          const isSaved = saved.some((c) => c.slug === slug);
          if (isSaved) {
            saveBtn.classList.add('border-emerald-500', 'text-emerald-400');
            if (labelSpan) labelSpan.innerHTML = '<span class="text-emerald-400 font-bold">✓ Saved</span>';
          } else {
            saveBtn.classList.remove('border-emerald-500', 'text-emerald-400');
            if (labelSpan) labelSpan.innerText = 'Save city';
          }
        }

        checkSavedState();

        saveBtn.addEventListener('click', () => {
          let saved =
            typeof getSavedCities === 'function'
              ? getSavedCities()
              : JSON.parse(localStorage.getItem('cityclick_saved_cities') || '[]');
          const exists = saved.some((c) => c.slug === slug);

          if (!exists) {
            saved.push({ slug, name, stateCode });
          } else {
            saved = saved.filter((c) => c.slug !== slug);
          }

          if (typeof setSavedCities === 'function') {
            setSavedCities(saved);
          } else {
            localStorage.setItem('cityclick_saved_cities', JSON.stringify(saved));
          }
          checkSavedState();
        });

        window.addEventListener('cityclick_saved_changed', checkSavedState);
      }

      // 6. URL Parameter & Hash Tab Deep-Link (Including #report -> Doing Business sidebar!)
      const urlParams = new URLSearchParams(window.location.search);
      const rawHash = window.location.hash.replace('#', '').toLowerCase();
      const tabParam = (urlParams.get('tab') || rawHash).toLowerCase();
      if (tabParam === 'moving' || tabParam === 'live') {
        document.querySelector('button[data-pillar="pillar-moving"]')?.click();
      } else if (tabParam === 'business' || tabParam === 'biz' || tabParam === 'report') {
        document.querySelector('button[data-pillar="pillar-business"]')?.click();
        if (rawHash === 'report') {
          setTimeout(() => document.getElementById('report')?.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
        }
      } else if (tabParam === 'travel' || tabParam === 'visit' || tabParam === 'visiting') {
        document.querySelector('button[data-pillar="pillar-travel"]')?.click();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCityClick);
    } else {
      initCityClick();
    }
  </script>
</Layout>
