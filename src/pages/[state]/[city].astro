                    </td>
                    <td class="py-4 pl-4 text-slate-600">{(city.permitsAndTax.stateTaxRate * 100).toFixed(2)}% State + {(city.permitsAndTax.localTaxRate * 100).toFixed(2)}% Local</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <!-- ========================================== -->
        <!-- MULTI-AUDIENCE INTERACTIVE MAP             -->
        <!-- (Positioned beneath primary audience panes)-->
        <!-- ========================================== -->
        <section class="bg-white p-6 sm:p-7 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xl">🗺️</span>
