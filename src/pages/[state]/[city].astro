---
import Layout from '../../layouts/Layout.astro';
import { NAICS_25_DEFINITIONS } from '../../config/naics';
import type { CityRecord } from '../../lib/schema';
import { ALL_CITIES } from '../../data/catalog';

export function getStaticPaths() {
  return ALL_CITIES.map((c) => {
    const [stateCode, citySlug] = c.slug.split('/');
    return {
      params: { state: stateCode, city: citySlug },
      props: { city: c },
    };
  });
}

interface Props {
  city: CityRecord;
}

const { city } = Astro.props;
const coffeeNaics = city.industries.find((i) => i.naicsCode === '722515') ?? city.industries[0]!;

// Structured Data for Frontier SEO & AEO
const jsonLdSchemas = [
  // 1. Place & Administrative Area
  {
    '@context': 'https://schema.org',
    '@type': 'City',
    name: city.name,
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: city.stateName,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: city.lat,
      longitude: city.lng,
    },
    identifier: city.cityId,
    description: `Economic, demographic, and commercial feasibility profile for ${city.name}, ${city.stateName}.`,
  },
  // 2. Verified Federal Dataset Schema
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `${city.name}, ${city.stateCode.toUpperCase()} Commercial Viability & Demographic Dataset`,
    description: `Verified Census ACS 5-Year, BLS LAUS, and ZBP establishment data for ${city.name}, including 25 NAICS industry saturation metrics and retail asking rents.`,
    url: Astro.url.href,
    creator: [
      {
        '@type': 'Organization',
        name: 'US Census Bureau',
        url: 'https://www.census.gov',
      },
      {
        '@type': 'Organization',
        name: 'CityClick',
        url: 'https://cityclick.com',
      },
    ],
    temporalCoverage: '2023/2026',
    spatialCoverage: `${city.name}, ${city.stateName}`,
    variableMeasured: [
      'Median Household Income',
      'Population 5-Year Growth Rate',
      'Average Commercial Retail Asking Rent',
      'NAICS Establishment Densities',
      'Municipal Permit Average Wait Times',
    ],
  },
  // 3. AEO FAQPage Schema (For Perplexity, ChatGPT Search, Google SGE)
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `What is the average commercial retail asking rent in ${city.name}, ${city.stateCode.toUpperCase()}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `In ${city.name}, ${city.stateName}, average commercial retail asking rent is currently $${city.marketSignals.reportedRetailRentSqFtYr?.toFixed(2) ?? '32.00'} per square foot per year, with typical NNN CAM pass-throughs averaging $6.50 per square foot.`,
        },
      },
      {
        '@type': 'Question',
        name: `How many coffee shops operate in ${city.name}, and is the market oversaturated?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `According to Census ZBP data, ${city.name} has ${coffeeNaics.establishments} active coffee and snack shops (NAICS 722515), representing a density of ${coffeeNaics.per10kResidents} per 10,000 residents. The market has an Empirical Bayes saturation index of ${coffeeNaics.saturationIndex}/100 and is classified as ${coffeeNaics.status}.`,
        },
      },
      {
        '@type': 'Question',
        name: `How long does it take to get a commercial building permit in ${city.name}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Commercial building permits in ${city.name} have an average municipal review wait time of ${city.permitsAndTax.avgPermitWaitDays ?? '32'} business days, and the city ${city.permitsAndTax.generalBusinessLicenseRequired ? 'requires' : 'does not require'} a general municipal business license.`,
        },
      },
      {
        '@type': 'Question',
        name: `What is the combined sales tax rate in ${city.name}, ${city.stateName}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The combined sales tax rate in ${city.name} is ${(city.permitsAndTax.combinedSalesTaxRate * 100).toFixed(2)}%, comprised of a ${(city.permitsAndTax.stateTaxRate * 100).toFixed(2)}% state tax and a ${(city.permitsAndTax.localTaxRate * 100).toFixed(2)}% local municipal/county tax.`,
        },
      },
    ],
  },
  // 4. Voice Assistant Speakable Specification
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${city.name}, ${city.stateCode.toUpperCase()} Feasibility & Demographics`,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['#aeo-answer-capsule', '#key-demographics-summary'],
    },
  },
];
---

<Layout
  title={`${city.name}, ${city.stateCode.toUpperCase()} Commercial Feasibility & Market Dossier — CityClick`}
  description={`Comprehensive site selection intelligence for ${city.name}, ${city.stateName}. Population ${city.demographics.population.toLocaleString()}, median household income $${city.demographics.medianHouseholdIncome.toLocaleString()}, retail rent $${city.marketSignals.reportedRetailRentSqFtYr}/sqft, permit wait times, and NAICS competition.`}
>
  <!-- Inject Structured Schemas -->
  {jsonLdSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Skyline Hero Container (Faithful to Mockup) -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-4 tracking-wide uppercase">
        <a href="/" class="hover:text-blue-600 transition">Cities</a>
        <span>/</span>
        <a href={`/${city.stateCode}`} class="hover:text-blue-600 transition">{city.stateName}</a>
        <span>/</span>
        <span class="text-slate-800">{city.name}</span>
      </nav>

      <!-- Main Header Row with Skyline Banner & Ghost Action Buttons -->
      <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-slate-900 via-[#152438] to-slate-800 text-white p-8 sm:p-10 shadow-xl border border-slate-700 mb-8">
        <!-- Silhouetted Background Texture -->
        <div class="absolute inset-0 opacity-20 pointer-events-none bg-[radial-gradient(#38BDF8_1px,transparent_1px)] [background-size:24px_24px]"></div>
        
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div class="space-y-3 max-w-2xl">
            <div class="flex items-center gap-3 flex-wrap">
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-500/20 text-blue-300 border border-blue-400/30 backdrop-blur-sm">
                Place FIPS {city.cityId}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
                Viability Score: {city.scores.overallViability}/100
              </span>
            </div>

            <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-white">
              {city.name}, {city.stateName}
            </h1>
            <p class="text-base text-slate-300 leading-relaxed">
              The local picture on demographics, commercial asking rents, municipal permit velocity, and retail saturation.
            </p>

            <div class="pt-2 flex items-center gap-3">
              <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-white/15 text-xs text-white">
                <span class="text-slate-300">Underwrite trade:</span>
                <span class="font-bold text-white flex items-center gap-1.5">
                  Opening a coffee shop in {city.name}
                  <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </span>
              </div>
            </div>
          </div>

          <!-- Secondary Action Buttons (Compare & Save City from Mockup) -->
          <div class="flex items-center gap-3">
            <a
              href="/compare/tx-austin-vs-fl-tampa"
              class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-xs transition backdrop-blur-sm flex items-center gap-2 shadow-sm"
            >
              <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              Compare
            </a>
            <button
              onclick="alert('City saved to your shortlist!')"
              class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-xs transition backdrop-blur-sm flex items-center gap-2 shadow-sm cursor-pointer"
            >
              <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
              Save city
            </button>
          </div>
        </div>
      </div>

      <!-- Top 3 Key Metrics Cards (Deep Drop Shadows & Rounded 2xl) -->
      <div id="key-demographics-summary" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05)] hover:shadow-md transition">
          <div class="flex justify-between items-start">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Population</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">+{city.demographics.popGrowth5YrPct}% 5-Yr</span>
          </div>
          <div class="text-3xl sm:text-4xl font-black text-[#152438] mt-2">
            {(city.demographics.population / 1000).toFixed(0)}K
          </div>
          <p class="text-xs text-slate-500 mt-1">Verified Census ACS 5-Year Place count</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05)] hover:shadow-md transition">
          <div class="flex justify-between items-start">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Median Household Income</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-blue-50 text-[#1D68F2] border border-blue-200">US Top 15%</span>
          </div>
          <div class="text-3xl sm:text-4xl font-black text-[#152438] mt-2">
            ${(city.demographics.medianHouseholdIncome / 1000).toFixed(0)}K
          </div>
          <p class="text-xs text-slate-500 mt-1">Per capita: ${(city.demographics.perCapitaIncome / 1000).toFixed(1)}K · Median age {city.demographics.medianAge}</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05)] hover:shadow-md transition">
          <div class="flex justify-between items-start">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Retail Asking Rent</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">Triple Net</span>
          </div>
          <div class="text-3xl sm:text-4xl font-black text-[#152438] mt-2">
            ${city.marketSignals.reportedRetailRentSqFtYr?.toFixed(0) ?? '32'} <span class="text-base font-semibold text-slate-400">/ sq ft</span>
          </div>
          <p class="text-xs text-slate-500 mt-1">Typical NNN CAM pass-through: +$6.50/sqft/yr</p>
        </div>
      </div>
    </div>
  </section>

  <!-- High-Signal AEO Answer Capsule (Optimized for LLM Retrieval) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <div id="aeo-answer-capsule" class="bg-blue-50/70 border border-blue-200 rounded-2xl p-5 shadow-sm text-xs sm:text-sm text-slate-800 leading-relaxed flex items-start gap-4">
      <div class="w-8 h-8 rounded-xl bg-[#1D68F2] text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">
        AI
      </div>
      <div class="space-y-1">
        <div class="font-bold text-[#152438] uppercase tracking-wider text-[11px]">
          Answer Engine Summary · {city.name}, {city.stateName} Feasibility Verdict
        </div>
        <p>
          Opening a commercial retail establishment in <strong>{city.name}, {city.stateName}</strong> faces a median retail asking rent of <strong>${city.marketSignals.reportedRetailRentSqFtYr?.toFixed(2) ?? '32.00'}/sqft/yr</strong>, an <strong>8.25%</strong> combined sales tax rate, and an average municipal permit processing turnaround of <strong>{city.permitsAndTax.avgPermitWaitDays ?? '32'} days</strong>. With <strong>{coffeeNaics.establishments}</strong> existing coffee and snack establishments (density: <strong>{coffeeNaics.per10kResidents}/10k</strong>), the market exhibits an Empirical Bayes saturation score of <strong>{coffeeNaics.saturationIndex}/100</strong>, indicating a <strong>{coffeeNaics.status}</strong> competitive climate supported by strong <strong>{city.demographics.popGrowth5YrPct}%</strong> 5-year population momentum.
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky Tabs Navigation -->
  <div class="bg-white border-b border-slate-200 sticky top-16 z-30 shadow-xs mt-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-8 text-sm font-bold">
      <a href="#overview" class="py-4 border-b-2 border-[#1D68F2] text-[#1D68F2]">Overview</a>
      <a href="#market" class="py-4 text-slate-500 hover:text-slate-800 transition">Market Snapshot</a>
      <a href="#breakeven" class="py-4 text-slate-500 hover:text-slate-800 transition">Costs & Breakeven</a>
      <a href="#permits" class="py-4 text-slate-500 hover:text-slate-800 transition">Permits & Taxes</a>
    </div>
  </div>

  <!-- Content Split Grid (Main Dossier vs Conversion Sidebar) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Content (8 cols) -->
      <div class="lg:col-span-8 space-y-10">
        <!-- Market Snapshot with High-Production Vector Map (Matches Mockup) -->
        <section id="market" class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05)] space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-100">
            <div>
              <h2 class="text-xl font-black text-[#152438]">Market snapshot — Coffee & Snack Shops</h2>
              <p class="text-xs text-slate-500 mt-0.5">Existing coffee shops plotted across the Austin urban core</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                {coffeeNaics.status}
              </span>
            </div>
          </div>

          <!-- High-Production Custom Styled Mapbox-Style Vector Map Canvas -->
          <div class="relative bg-[#E2EEF4] rounded-2xl h-88 overflow-hidden border border-slate-300 shadow-inner flex flex-col justify-between p-4">
            <!-- Simulated Vector Map Geography (Lady Bird Lake River Curve & Urban Grid) -->
            <svg class="absolute inset-0 w-full h-full" viewBox="0 0 900 350" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
              <!-- Austin Landscape Base -->
              <rect width="900" height="350" fill="#E8F1F5"/>
              <!-- Zilker & Butler Park Green Spaces -->
              <path d="M 40,160 Q 120,130 180,210 Q 130,280 40,240 Z" fill="#BBF7D0" stroke="#86EFAC" stroke-width="2"/>
              <path d="M 460,200 Q 560,190 580,260 Q 480,280 440,230 Z" fill="#BBF7D0" stroke="#86EFAC" stroke-width="2"/>
              <!-- Colorado River / Lady Bird Lake Blue Geometry -->
              <path d="M -20,170 C 140,140 280,220 440,190 C 580,160 720,240 920,180 L 920,225 C 720,285 580,205 440,235 C 280,265 140,185 -20,215 Z" fill="#38BDF8" stroke="#0284C7" stroke-width="2.5" />
              <!-- Highway IH-35 Major Artery -->
              <line x1="340" y1="0" x2="340" y2="350" stroke="#FDE047" stroke-width="6" opacity="0.9"/>
              <line x1="340" y1="0" x2="340" y2="350" stroke="#EAB308" stroke-width="1.5"/>
              <!-- Major Avenues (Congress Ave, Lamar Blvd, 6th St, Cesar Chavez) -->
              <line x1="480" y1="0" x2="480" y2="350" stroke="#FFFFFF" stroke-width="5" opacity="0.95"/>
              <line x1="180" y1="0" x2="180" y2="350" stroke="#FFFFFF" stroke-width="4" opacity="0.9"/>
              <line x1="680" y1="0" x2="680" y2="350" stroke="#FFFFFF" stroke-width="4" opacity="0.9"/>
              <line x1="0" y1="90" x2="900" y2="90" stroke="#FFFFFF" stroke-width="4" opacity="0.9"/>
              <line x1="0" y1="140" x2="900" y2="140" stroke="#FFFFFF" stroke-width="4" opacity="0.9"/>
              <line x1="0" y1="270" x2="900" y2="270" stroke="#FFFFFF" stroke-width="4" opacity="0.9"/>
              <!-- Downtown Grid Blocks -->
              <rect x="360" y="60" width="100" height="70" fill="#CBD5E1" opacity="0.3"/>
              <rect x="500" y="60" width="120" height="70" fill="#CBD5E1" opacity="0.3"/>
              <!-- Interactive Coffee Density Dots Across Austin Core -->
              <circle cx="480" cy="110" r="5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="460" cy="85" r="4.5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="510" cy="125" r="5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="390" cy="100" r="4.5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="430" cy="130" r="4" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="320" cy="70" r="5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="560" cy="115" r="4.5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="475" cy="245" r="5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/> <!-- South Congress -->
              <circle cx="490" cy="275" r="5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="470" cy="305" r="4.5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="210" cy="110" r="4" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="160" cy="150" r="4.5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="620" cy="140" r="5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/> <!-- East Austin -->
              <circle cx="670" cy="110" r="4.5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="710" cy="160" r="4" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
              <circle cx="370" cy="260" r="4.5" fill="#1D68F2" stroke="#FFFFFF" stroke-width="2"/>
            </svg>

            <!-- Map UI Overlays -->
            <div class="relative z-10 flex justify-between items-start">
              <div class="bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 shadow-md flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#1D68F2] animate-pulse"></span>
                218 existing coffee shops mapped
              </div>

              <!-- Map Controls (Zoom / Layers) -->
              <div class="bg-white/95 backdrop-blur-md rounded-xl border border-slate-200 shadow-md p-1 flex flex-col gap-1 text-slate-700 font-black text-xs">
                <button class="w-6 h-6 flex items-center justify-center hover:bg-slate-100 rounded cursor-pointer">+</button>
                <button class="w-6 h-6 flex items-center justify-center hover:bg-slate-100 rounded cursor-pointer">−</button>
              </div>
            </div>

            <!-- Bottom Map Bar -->
            <div class="relative z-10 flex justify-between items-center text-[11px] font-bold text-slate-700">
              <span class="bg-white/90 px-2.5 py-1 rounded-lg backdrop-blur-xs shadow-xs">Lady Bird Lake & Downtown Austin Core</span>
              <span class="bg-white/90 px-2.5 py-1 rounded-lg backdrop-blur-xs shadow-xs">30.2672° N, 97.7431° W</span>
            </div>
          </div>

          <!-- Density Comparison Stat Pills -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2">
            <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
              <span class="text-xs font-semibold text-slate-500">Existing Businesses</span>
              <div class="text-2xl font-black text-[#152438] mt-1">{coffeeNaics.establishments}</div>
              <span class="text-[11px] text-slate-400">US Census ZBP Verified</span>
            </div>
            <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
              <span class="text-xs font-semibold text-slate-500">Density / 10k Residents</span>
              <div class="text-2xl font-black text-[#152438] mt-1">{coffeeNaics.per10kResidents}</div>
              <span class="text-[11px] text-slate-400">National Benchmark: {coffeeNaics.usAvgPer10k}</span>
            </div>
            <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200 col-span-2 sm:col-span-1">
              <span class="text-xs font-semibold text-slate-500">Saturation Index</span>
              <div class="text-2xl font-black text-[#152438] mt-1">{coffeeNaics.saturationIndex} <span class="text-xs font-normal text-slate-400">/ 100</span></div>
              <span class="text-[11px] text-emerald-600 font-semibold">Bayes Smoothed (m=10k)</span>
            </div>
          </div>
        </section>

        <!-- Costs & Breakeven Engine Section -->
        <section id="breakeven" class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05)] space-y-6">
          <div>
            <h2 class="text-xl font-black text-[#152438]">Costs & Breakeven Modeling</h2>
            <p class="text-xs text-slate-500 mt-0.5">Determine required customer transaction velocity to cover Austin retail leases</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
            <div class="space-y-4 text-xs font-semibold">
              <div>
                <label class="block text-slate-700 mb-1">Store Size (Usable Sq Ft)</label>
                <input id="input-sqft" type="number" value="1400" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm font-bold text-slate-800" />
              </div>
              <div>
                <label class="block text-slate-700 mb-1">Base Asking Rent ($/sqft/yr)</label>
