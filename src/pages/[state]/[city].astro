              <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-blue-300 mb-1">
                <span>Free Visitor Resource</span>
                <span class="bg-blue-500/20 text-blue-200 px-2 py-0.5 rounded border border-blue-400/30">1-Page Cheat Sheet</span>
              </div>
              <div class="font-black text-sm text-white">{city.name} Visitor Pocket Guide</div>
              <div class="text-[11px] text-slate-300 mt-1">Arrival transit, key districts, safety & top stays · 2026 Edition</div>
            </div>

            <div>
              <h3 class="text-xl font-black text-[#152438]">Download {city.name} Guide</h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                Essential 1-page summary covering airport transit, top districts to explore, curated stays, and local tips for {city.name}.
              </p>
