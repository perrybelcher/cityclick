                </div>
              </div>
            </div>

            <!-- Capital Access & SBA Lending Inflow -->
            {city.capitalAndSbaLending && (
              <div class="pt-6 border-t border-slate-200/80 space-y-3">
                <div class="flex justify-between items-center">
                  <h3 class="font-bold text-base text-[#152438]">Capital Access & Active SBA Lending Inflow</h3>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">U.S. SBA FOIA Reported</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                  <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                    <span class="text-xs font-semibold text-slate-500">Annual SBA Loan Volume</span>
                    <div class="text-2xl font-black text-[#152438] mt-1">${city.capitalAndSbaLending.annualSbaDisbursementMillion}M</div>
                    <span class="text-[11px] text-slate-400">{city.capitalAndSbaLending.activeCountyLoanCount} Active 7(a) & 504 Loans</span>
                  </div>
                  <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200 col-span-2">
                    <span class="text-xs font-semibold text-slate-500">Top Active Regional SBA Lenders ({city.countyName})</span>
                    <div class="grid grid-cols-3 gap-2 mt-2">
                      {city.capitalAndSbaLending.topLenders.map((l: any) => (
                        <div class="p-2.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
                          <div class="font-bold text-slate-800 text-xs truncate">{l.name}</div>
                          <div class="text-[10px] text-blue-600 font-semibold mt-0.5 truncate">{l.tier}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            )}
          </section>

          <!-- 25-Industry NAICS Saturation Table -->
