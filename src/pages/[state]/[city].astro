                data-layer="living"
              >
                🏡 Living
              </button>
              <button
                type="button"
                id="map-layer-business"
                class="map-layer-btn px-3.5 py-1.5 rounded-xl transition cursor-pointer text-slate-600 hover:text-slate-900"
