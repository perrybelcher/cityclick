  <!-- Client-Side Reactive Interactive Scripts (Tabs, Leaflet Map, and Sliders) -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>

  <script is:inline>
    // 1. Reactive Client-Side Tabs
    document.addEventListener('DOMContentLoaded', () => {
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');

          // Reset all buttons
          tabBtns.forEach((b) => {
            b.classList.remove('border-b-2', 'border-[#1D68F2]', 'text-[#1D68F2]');
            b.classList.add('text-slate-500');
          });

          // Activate clicked button
          btn.classList.add('border-b-2', 'border-[#1D68F2]', 'text-[#1D68F2]');
          btn.classList.remove('text-slate-500');

          // Hide all panels
          tabPanels.forEach((p) => p.classList.add('hidden'));

          // Show targeted panel
          const activePanel = document.getElementById(target);
          if (activePanel) activePanel.classList.remove('hidden');

          // Trigger map resize if overview selected
          if (target === 'tab-overview' && window.cityClickMap) {
            setTimeout(() => window.cityClickMap.invalidateSize(), 50);
          }
        });
      });

      // 2. Initialize Leaflet Interactive Slippy Map
      if (typeof L !== 'undefined' && document.getElementById('austin-leaflet-map')) {
        const map = L.map('austin-leaflet-map', {
          center: [30.2672, -97.7431],
          zoom: 13,
          zoomControl: false,
          scrollWheelZoom: false,
        });
        window.cityClickMap = map;

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap contributors',
          maxZoom: 19,
        }).addTo(map);

        L.control.zoom({ position: 'topright' }).addTo(map);

        // Verified Austin Coffee Establishments
        const coffeeShops = [
          { name: "Houndstooth Coffee", address: "401 Congress Ave", lat: 30.2668, lng: -97.7435, traffic: "Top 5% Foot Traffic", rent: "$36/sqft" },
          { name: "Jo's Coffee", address: "1300 S Congress Ave", lat: 30.2504, lng: -97.7497, traffic: "Ultra-High Pedestrian Surge", rent: "$38/sqft" },
          { name: "Caffe Medici", address: "200 Congress Ave", lat: 30.2647, lng: -97.7438, traffic: "Financial District High", rent: "$35/sqft" },
          { name: "Flat Track Coffee", address: "1619 E Cesar Chavez", lat: 30.2582, lng: -97.7275, traffic: "East Side Growth Hub", rent: "$28/sqft" },
          { name: "Merit Coffee", address: "222 West Ave", lat: 30.2679, lng: -97.7513, traffic: "Seaholm Urban Core", rent: "$34/sqft" },
          { name: "Figure 8 Coffee Purveyors", address: "1111 Chicon St", lat: 30.2685, lng: -97.7208, traffic: "High Neighborhood Density", rent: "$26/sqft" },
          { name: "Better Half Coffee & Cocktails", address: "406 Walsh St", lat: 30.2742, lng: -97.7589, traffic: "Clarksville High Volume", rent: "$30/sqft" },
          { name: "Greater Goods Coffee Co.", address: "2501 E 5th St", lat: 30.2575, lng: -97.7145, traffic: "Creative District Corridor", rent: "$25/sqft" },
          { name: "Fleet Coffee", address: "2427 Webberville Rd", lat: 30.2638, lng: -97.7158, traffic: "Pedestrian Focused", rent: "$24/sqft" },
          { name: "Epoch Coffee", address: "221 W North Loop Blvd", lat: 30.3185, lng: -97.7152, traffic: "24hr Academic/Residential", rent: "$22/sqft" },
          { name: "Radio Coffee & Beer", address: "4204 Menchaca Rd", lat: 30.2365, lng: -97.7845, traffic: "High Evening Surge", rent: "$24/sqft" },
          { name: "Bennu Coffee", address: "2001 E Martin Luther King Jr Blvd", lat: 30.2812, lng: -97.7205, traffic: "Campus Corridor Density", rent: "$23/sqft" }
        ];

        const pinHtml = '<div style="background-color: #1D68F2; width: 14px; height: 14px; border-radius: 50%; border: 3px solid #FFFFFF; box-shadow: 0 0 10px rgba(29, 104, 242, 0.7);"></div>';
        const customIcon = L.divIcon({
          className: 'custom-pin-icon',
          html: pinHtml,
          iconSize: [14, 14],
          iconAnchor: [7, 7],
        });

        coffeeShops.forEach((shop) => {
          L.marker([shop.lat, shop.lng], { icon: customIcon })
            .bindPopup(`
              <div style="font-family: inherit; padding: 4px; min-width: 160px;">
                <div style="font-weight: 800; font-size: 13px; color: #152438;">${shop.name}</div>
                <div style="font-size: 11px; color: #64748B; margin-top: 2px;">${shop.address}</div>
                <div style="display: flex; gap: 6px; margin-top: 6px;">
                  <span style="font-size: 10px; font-weight: 700; background: #EDF4FC; color: #1D68F2; padding: 2px 6px; border-radius: 4px;">${shop.traffic}</span>
                  <span style="font-size: 10px; font-weight: 700; background: #F1F5F9; color: #334155; padding: 2px 6px; border-radius: 4px;">${shop.rent}</span>
                </div>
              </div>
            `)
            .addTo(map);
        });
      }

      // 3. Reactive Sliders for Breakeven Calculator
      const sSqft = document.getElementById('slider-sqft');
      const sRent = document.getElementById('slider-rent');
      const sTicket = document.getElementById('slider-ticket');
      const sCogs = document.getElementById('slider-cogs');

      function recalculate() {
        if (!sSqft || !sRent || !sTicket || !sCogs) return;
        const sqft = parseFloat(sSqft.value);
        const rent = parseFloat(sRent.value);
        const ticket = parseFloat(sTicket.value);
        const cogsPct = parseFloat(sCogs.value) / 100;

        document.getElementById('label-sqft').innerText = sqft.toLocaleString() + ' sqft';
        document.getElementById('label-rent').innerText = '$' + rent.toFixed(2) + ' / sqft';
        document.getElementById('label-ticket').innerText = '$' + ticket.toFixed(2);
        document.getElementById('label-cogs').innerText = (cogsPct * 100).toFixed(0) + '%';

        const nnn = 6.50;
        const wage = 16.50;
        const hours = 120;
        const salesTaxRate = 0.0825;

        const monthlyOcc = (sqft * (rent + nnn)) / 12;
        const monthlyLabor = wage * hours * 4.3482 * 1.18;
        const monthlyFixed = monthlyOcc + monthlyLabor + 1200;

        const netTicket = ticket / (1 + salesTaxRate);
        const contributionMargin = netTicket * (1 - cogsPct);

        if (contributionMargin > 0) {
          const monthlyCust = Math.ceil(monthlyFixed / contributionMargin);
          const dailyCust = Math.ceil(monthlyCust / 30.4375);
          const monthlyRev = monthlyFixed / (1 - cogsPct);

          document.getElementById('output-daily-customers').innerText = dailyCust.toString();
          document.getElementById('output-monthly-revenue').innerText = '$' + Math.round(monthlyRev).toLocaleString();
          document.getElementById('output-monthly-fixed').innerText = '$' + Math.round(monthlyFixed).toLocaleString();
        }
      }

      [sSqft, sRent, sTicket, sCogs].forEach((slider) => {
        if (slider) slider.addEventListener('input', recalculate);
      });
    });
  </script>
