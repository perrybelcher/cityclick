---
import Layout from '../../layouts/Layout.astro';
import { NAICS_25_DEFINITIONS } from '../../config/naics';
import type { CityRecord } from '../../lib/schema';
import { ALL_CITIES } from '../../data/catalog';
import { generateSeoGraph } from '../../lib/seo';
import { buildFacts } from '../../lib/facts';
import austinDispatches from '../../data/dispatches/tx-austin.json';
import hsvDispatches from '../../data/dispatches/ar-hot-springs-village.json';

export function getStaticPaths() {
  return ALL_CITIES.map((c) => {
    const [stateCode, citySlug] = c.slug.split('/');
    return {
      params: { state: stateCode, city: citySlug },
      props: { city: c },
    };
  });
}

interface Props {
  city: CityRecord;
}

const { city } = Astro.props;
const coffeeNaics = city.industries.find((i) => i.naicsCode === '722515') ?? city.industries[0]!;

// Dispatches data (curated for Austin & Hot Springs Village, generic fallback for others)
const isAustin = city.slug === 'tx/austin';
const isHSV = city.slug === 'ar/hot-springs-village';
const isBoise = city.slug === 'id/boise';
const isTampa = city.slug === 'fl/tampa';
const isScottsdale = city.slug === 'az/scottsdale';
const isNashville = city.slug === 'tn/nashville';

const industriesWithDefaults = city.industries.map((ind) => {
  const def = NAICS_25_DEFINITIONS.find((d) => d.naicsCode === ind.naicsCode);
  return {
    ...ind,
    defaultBreakeven: def?.defaultBreakeven ?? {
      typicalSqFt: 1500,
      typicalBaseRentSqFtYr: null,
      typicalTicket: 25.0,
      typicalCogsPct: 0.25,
      typicalStaffHoursPerWeek: 140,
    },
  };
});
const defaultTrade = industriesWithDefaults.find((i) => i.naicsCode === '722515') ?? industriesWithDefaults[0]!;

interface CityVideo {
  videoId: string;
  title: string;
  badge: string;
  duration: string;
}

const VERIFIED_VIDEOS: Record<string, CityVideo> = {
  'tx/austin': {
    videoId: 'QG0Y05GDjts',
    title: 'Austin, Texas Capital City & Lady Bird Lake: 4K Drone Tour',
    badge: 'Austin Urban Skyline & Lake Tour',
    duration: '5:49'
  },
  'ar/hot-springs-village': {
    videoId: 'QyVMK_eqVmo',
    title: 'Tour Hot Springs Village: 26,000 Acres, 11 Lakes & 9 Golf Courses',
    badge: "North America's Largest Gated Community Tour",
    duration: '3:27'
  },
  'id/boise': {
    videoId: 'apz6jUqmVJU',
    title: 'Discover Boise: Downtown Core, River Greenbelt & Foothills',
    badge: 'Boise River & Foothills Tour',
    duration: '2:33'
  }
};

const featuredVideo = VERIFIED_VIDEOS[city.slug] ?? null;

const VERIFIED_HERO_IMAGES: Record<string, string> = {
  'tx/austin': '/images/austin-skyline.jpg',
  'ar/hot-springs-village': '/images/hsv-hero.jpg',
  'id/boise': '/images/boise-hero.jpg',
  'fl/tampa': '/images/tampa-hero.jpg',
  'az/scottsdale': '/images/scottsdale-hero.jpg',
  'tn/nashville': '/images/nashville-hero.jpg'
};
const heroImage = VERIFIED_HERO_IMAGES[city.slug] ?? null;

const VERIFIED_GALLERIES: Record<string, Array<{ img: string; title: string }>> = {
  'tx/austin': [
    { img: '/images/austin-skyline.jpg', title: 'Lady Bird Lake and Downtown' },
    { img: '/images/austin-capitol.jpg', title: 'Texas State Capitol' },
    { img: '/images/austin-barton-springs.jpg', title: 'Barton Springs Natural Pool' },
    { img: '/images/austin-soco.jpg', title: 'South Congress Music Corridor' }
  ],
  'ar/hot-springs-village': [
    { img: '/images/hsv-hero.jpg', title: 'Ouachita Mountain Ridge' },
    { img: '/images/hsv-lake.jpg', title: 'Lake Balboa Waters' },
    { img: '/images/hsv-hills.jpg', title: 'Championship Fairways' },
    { img: '/images/hsv-marina.jpg', title: 'Lake Marina and Boat Docks' }
  ],
  'id/boise': [
    { img: '/images/boise-skyline.jpg', title: 'Boise Skyline and Foothills' },
    { img: '/images/boise-capitol.jpg', title: 'Idaho State Capitol' },
    { img: '/images/boise-greenbelt.jpg', title: 'Boise River Greenbelt' },
    { img: '/images/boise-hero.jpg', title: 'Downtown Core and Foothills' }
  ],
  'fl/tampa': [
    { img: '/images/tampa-hero.jpg', title: 'Tampa Bay Waterfront' },
    { img: '/images/tampa-skyline.jpg', title: 'Downtown Skyline and Bay' },
    { img: '/images/tampa-skyway.jpg', title: 'Sunshine Skyway Landmark' },
    { img: '/images/tampa-waterfront.jpg', title: 'Apollo Beach Coastal Park' }
  ],
  'az/scottsdale': [
    { img: '/images/scottsdale-hero.jpg', title: 'Sonoran Desert Resort Corridor' },
    { img: '/images/scottsdale-desert.jpg', title: 'Sonoran Desert Saguaro Flora' },
    { img: '/images/scottsdale-mcdowell.jpg', title: 'McDowell Mountain Preserve' }
  ],
  'tn/nashville': [
    { img: '/images/nashville-hero.jpg', title: 'Music Row and Broadway Hub' },
    { img: '/images/nashville-skyline.jpg', title: 'Downtown Nashville Skyline' },
    { img: '/images/nashville-parthenon.jpg', title: 'Centennial Park Parthenon' }
  ]
};
const cityGallery = VERIFIED_GALLERIES[city.slug] ?? null;

const hasVerifiedDispatches = false; // re-enable only when every item has an article-level URL
const dispatches = isAustin ? austinDispatches : null;

// Travel fields used below must come from the city record. No invented fallback numbers.
const travel = city.executiveTravel;
const sourcedAirport = travel?.primaryAirport?.source ? travel.primaryAirport : null;
const erHospitals: Array<{ name: string; address: string; type: string }> =
  (travel as any)?.emergency?.erHospitals ?? [];
const erHospitalsSource: string | null = (travel as any)?.emergency?.erHospitalsSource ?? null;

const keyFacts = buildFacts(city);
const seoGraph = generateSeoGraph({
  city,
  canonicalUrl: Astro.url.href,
});

const TOP_6_VERIFIED_SLUGS = [
  'tx/austin',
  'ar/hot-springs-village',
  'id/boise',
  'fl/tampa',
  'az/scottsdale',
  'tn/nashville'
];
const isVerifiedCity = TOP_6_VERIFIED_SLUGS.includes(city.slug);
const robotsDirective = isVerifiedCity ? 'index, follow' : 'noindex, follow';

// Map pins: airport only, and only when the record has coordinates. No claim badges or notes.
const airportLat = (sourcedAirport as any)?.lat ?? (sourcedAirport as any)?.coordinates?.lat ?? null;
const airportLng = (sourcedAirport as any)?.lng ?? (sourcedAirport as any)?.coordinates?.lng ?? null;
const cityMapPins = {
  visiting: sourcedAirport && airportLat != null && airportLng != null ? [
    {
      name: sourcedAirport.name,
      category: 'Airport',
      address: sourcedAirport.iata ?? '',
      lat: airportLat,
      lng: airportLng,
    }
  ] : [],
  living: [],
  business: [],
};
---

<Layout
  title={`${city.name}, ${city.stateCode.toUpperCase()}: Cost of Living, Taxes and Business Data — CityClick`}
  description={`Explore ${city.name}, ${city.stateName}. Municipal guide covering cost of living, property taxes, and neighborhood demographics.`}
  image={heroImage || 'https://cityclick.com/images/og-cityclick.jpg'}
  robots={robotsDirective}
>
  <!-- Leaflet Map CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

  <!-- Inject Structured Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(seoGraph)} />

  <!-- Hero Container with Photographic Skyline Header -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-4 tracking-wide uppercase">
        <a href="/" class="hover:text-blue-600 transition">Cities</a>
        <span>/</span>
        <a href={`/${city.stateCode}`} class="hover:text-blue-600 transition">{city.stateName}</a>
        <span>/</span>
        <span class="text-slate-800">{city.name}</span>
      </nav>

      <!-- Skyline / Scenic Hero Card -->
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-800 mb-6 min-h-[340px] flex flex-col justify-between p-8 sm:p-10 text-white">
        {heroImage && (
          <img
            src={heroImage}
            alt={`${city.name}, ${city.stateName} Panoramic View`}
            class="absolute inset-0 w-full h-full object-cover object-center filter brightness-[0.38] contrast-[1.15] scale-105 transition duration-1000"
          />
        )}
        {!heroImage && (
          <div class="absolute inset-0 bg-gradient-to-br from-[#0F172A] via-[#1E293B] to-[#0B1120]"></div>
          <div class="absolute inset-0 bg-[radial-gradient(#38BDF8_1px,transparent_1px)] [background-size:28px_28px] opacity-15"></div>
        )}
        <!-- Deep Radial Vignette Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] via-[#0B1120]/75 to-transparent"></div>

        <!-- Hero Content -->
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div class="space-y-3 max-w-2xl">
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/20 text-white border border-white/30 backdrop-blur-md">
                {city.stateName} · USA
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-500/30 text-blue-200 border border-blue-400/40 backdrop-blur-md">
                {(city.demographics.population / 1000).toFixed(0)}K Residents
              </span>
              {city.climateNormals?.peakSummerHighF != null && (
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/30 text-emerald-200 border border-emerald-400/40 backdrop-blur-md flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Avg July High {city.climateNormals.peakSummerHighF}°F
              </span>)}
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white drop-shadow-md">
              {city.name}, {city.stateName}
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed drop-shadow-sm max-w-xl">
              Plan a visit, explore neighborhoods to live, or underwrite commercial locations in {city.name}.
            </p>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-3 shrink-0">
            <a
              href={`/compare/${city.slug.replace('/', '-')}-vs-${isAustin ? 'fl-tampa' : 'tx-austin'}`}
              class="px-5 py-3 rounded-2xl bg-slate-900/80 hover:bg-slate-800 border border-white/20 text-white font-bold text-xs transition backdrop-blur-md flex items-center gap-2 shadow-lg"
            >
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              Compare
            </a>
            <button
              id="save-city-btn"
              data-slug={city.slug}
              data-name={city.name}
              data-state={city.stateCode.toUpperCase()}
              class="px-5 py-3 rounded-2xl bg-slate-900/80 hover:bg-slate-800 border border-white/20 text-white font-bold text-xs transition backdrop-blur-md flex items-center gap-2 shadow-lg cursor-pointer"
            >
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
              <span id="save-city-label">Save city</span>
            </button>
          </div>
        </div>
      </div>

      <!-- PRIMARY INTENT GATE: WHAT BRINGS YOU TO CITY? (Moved Higher) -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-3 px-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-black uppercase tracking-wider text-slate-700">What brings you to {city.name}?</span>
            <span class="text-[11px] text-slate-400 hidden sm:inline">— Choose an objective to personalize your guide and metrics</span>
          </div>
        </div>

        <!-- 3 Tactile Intent Selector Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4" id="triad-cards">
          <!-- 1. Traveling -->
          <button
            data-pillar="pillar-travel"
            class="pillar-btn text-left p-4 sm:p-5 rounded-2xl border-2 transition-all cursor-pointer flex items-center justify-between border-[#1D68F2] bg-blue-50/70 shadow-sm"
          >
            <div class="flex items-center gap-3.5">
              <span class="text-2xl sm:text-3xl p-2.5 rounded-xl bg-white shadow-xs border border-blue-100">✈️</span>
              <div>
                <div class="font-black text-sm sm:text-base text-[#152438]">Visiting {city.name}</div>
                <div class="text-[11px] text-slate-500">Airport distance, climate, and water system</div>
              </div>
            </div>
            <span class="pillar-arrow text-sm font-black text-[#1D68F2]">→</span>
          </button>

          <!-- 2. Moving -->
          <button
            data-pillar="pillar-moving"
            class="pillar-btn text-left p-4 sm:p-5 rounded-2xl border-2 transition-all cursor-pointer flex items-center justify-between border-slate-200 bg-white hover:border-slate-300"
          >
            <div class="flex items-center gap-3.5">
              <span class="text-2xl sm:text-3xl p-2.5 rounded-xl bg-slate-50 shadow-xs border border-slate-200">🏡</span>
              <div>
                <div class="font-black text-sm sm:text-base text-[#152438]">Moving to {city.name}</div>
                <div class="text-[11px] text-slate-500">Living costs, housing, and taxes</div>
              </div>
            </div>
            <span class="pillar-arrow text-sm font-black text-slate-300 hidden">→</span>
          </button>

          <!-- 3. Doing Business -->
          <button
            data-pillar="pillar-business"
            class="pillar-btn text-left p-4 sm:p-5 rounded-2xl border-2 transition-all cursor-pointer flex items-center justify-between border-slate-200 bg-white hover:border-slate-300"
          >
            <div class="flex items-center gap-3.5">
              <span class="text-2xl sm:text-3xl p-2.5 rounded-xl bg-slate-50 shadow-xs border border-slate-200">💼</span>
              <div>
                <div class="font-black text-sm sm:text-base text-[#152438]">Doing Business in {city.name}</div>
                <div class="text-[11px] text-slate-500">Trade density, taxes & lease math</div>
              </div>
            </div>
            <span class="pillar-arrow text-sm font-black text-slate-300 hidden">→</span>
          </button>
        </div>
      </div>

      <!-- AUDIENCE-ADAPTIVE 4-FACT STRIPS (Clean Fact Bar) -->
      <!-- Strip 1: Visiting (Active by Default) -->
      <div id="stats-strip-travel" class="stats-strip grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        {city.climateNormals?.peakSummerHighF != null && (
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Climate</span>
            <span class="text-amber-600 font-extrabold">Open-Meteo</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{city.climateNormals.peakSummerHighF}°F</div>
          <div class="text-[10px] text-slate-500">Avg July High</div>
        </div>
        )}

        {sourcedAirport?.distanceMiles != null && (
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Airport Transit</span>
            <span class="text-blue-600 font-extrabold">{sourcedAirport.iata ?? 'Airport'}</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{sourcedAirport.distanceMiles} Miles</div>
          <div class="text-[10px] text-slate-500">straight line from city center</div>
        </div>
        )}

        {city.terrainElevation?.elevationFeet != null && (
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Topography</span>
            <span class="text-emerald-700 font-extrabold">USGS 3DEP</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{Math.round(city.terrainElevation.elevationFeet)} ft</div>
          <div class="text-[10px] text-slate-500">{city.terrainElevation.topographyClass}</div>
        </div>
        )}

        {city.permitsAndTax?.combinedSalesTaxRate != null && city.permitsAndTax?.provenance && (
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Local Sales Tax</span>
            <span class="text-slate-600 font-extrabold">Combined</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{Number((city.permitsAndTax.combinedSalesTaxRate * 100).toFixed(3)).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:3})}%</div>
          <div class="text-[10px] text-slate-500">State + Municipal Tax</div>
        </div>
        )}
      </div>

      <!-- Strip 2: Moving (Active when Moving is chosen) -->
      <div id="stats-strip-moving" class="stats-strip hidden grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Median Home</span>
            <span class="text-blue-600 font-extrabold">ACS 2023</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{city.housingAndTaxes?.medianHomeValue != null ? `$${Math.round(city.housingAndTaxes.medianHomeValue / 1000)}K` : '—'}</div>
          <div class="text-[10px] text-slate-500">Median Home Value (ACS)</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Typical Rent</span>
            <span class="text-emerald-700 font-extrabold">ACS</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{city.housingAndTaxes?.medianGrossRent != null ? `$${city.housingAndTaxes.medianGrossRent.toLocaleString()}/mo` : '—'}</div>
          <div class="text-[10px] text-slate-500">Median gross rent (ACS)</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Property Tax</span>
            <span class="text-amber-700 font-extrabold">Ad-Valorem</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{city.housingAndTaxes?.effectivePropertyTaxRatePct != null ? `${city.housingAndTaxes.effectivePropertyTaxRatePct.toFixed(2)}%` : '—'}</div>
          <div class="text-[10px] text-slate-500">Median RE tax ÷ median home value</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Population Change</span>
            <span class="text-emerald-700 font-extrabold">2020–23</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{city.demographics.popChange2020to2023Pct != null ? `${city.demographics.popChange2020to2023Pct > 0 ? '+' : ''}${city.demographics.popChange2020to2023Pct}%` : '—'}</div>
          <div class="text-[10px] text-slate-500">{(city.demographics.population / 1000).toFixed(1)}K Residents</div>
        </div>
      </div>

      <!-- Strip 3: Doing Business (Active when Doing Business is chosen) -->
      <div id="stats-strip-business" class="stats-strip hidden grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Underserved Trades</span>
            <span class="text-indigo-600 font-extrabold">ZBP 2022</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{city.industries.filter((i) => i.status === 'underserved').length} of {city.industries.length}</div>
          <div class="text-[10px] text-slate-500">Trades below 80% of national density</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Active Establishments</span>
            <span class="text-blue-600 font-extrabold">Census ZBP</span>
          </div>
          <div id="strip-trade-count" class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{defaultTrade.establishments}</div>
          <div id="strip-trade-label" class="text-[10px] text-slate-500">{defaultTrade.label}</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Saturation Index</span>
            <span class="text-emerald-700 font-extrabold">Empirical Bayes</span>
          </div>
          <div id="strip-trade-saturation" class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{defaultTrade.saturationIndex} / 100</div>
          <div id="strip-trade-status" class="text-[10px] text-slate-500 uppercase font-bold">{defaultTrade.status}</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex justify-between items-start text-slate-400 text-[10px] uppercase font-bold tracking-wider">
            <span>Saturated Trades</span>
            <span class="text-slate-600 font-extrabold">ZBP 2022</span>
          </div>
          <div class="text-xl sm:text-2xl font-black text-[#152438] mt-1">{city.industries.filter((i) => i.status === 'saturated').length} of {city.industries.length}</div>
          <div class="text-[10px] text-slate-500">Trades above 120% of national density</div>
        </div>
      </div>

      <!-- LIVE 7-DAY CITY PULSE WIRE (Austin Chronicle & Commercial News) -->
      {hasVerifiedDispatches && dispatches && (
        <div class="bg-[#0B1120] rounded-2xl border border-slate-800 p-4 sm:p-5 text-white shadow-xl">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-xs font-black uppercase tracking-wider text-emerald-400">Live 7-Day {city.name} Pulse</span>
              <span class="text-slate-500 text-xs hidden sm:inline">·</span>
              <span class="text-slate-400 text-xs hidden sm:inline">Verified local dispatches</span>
            </div>
            <!-- Ticker Pill Switcher -->
            <div class="flex items-center gap-2 bg-slate-900/90 p-1 rounded-xl border border-slate-700/80 text-xs">
              <button id="ticker-btn-events" class="px-3 py-1 rounded-lg font-bold bg-[#1D68F2] text-white transition cursor-pointer">
                🎟️ {isAustin ? 'Austin Chronicle Events' : (isHSV ? 'Village Voice Events' : 'Local Events')}
              </button>
              <button id="ticker-btn-commercial" class="px-3 py-1 rounded-lg font-medium text-slate-400 hover:text-white transition cursor-pointer">
                💼 Commercial & Development Wire
              </button>
            </div>
          </div>

          <!-- Dynamic Ticker Headlines Container -->
          <div class="pt-3">
            <!-- 1. Events Panel -->
            <div id="ticker-panel-events" class="space-y-2">
              {dispatches.chronicleEvents.map((ev, i) => (
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-xs hover:bg-slate-800/40 p-1.5 rounded-lg transition">
                  <div class="flex items-baseline gap-2">
                    <span class="text-blue-400 font-mono text-[11px] font-bold shrink-0">•</span>
                    <a href={ev.url} target="_blank" rel="noopener noreferrer" class="font-bold text-slate-100 hover:text-blue-300 transition">
                      {ev.title}
                    </a>
                    <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 border border-slate-700/60 hidden md:inline">
                      {ev.category}
                    </span>
                  </div>
                  <div class="flex items-center gap-2 text-[11px] text-slate-400 shrink-0 pl-4 sm:pl-0">
                    <span class="text-slate-300 font-semibold">{ev.source}</span>
                    <span>·</span>
                    <span>{ev.date}</span>
                  </div>
                </div>
              ))}
            </div>

            <!-- 2. Commercial Wire Panel (Hidden by default) -->
            <div id="ticker-panel-commercial" class="space-y-2 hidden">
              {dispatches.commercialWire.map((item, i) => (
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-xs hover:bg-slate-800/40 p-1.5 rounded-lg transition">
                  <div class="flex items-baseline gap-2">
                    <span class="text-emerald-400 font-mono text-[11px] font-bold shrink-0">•</span>
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-bold text-slate-100 hover:text-emerald-300 transition">
                      {item.title}
                    </a>
                    <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 border border-slate-700/60 hidden md:inline">
                      {item.category}
                    </span>
                  </div>
                  <div class="flex items-center gap-2 text-[11px] text-slate-400 shrink-0 pl-4 sm:pl-0">
                    <span class="text-slate-300 font-semibold">{item.source}</span>
                    <span>·</span>
                    <span>{item.date}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Main Split Layout (Pillars on Left, Free Lead Dossier on Right) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: The Active Pillar (8 cols) -->
      <div class="lg:col-span-8 space-y-8">

        <!-- ========================================== -->
        <!-- PILLAR 1: TRAVELING TO CITY               -->
        <!-- ========================================== -->
        <div id="pillar-travel" class="pillar-panel space-y-8">
          <section class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] space-y-6">
            <div class="flex justify-between items-center pb-3 border-b border-slate-100">
              <div>
                <h2 class="text-2xl font-black text-[#152438]">Traveling to {city.name}</h2>
                <p class="text-xs text-slate-500 mt-1">Airport distance, climate, and water-system facts on the record</p>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-[#1D68F2]">Visitor Guide</span>
            </div>

            <!-- 1. PHOTOS: CITY IN PHOTOS -->
            {cityGallery && (
              <div class="space-y-3 pt-1">
                <div class="flex justify-between items-center">
                  <h3 class="font-black text-xl text-[#152438]">{city.name} in Photos</h3>
                  <span class="text-xs text-slate-400 font-medium">Wikimedia Commons & USGS</span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  {cityGallery.map((item) => (
                    <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-2xs group relative">
                      <img src={item.img} alt={`${city.name} - ${item.title}`} class="w-full h-28 sm:h-36 object-cover group-hover:scale-105 transition duration-500" />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-2.5 text-white">
                        <span class="text-[11px] font-bold leading-tight">{item.title}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- 2. VIDEO: FEATURED 4K DRONE TOUR -->
            {featuredVideo && (
              <div class="space-y-3 pt-2">
                <div class="flex justify-between items-center">
                  <div class="flex items-center gap-2">
                    <span class="text-lg">🎬</span>
                    <h3 class="font-black text-xl text-[#152438]">Featured Aerial Drone Showcase</h3>
                  </div>
                  <span class="text-[10px] font-bold px-2.5 py-0.5 rounded bg-rose-50 text-rose-700 border border-rose-200 flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-pulse"></span>
                    4K Video Showcase
                  </span>
                </div>

                <!-- Lite YouTube Player Container -->
                <div
                  class="relative rounded-3xl overflow-hidden border border-slate-800 shadow-xl bg-slate-900 aspect-video group cursor-pointer"
                  id="video-tour-container"
                  data-video-id={featuredVideo.videoId}
                >
                  <img
                    id="video-poster-img"
                    src={`https://img.youtube.com/vi/${featuredVideo.videoId}/hqdefault.jpg`}
                    alt={`${city.name} Video Tour Preview`}
                    class="w-full h-full object-cover filter brightness-[0.70] group-hover:scale-105 transition duration-700"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-between p-6 text-white">
                    <div class="flex justify-between items-center">
                      <span class="px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-xs font-bold border border-white/20">
                        {featuredVideo.badge}
                      </span>
                      <span class="px-2.5 py-1 rounded-md bg-black/70 font-mono text-xs font-semibold">{featuredVideo.duration}</span>
                    </div>
                    <div class="flex items-center gap-4">
                      <div class="w-14 h-14 rounded-full bg-rose-600 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:bg-rose-500 transition shrink-0">
                        <svg class="w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                      </div>
                      <div>
                        <div class="text-base sm:text-lg font-black text-white group-hover:text-rose-200 transition">
                          {featuredVideo.title}
                        </div>
                        <div class="text-xs text-slate-300">Click to play high-definition aerial showcase · Hosted on YouTube</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {sourcedAirport && (
            <div class="bg-gradient-to-br from-[#152438] to-slate-900 rounded-3xl p-6 text-white space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                  <span class="text-3xl">🛫</span>
                  <div>
                    <h3 class="font-black text-lg text-white">Getting Here: {sourcedAirport.name}{sourcedAirport.iata ? ` (${sourcedAirport.iata})` : ''}</h3>
                    <p class="text-xs text-slate-300">{sourcedAirport.distanceMiles} miles from the city center (straight line)</p>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
                <div class="bg-white/10 p-3 rounded-xl border border-white/10">
                  <span class="text-slate-400 block text-[11px]">Distance from city center</span>
                  <span class="font-bold text-slate-100">{`${sourcedAirport.distanceMiles} mi straight line`}</span>
                </div>
                <div class="bg-white/10 p-3 rounded-xl border border-white/10">
                  <span class="text-slate-400 block text-[11px]">Airport</span>
                  <span class="font-bold text-slate-100">{sourcedAirport.name}</span>
                </div>
              </div>
            </div>
            )}

            {(city as any).waterUtility && (
            <div class="rounded-3xl p-6 sm:p-7 bg-[#F8FAFC] border-2 border-blue-200/80 shadow-xs space-y-5">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-200">
                <div class="flex items-center gap-2.5">
                  <span class="text-xl">⚠️</span>
                  <div>
                    <h3 class="text-base font-black text-[#152438]">Before You Go: Water & Climate</h3>
                    <p class="text-xs text-slate-500">Sourced climate and water-system facts for {city.name}</p>
                  </div>
                </div>
                <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-100 text-[#1D68F2] border border-blue-200 shrink-0">
                  Sourced
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-2xs space-y-1.5">
                  <div class="flex items-center gap-2 font-bold text-slate-800">
                    <span class="text-base">🚰</span>
                    <span>Water system</span>
                  </div>
                  <div class="text-slate-600 leading-relaxed">
                    <span><strong>Tap water:</strong> Served by {(city as any).waterUtility.providerName} (PWSID {(city as any).waterUtility.pwsid}), a {(city as any).waterUtility.sourceType} system serving about {(city as any).waterUtility.populationServed.toLocaleString('en-US')} people. <em>Source: EPA SDWIS, retrieved Oct 2026.</em> In an emergency, dial 911.</span>
                  </div>
                </div>
              </div>
            </div>
            )}
          </section>
        </div>

        <!-- ========================================== -->
        <!-- PILLAR 2: MOVING                         -->
        <!-- ========================================== -->
        <div id="pillar-moving" class="pillar-panel hidden space-y-8">
          <section class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] space-y-6">
            <div class="flex justify-between items-center pb-3 border-b border-slate-100">
              <div>
                <h2 class="text-2xl font-black text-[#152438]">Moving to {city.name}</h2>
                <p class="text-xs text-slate-500 mt-1">Demographics, elevation, climate normals, healthcare, and neighborhood living dynamics</p>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">Relocation Index</span>
            </div>

            <!-- Demographics Snapshot Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                <span class="text-xs font-semibold text-slate-500">Total Population</span>
                <div class="text-2xl font-black text-[#152438] mt-1">{city.demographics.population.toLocaleString()}</div>
                <span class="text-[11px] text-emerald-600 font-semibold">{city.demographics.popChange2020to2023Pct != null ? `${city.demographics.popChange2020to2023Pct > 0 ? '+' : ''}${city.demographics.popChange2020to2023Pct}%` : '—'} Since 2020 (Census est.)</span>
              </div>
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                <span class="text-xs font-semibold text-slate-500">Median Household Income</span>
                <div class="text-2xl font-black text-[#152438] mt-1">${city.demographics.medianHouseholdIncome.toLocaleString()}</div>
                <span class="text-[11px] text-slate-500">Per Capita: ${city.demographics.perCapitaIncome.toLocaleString()}</span>
              </div>
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                <span class="text-xs font-semibold text-slate-500">Median Resident Age</span>
                <div class="text-2xl font-black text-[#152438] mt-1">{city.demographics.medianAge} Years</div>
                <span class="text-[11px] text-slate-500">Census ACS 2023</span>
              </div>
            </div>

            {(city.terrainElevation || city.climateNormals) && (
            <div class="space-y-3 pt-2">
              <h3 class="font-bold text-base text-[#152438]">Elevation, Terrain & Climate Normals</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                {city.terrainElevation && (
                <div class="p-5 rounded-2xl bg-[#F8FAFC] border border-slate-200 space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="text-lg">⛰️</span>
                    <h4 class="font-bold text-sm text-[#152438]">USGS 3DEP High-Resolution Elevation</h4>
                  </div>
                  <div class="space-y-1.5 text-slate-600">
                    <div class="flex justify-between">
                      <span class="text-slate-400">Exact Elevation:</span>
                      <span class="font-bold text-slate-800">{`${city.terrainElevation.elevationFeet.toFixed(1)} ft (${city.terrainElevation.elevationMeters.toFixed(1)} m)`}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Topography Class:</span>
                      <span class="font-bold text-slate-800">{city.terrainElevation.topographyClass}</span>
                    </div>
                  </div>
                </div>
                )}

                {city.climateNormals?.peakSummerHighF != null && (
                <div class="p-5 rounded-2xl bg-[#F8FAFC] border border-slate-200 space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="text-lg">☀️</span>
                    <h4 class="font-bold text-sm text-[#152438]">Climate Averages (2015–2024)</h4>
                  </div>
                  <div class="space-y-1.5 text-slate-600">
                    <div class="flex justify-between">
                      <span class="text-slate-400">Annual Precipitation:</span>
                      <span class="font-bold text-slate-800">{`${city.climateNormals.annualRainfallInches} Inches`}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Summer High / Winter Low:</span>
                      <span class="font-bold text-slate-800">{`${city.climateNormals.peakSummerHighF}°F Avg July High / ${city.climateNormals.winterLowF}°F Avg Jan Low`}</span>
                    </div>
                  </div>
                </div>
                )}
              </div>
            </div>
            )}

            {erHospitals.length > 0 && (
            <div class="space-y-3 pt-2">
              <h3 class="font-bold text-base text-[#152438]">Hospitals with emergency departments in {city.name} (CMS)</h3>
              <div class="p-5 rounded-2xl bg-slate-900 text-white space-y-3">
                <div class="space-y-2 text-slate-300">
                  {erHospitals.map((h) => (
                    <p><strong>{h.name}</strong> — {h.address} — {h.type}</p>
                  ))}
                </div>
                {erHospitalsSource && (
                  <p class="text-[11px] text-slate-400 leading-relaxed">{erHospitalsSource}</p>
                )}
              </div>
            </div>
            )}

            <!-- Housing & Property Tax Friction -->
            <div class="space-y-3 pt-2">
              <h3 class="font-bold text-base text-[#152438]">Housing Costs & Property Tax Friction</h3>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                  <span class="text-xs font-semibold text-slate-500">Median Home Price</span>
                  <div class="text-2xl font-black text-[#152438] mt-1">{city.housingAndTaxes?.medianHomeValue != null ? `$${city.housingAndTaxes.medianHomeValue.toLocaleString()}` : '—'}</div>
                  <span class="text-[11px] text-slate-400">Census ACS 2023 · owner-occupied median</span>
                </div>
                <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                  <span class="text-xs font-semibold text-slate-500">Median Gross Rent</span>
                  <div class="text-2xl font-black text-[#152438] mt-1">{city.housingAndTaxes?.medianGrossRent != null ? `$${city.housingAndTaxes.medianGrossRent.toLocaleString()}/mo` : '—'}</div>
                  <span class="text-[11px] text-slate-400">ACS 2023 · all renter-occupied units</span>
                </div>
                <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                  <span class="text-xs font-semibold text-slate-500">Effective Property Tax</span>
                  <div class="text-2xl font-black text-[#152438] mt-1">{city.housingAndTaxes?.effectivePropertyTaxRatePct != null ? `${city.housingAndTaxes.effectivePropertyTaxRatePct.toFixed(2)}%` : '—'}</div>
                  <span class="text-[11px] text-amber-700 font-semibold">Census ACS 2023 · B25103 ÷ B25077</span>
                </div>
              </div>
              {city.housingAndTaxes?.homesteadExemptionNote && (
              <p class="text-[11px] text-slate-500">
                {city.housingAndTaxes.homesteadExemptionNote}
              </p>
              )}
            </div>
          </section>
        </div>

        <!-- ========================================== -->
        <!-- PILLAR 3: DOING BUSINESS                  -->
        <!-- ========================================== -->
        <div id="pillar-business" class="pillar-panel hidden space-y-8" data-industries={JSON.stringify(industriesWithDefaults)}>
          <!-- Interactive Trade / Industry Selector Banner -->
          <div class="bg-gradient-to-r from-blue-900 to-slate-900 p-6 sm:p-7 rounded-3xl text-white shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-5 border border-slate-800">
            <div class="space-y-1">
              <span class="text-[10px] font-black uppercase tracking-wider text-blue-400 bg-blue-500/20 px-2.5 py-1 rounded-full border border-blue-400/30">
                Census trade counts
              </span>
              <h2 class="text-xl sm:text-2xl font-black text-white">Establishment counts on the record</h2>
              <p class="text-xs text-slate-300 max-w-xl">
                Choose a NAICS trade to see the Census establishment count for {city.name}. Lease rates and breakeven are not on the record.
              </p>
            </div>
            <div class="shrink-0 w-full md:w-96 space-y-2">
              <div class="flex items-center justify-between">
                <label for="trade-select" class="block text-[11px] font-bold text-slate-300 uppercase tracking-wider">Select trade:</label>
              </div>
              <select
                id="trade-select"
                class="w-full px-4 py-3 rounded-2xl bg-white text-slate-900 font-extrabold text-xs shadow-xl border-2 border-blue-400 focus:ring-2 focus:ring-blue-300 outline-none cursor-pointer"
              >
                <optgroup label="Standard NAICS Benchmarks">
                  {industriesWithDefaults.map((ind) => (
                    <option value={ind.naicsCode} selected={ind.naicsCode === '722515'}>
                      {ind.label} — {ind.status.toUpperCase()} ({ind.establishments} units)
                    </option>
                  ))}
                </optgroup>
              </select>
            </div>
          </div>

          <!-- Commercial Establishment Density & Saturation Metrics -->
          <section class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
              <div>
                <h2 id="active-trade-label" class="text-xl font-black text-[#152438]">Commercial Establishment Density — {defaultTrade.label}</h2>
                <p id="active-trade-desc" class="text-xs text-slate-500 mt-0.5">Census County Business Patterns (ZBP 2022) small-business metrics across {city.name}</p>
              </div>
              <span id="active-trade-badge" class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
                defaultTrade.status === 'underserved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                defaultTrade.status === 'balanced' ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-rose-50 text-rose-700 border border-rose-200'
              }`}>
                <span class="w-2 h-2 rounded-full bg-current animate-pulse"></span>
                {defaultTrade.status}
              </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2">
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                <span class="text-xs font-semibold text-slate-500">Active Establishments</span>
                <div id="active-trade-count" class="text-2xl font-black text-[#152438] mt-1">{defaultTrade.establishments}</div>
                <span class="text-[11px] text-slate-400">Census ZBP 2022</span>
              </div>
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200">
                <span class="text-xs font-semibold text-slate-500">Density / 10k Residents</span>
                <div id="active-trade-density" class="text-2xl font-black text-[#152438] mt-1">{defaultTrade.per10kResidents}</div>
                <span id="active-trade-benchmark" class="text-[11px] text-slate-400">National Benchmark: {defaultTrade.usAvgPer10k}</span>
              </div>
              <div class="bg-[#F8FAFC] p-4 rounded-2xl border border-slate-200 col-span-2 sm:col-span-1">
                <span class="text-xs font-semibold text-slate-500">Saturation Index</span>
                <div id="active-trade-saturation" class="text-2xl font-black text-[#152438] mt-1">{defaultTrade.saturationIndex} <span class="text-xs font-normal text-slate-400">/ 100</span></div>
                <span class="text-[11px] text-emerald-600 font-semibold">Census ZBP vs national density</span>
              </div>
            </div>
          </section>

          <!-- Trade density is on the record. Lease math is not: no verified rent, ticket, or labor fields. -->

          <!-- 25-Industry NAICS Saturation Table -->
