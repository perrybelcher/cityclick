---
import Layout from '../../layouts/Layout.astro';
import manifest from '../../data/index-manifest.json';

export async function getStaticPaths() {
  const certifiedSlugs = new Set([
    'tx/austin',
    'ar/hot-springs-village',
    'ar/hot-springs',
    'id/boise',
    'fl/tampa',
    'az/scottsdale',
    'tn/nashville',
  ]);

  const statesMap: Record<string, { stateCode: string; stateName: string; cities: any[] }> = {};

  manifest.forEach((city) => {
    const code = city.stateCode.toLowerCase();
    if (!statesMap[code]) {
      statesMap[code] = {
        stateCode: code,
        stateName: city.stateName,
        cities: [],
      };
    }
    statesMap[code].cities.push(city);
  });

  return Object.values(statesMap).map((st) => ({
    params: { state: st.stateCode },
    props: {
      stateCode: st.stateCode,
      stateName: st.stateName,
      cities: st.cities.sort((a, b) => {
        const aCert = certifiedSlugs.has(a.slug) ? 1 : 0;
        const bCert = certifiedSlugs.has(b.slug) ? 1 : 0;
        if (aCert !== bCert) return bCert - aCert;
        return (b.population || 0) - (a.population || 0);
      }),
    },
  }));
}

const CERTIFIED_SLUGS = new Set([
  'tx/austin',
  'ar/hot-springs-village',
  'ar/hot-springs',
  'id/boise',
  'fl/tampa',
  'az/scottsdale',
  'tn/nashville',
]);

const { stateCode, stateName, cities } = Astro.props;
const verifiedCount = cities.filter((c: any) => CERTIFIED_SLUGS.has(c.slug)).length;
---

<Layout
  title={`${stateName} City Directory — CityClick`}
  description={`Browse ${cities.length} municipal entries in ${stateName}, including primary-source verified city guides and preview entries currently in review.`}
  robots="noindex, follow"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6 tracking-wide uppercase">
      <a href="/" class="hover:text-blue-600 transition">Home</a>
      <span>/</span>
      <a href="/#states" class="hover:text-blue-600 transition">States</a>
      <span>/</span>
      <span class="text-slate-800 font-bold">{stateName}</span>
    </nav>

    <!-- Header Banner -->
    <div class="bg-gradient-to-br from-[#0F172A] via-[#1E293B] to-[#0B1120] rounded-3xl p-8 sm:p-10 text-white mb-10 shadow-xl border border-white/10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30 text-xs font-bold uppercase tracking-wider">
            State Directory · {stateCode.toUpperCase()}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
            {stateName} Municipal Directory
          </h1>
          <p class="text-sm text-slate-300 max-w-2xl leading-relaxed">
            {cities.length} municipal entries in {stateName}. Primary-source verified city guides are badged below and sorted first; remaining preview entries are currently undergoing primary-record verification.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          {verifiedCount > 0 && (
            <div class="bg-emerald-500/15 backdrop-blur-md px-5 py-3 rounded-2xl border border-emerald-400/30 text-right">
              <div class="text-2xl font-black text-emerald-300">{verifiedCount}</div>
              <div class="text-[11px] font-bold text-emerald-200 uppercase tracking-wider">
                {verifiedCount === 1 ? 'Verified Guide' : 'Verified Guides'}
              </div>
            </div>
          )}
          <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-2xl border border-white/15 text-right">
            <div class="text-2xl font-black text-white">{cities.length}</div>
            <div class="text-[11px] font-bold text-blue-300 uppercase tracking-wider">Municipal Entries</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter input -->
    <div class="mb-8">
      <div class="relative max-w-md">
        <input
          type="text"
          id="state-city-filter"
          placeholder={`Filter ${cities.length} municipal entries in ${stateName}...`}
          class="w-full px-4 py-3 pl-10 rounded-2xl bg-white border border-slate-200 text-sm font-medium text-slate-800 placeholder-slate-400 shadow-2xs outline-none focus:border-blue-500 transition"
        />
        <svg class="w-4 h-4 absolute left-3.5 top-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- Cities Grid -->
    <div id="state-cities-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {cities.map((city) => {
        const isCertified = CERTIFIED_SLUGS.has(city.slug);
        return (
          <a
            href={`/${city.slug}/`}
            class:list={[
              'state-city-card p-5 rounded-2xl bg-white border transition flex flex-col justify-between group',
              isCertified
                ? 'border-emerald-300/90 hover:border-emerald-500 hover:shadow-md ring-1 ring-emerald-500/10'
                : 'border-slate-200/80 hover:border-blue-500 hover:shadow-md',
            ]}
            data-name={city.name.toLowerCase()}
          >
            <div>
              <div class="flex items-start justify-between gap-2">
                <h2 class="text-base font-black text-[#152438] group-hover:text-[#1D68F2] transition">
                  {city.name}
                </h2>
                {isCertified ? (
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                    Verified Guide
                  </span>
                ) : (
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 border border-slate-200 shrink-0">
                    In Review
                  </span>
                )}
              </div>

              {isCertified ? (
                <div class="mt-3 space-y-1 text-xs text-slate-500">
                  {city.population ? (
                    <div class="flex justify-between">
                      <span>Population:</span>
                      <span class="font-bold text-slate-700">{city.population.toLocaleString()}</span>
                    </div>
                  ) : null}
                  {city.medianHouseholdIncome ? (
                    <div class="flex justify-between">
                      <span>Median Income:</span>
                      <span class="font-bold text-slate-700">${city.medianHouseholdIncome.toLocaleString()}</span>
                    </div>
                  ) : null}
                </div>
              ) : (
                <p class="mt-3 text-xs text-slate-500 leading-relaxed">
                  Primary-source verification in progress
                </p>
              )}
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold text-[#1D68F2]">
              <span>{isCertified ? 'Open Verified Guide' : 'View Entry'}</span>
              <span class="group-hover:translate-x-1 transition">→</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>

  <script is:inline>
    const filterInput = document.getElementById('state-city-filter');
    const cards = document.querySelectorAll('.state-city-card');

    if (filterInput) {
      filterInput.addEventListener('input', (e) => {
        const val = e.target.value.toLowerCase().trim();
        cards.forEach((card) => {
          const name = card.getAttribute('data-name') || '';
          if (name.includes(val)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }
  </script>
</Layout>
