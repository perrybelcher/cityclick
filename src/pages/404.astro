---
import Layout from '../layouts/Layout.astro';
import { CERTIFIED_FLAGSHIPS } from '../config/flagships';

const CERTIFIED_GUIDES = CERTIFIED_FLAGSHIPS.map((f) => ({
  slug: f.slug,
  label: `${f.name}, ${f.stateCode}`,
}));
---

<Layout
  title="Page Not Found (404) — CityClick"
  description="The city guide or page you requested could not be found. Search CityClick's US city guides or open one of our primary-source verified flagship guides."
  robots="noindex, follow"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center space-y-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-3xl bg-blue-50 text-[#1D68F2] font-black text-2xl border border-blue-200">
      404
    </div>

    <h1 class="text-3xl sm:text-4xl font-black text-[#152438] tracking-tight">
      City or Page Not Found
    </h1>

    <p class="text-sm text-slate-600 max-w-lg mx-auto leading-relaxed">
      The city guide or page you requested does not exist or may have moved. Search CityClick's city guides below or open one of our primary-source verified flagship guides.
    </p>

    <!-- Quick Search Box -->
    <div class="max-w-md mx-auto pt-2">
      <form action="/" method="GET" class="flex gap-2 p-1.5 bg-white rounded-2xl border border-slate-200 shadow-md">
        <input
          type="text"
          name="search"
          placeholder="Search a city (e.g. Austin, Nashville, Boise)..."
          class="flex-1 px-4 py-2.5 text-xs outline-none bg-transparent"
        />
        <button
          type="submit"
          class="px-4 py-2.5 rounded-xl bg-[#1D68F2] hover:bg-blue-600 text-white font-bold text-xs transition"
        >
          Search
        </button>
      </form>
    </div>

    <!-- Verified Flagship Guides -->
    <div class="pt-6 max-w-2xl mx-auto space-y-3">
      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
        Verified Flagship City Guides
      </div>
      <div class="flex flex-wrap items-center justify-center gap-2">
        {CERTIFIED_GUIDES.map((guide) => (
          <a
            href={`/${guide.slug}/`}
            class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:border-[#1D68F2] text-xs font-bold text-[#152438] hover:text-[#1D68F2] shadow-2xs transition"
          >
            {guide.label} →
          </a>
        ))}
      </div>
    </div>

    <div class="pt-6 flex flex-wrap items-center justify-center gap-4 text-xs font-bold text-slate-500">
      <a href="/" class="hover:text-[#1D68F2] transition">← Back to Homepage</a>
      <span>·</span>
      <a href="/#featured" class="hover:text-[#1D68F2] transition">Featured Guides</a>
      <span>·</span>
      <a href="/#states" class="hover:text-[#1D68F2] transition">Browse by State</a>
      <span>·</span>
      <a href="/methodology/" class="hover:text-[#1D68F2] transition">Data Methodology</a>
    </div>
  </div>
</Layout>
