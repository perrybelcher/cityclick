---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import manifest from '../../data/index-manifest.json';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=604800');

const { cityA, cityB } = Astro.params;

const CERTIFIED = ['tx/austin','ar/hot-springs-village','id/boise','fl/tampa','az/scottsdale','tn/nashville','ok/oklahoma-city'];
let recordA: any = null;
let recordB: any = null;

for (const c of manifest) {
  const slugKey = c.slug.replace('/', '-'); // e.g. tx-austin
  if (slugKey === cityA || c.slug === cityA) recordA = c;
  if (slugKey === cityB || c.slug === cityB) recordB = c;
}

// Fallback if not found
if (!recordA || !recordB || !CERTIFIED.includes(recordA.slug) || !CERTIFIED.includes(recordB.slug)) {
  return Astro.redirect('/?error=comparison_not_found');
}
---

<Layout
  title={`${recordA.name}, ${recordA.stateCode.toUpperCase()} vs ${recordB.name}, ${recordB.stateCode.toUpperCase()} Comparison — CityClick`}
  description={`Compare ${recordA.name} and ${recordB.name} side-by-side on Census demographics, housing costs, property tax and sales tax, and local sales tax.`}
>
  <section class="bg-gradient-to-b from-[#EDF4FC] to-white py-12 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-[#1D68F2] text-xs font-bold mb-4">
        Comparative Site Selection
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-[#152438] tracking-tight">
        {recordA.name}, {recordA.stateCode.toUpperCase()} vs {recordB.name}, {recordB.stateCode.toUpperCase()}
      </h1>
      <p class="text-sm text-slate-600 mt-2">
        Side-by-side municipal, commercial underwriting, and travel logistics comparison for multi-unit operators.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="grid grid-cols-3 bg-slate-50 border-b border-slate-200 text-xs sm:text-sm font-bold text-[#152438] p-4 sm:p-6">
        <div>Metric</div>
        <div class="text-center">{recordA.name}, {recordA.stateCode.toUpperCase()}</div>
        <div class="text-center">{recordB.name}, {recordB.stateCode.toUpperCase()}</div>
      </div>

      <div class="divide-y divide-slate-100 text-xs sm:text-sm">
        <div class="grid grid-cols-3 p-4 sm:p-6 items-center">
          <div class="font-semibold text-slate-700">Population (2023 est.)</div>
          <div class="text-center font-bold text-slate-800">{recordA.population != null ? recordA.population.toLocaleString() : '—'}</div>
          <div class="text-center font-bold text-slate-800">{recordB.population != null ? recordB.population.toLocaleString() : '—'}</div>
        </div>
        <div class="grid grid-cols-3 p-4 sm:p-6 items-center bg-slate-50/50">
          <div class="font-semibold text-slate-700">Population Change Since 2020</div>
          <div class="text-center font-bold text-slate-800">{recordA.popChange2020to2023Pct != null ? `${recordA.popChange2020to2023Pct > 0 ? '+' : ''}${recordA.popChange2020to2023Pct}%` : '—'}</div>
          <div class="text-center font-bold text-slate-800">{recordB.popChange2020to2023Pct != null ? `${recordB.popChange2020to2023Pct > 0 ? '+' : ''}${recordB.popChange2020to2023Pct}%` : '—'}</div>
        </div>
        <div class="grid grid-cols-3 p-4 sm:p-6 items-center">
          <div class="font-semibold text-slate-700">Median Household Income</div>
          <div class="text-center font-bold text-slate-800">{recordA.medianHouseholdIncome != null ? `$${recordA.medianHouseholdIncome.toLocaleString()}` : '—'}</div>
          <div class="text-center font-bold text-slate-800">{recordB.medianHouseholdIncome != null ? `$${recordB.medianHouseholdIncome.toLocaleString()}` : '—'}</div>
        </div>
        <div class="grid grid-cols-3 p-4 sm:p-6 items-center bg-slate-50/50">
          <div class="font-semibold text-slate-700">Median Home Value</div>
          <div class="text-center font-bold text-slate-800">{recordA.medianHomeValue != null ? `$${recordA.medianHomeValue.toLocaleString()}` : '—'}</div>
          <div class="text-center font-bold text-slate-800">{recordB.medianHomeValue != null ? `$${recordB.medianHomeValue.toLocaleString()}` : '—'}</div>
        </div>
        <div class="grid grid-cols-3 p-4 sm:p-6 items-center">
          <div class="font-semibold text-slate-700">Median Gross Rent (monthly)</div>
          <div class="text-center font-bold text-slate-800">{recordA.medianGrossRent != null ? `$${recordA.medianGrossRent.toLocaleString()}` : '—'}</div>
          <div class="text-center font-bold text-slate-800">{recordB.medianGrossRent != null ? `$${recordB.medianGrossRent.toLocaleString()}` : '—'}</div>
        </div>
        <div class="grid grid-cols-3 p-4 sm:p-6 items-center bg-slate-50/50">
          <div class="font-semibold text-slate-700">Effective Property Tax Rate</div>
          <div class="text-center font-bold text-slate-800">{recordA.effectivePropertyTaxRatePct != null ? `${recordA.effectivePropertyTaxRatePct.toFixed(2)}%` : '—'}</div>
          <div class="text-center font-bold text-slate-800">{recordB.effectivePropertyTaxRatePct != null ? `${recordB.effectivePropertyTaxRatePct.toFixed(2)}%` : '—'}</div>
        </div>

        <!-- Combined Sales Tax -->
        <div class="grid grid-cols-3 p-4 sm:p-6 items-center bg-slate-50/50">
          <div class="font-semibold text-slate-700">Combined Sales Tax Rate</div>
          <div class="text-center font-bold text-slate-800">
            {recordA.combinedSalesTaxRate != null ? `${(recordA.combinedSalesTaxRate * 100).toFixed(2)}%` : '—'}
          </div>
          <div class="text-center font-bold text-slate-800">
            {recordB.combinedSalesTaxRate != null ? `${(recordB.combinedSalesTaxRate * 100).toFixed(2)}%` : '—'}
          </div>
        </div>

        <!-- Time Zone -->
        <div class="grid grid-cols-3 p-4 sm:p-6 items-center">
          <div class="font-semibold text-slate-700">Time Zone</div>
          <div class="text-center font-bold text-slate-800">
            {recordA.timeZone ?? 'CT'}
          </div>
          <div class="text-center font-bold text-slate-800">
            {recordB.timeZone ?? 'ET'}
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="grid grid-cols-3 p-6 bg-slate-50 border-t border-slate-200">
        <div></div>
        <div class="text-center">
          <a
            href={`/${recordA.slug}`}
            class="px-4 py-2 rounded-xl bg-[#1D68F2] text-white font-semibold text-xs inline-block hover:bg-blue-600 transition"
          >
            Inspect {recordA.name} Profile →
          </a>
        </div>
        <div class="text-center">
          <a
            href={`/${recordB.slug}`}
            class="px-4 py-2 rounded-xl bg-[#1D68F2] text-white font-semibold text-xs inline-block hover:bg-blue-600 transition"
          >
            Inspect {recordB.name} Profile →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
