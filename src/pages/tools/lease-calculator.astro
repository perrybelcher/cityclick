---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Commercial Lease & Breakeven Calculator — CityClick"
  description="Calculate the exact daily customer volume and monthly revenue required to break even on a retail or commercial lease, factoring in NNN CAM, wages, and sales taxes."
>
  <section class="bg-gradient-to-b from-[#EDF4FC] to-white py-12 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#152438] tracking-tight">
        Commercial Lease & Breakeven Calculator
      </h1>
      <p class="text-sm text-slate-600 mt-2">
        Underwrite retail locations before signing an LOI. Solves for monthly occupancy costs, labor burden, and daily customer transaction velocity.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Calculator Inputs -->
      <div class="md:col-span-7 space-y-4">
        <h2 class="text-lg font-bold text-[#152438]">Lease & Cost Inputs</h2>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Usable Square Feet</label>
            <input id="c-sqft" type="number" value="1500" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Base Asking Rent ($/sqft/yr)</label>
            <input id="c-rent" type="number" value="32.00" step="0.5" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">NNN / CAM ($/sqft/yr)</label>
            <input id="c-nnn" type="number" value="6.50" step="0.25" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Hourly Wage ($/hr)</label>
            <input id="c-wage" type="number" value="16.50" step="0.5" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Staff Hours / Week</label>
            <input id="c-hours" type="number" value="120" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Average Gross Ticket ($)</label>
            <input id="c-ticket" type="number" value="8.50" step="0.25" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Cost of Goods (COGS %)</label>
            <input id="c-cogs" type="number" value="28" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Sales Tax Rate (%)</label>
            <input id="c-tax" type="number" value="8.25" step="0.05" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Monthly Operating Overhead ($)</label>
          <input id="c-overhead" type="number" value="1200" step="50" class="w-full px-3 py-2 border rounded-xl text-sm font-semibold" />
          <span class="text-[11px] text-slate-400 mt-0.5 block">Utilities, commercial property insurance, POS software, and administrative baseline.</span>
        </div>
      </div>

      <!-- Live Results Panel -->
      <div class="md:col-span-5 bg-[#EDF4FC] p-6 rounded-2xl border border-blue-200 flex flex-col justify-between">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-[#1D68F2] mb-4">Required Breakeven Velocity</div>
          
          <div class="space-y-4">
            <div>
              <div class="text-xs text-slate-600">Daily Customers Required</div>
              <div id="c-out-daily" class="text-4xl font-black text-[#152438]">94</div>
              <div class="text-[11px] text-slate-500">transactions per operating day</div>
            </div>

            <div class="pt-2 border-t border-blue-200">
              <div class="text-xs text-slate-600">Monthly Net Revenue Needed</div>
              <div id="c-out-rev" class="text-2xl font-bold text-slate-800">$22,460</div>
            </div>

            <div>
              <div class="text-xs text-slate-600">Monthly Occupancy Cost (Rent+NNN)</div>
              <div id="c-out-occ" class="text-lg font-bold text-slate-700">$4,813</div>
            </div>

            <div>
              <div class="text-xs text-slate-600">Monthly Labor (incl 18% burden)</div>
              <div id="c-out-labor" class="text-lg font-bold text-slate-700">$10,159</div>
            </div>

            <div>
              <div class="text-xs text-slate-600">Monthly Operating Overhead</div>
              <div id="c-out-overhead" class="text-lg font-bold text-slate-700">$1,200</div>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-blue-200 text-[11px] text-slate-500">
          Engine accounts for 18% payroll burden (FICA/FUTA/SUTA) and strips state/local sales taxes before computing gross customer requirements.
        </div>
      </div>
    </div>
  </section>

  <script>
    function updateCalc() {
      const sqft = parseFloat((document.getElementById('c-sqft') as HTMLInputElement)?.value) || 0;
      const rent = parseFloat((document.getElementById('c-rent') as HTMLInputElement)?.value) || 0;
      const nnn = parseFloat((document.getElementById('c-nnn') as HTMLInputElement)?.value) || 0;
      const wage = parseFloat((document.getElementById('c-wage') as HTMLInputElement)?.value) || 0;
      const hours = parseFloat((document.getElementById('c-hours') as HTMLInputElement)?.value) || 0;
      const ticket = parseFloat((document.getElementById('c-ticket') as HTMLInputElement)?.value) || 0;
      const cogsPct = (parseFloat((document.getElementById('c-cogs') as HTMLInputElement)?.value) || 0) / 100;
      const taxRate = (parseFloat((document.getElementById('c-tax') as HTMLInputElement)?.value) || 0) / 100;
      const overhead = parseFloat((document.getElementById('c-overhead') as HTMLInputElement)?.value) || 0;

      const monthlyOcc = (sqft * (rent + nnn)) / 12;
      const monthlyLabor = wage * hours * 4.3482 * 1.18;
      const monthlyFixed = monthlyOcc + monthlyLabor + overhead;

      const netTicket = ticket / (1 + taxRate);
      const contributionMargin = netTicket * (1 - cogsPct);

      if (contributionMargin > 0 && ticket > 0 && cogsPct < 1) {
        const monthlyCust = Math.ceil(monthlyFixed / contributionMargin);
        const dailyCust = Math.ceil(monthlyCust / 30.4375);
        const monthlyRev = monthlyFixed / (1 - cogsPct);

        document.getElementById('c-out-daily')!.innerText = dailyCust.toString();
        document.getElementById('c-out-rev')!.innerText = '$' + Math.round(monthlyRev).toLocaleString();
        document.getElementById('c-out-occ')!.innerText = '$' + Math.round(monthlyOcc).toLocaleString();
        document.getElementById('c-out-labor')!.innerText = '$' + Math.round(monthlyLabor).toLocaleString();
        document.getElementById('c-out-overhead')!.innerText = '$' + Math.round(overhead).toLocaleString();
      } else {
        document.getElementById('c-out-daily')!.innerText = '—';
        document.getElementById('c-out-rev')!.innerText = 'Invalid Input';
        document.getElementById('c-out-occ')!.innerText = '$' + Math.round(monthlyOcc).toLocaleString();
        document.getElementById('c-out-labor')!.innerText = '$' + Math.round(monthlyLabor).toLocaleString();
        document.getElementById('c-out-overhead')!.innerText = '$' + Math.round(overhead).toLocaleString();
      }
    }

    ['c-sqft', 'c-rent', 'c-nnn', 'c-wage', 'c-hours', 'c-ticket', 'c-cogs', 'c-tax', 'c-overhead'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateCalc);
    });

    // Run initial calculation to guarantee parity
    updateCalc();
  </script>
</Layout>
