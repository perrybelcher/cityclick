                <a
                  href={`/${city.slug}/?tab=moving`}
                  class="px-2.5 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-black text-[11px] transition flex items-center gap-1 border border-emerald-200/60"
                  title={`View ${city.name} Relocation Guide`}
                >
                  <span>🏡</span> Live
                </a>
                <a
                  href={`/${city.slug}/?tab=business`}
                  class="px-2.5 py-1.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 font-black text-[11px] transition flex items-center gap-1 border border-purple-200/60"
                  title={`Explore ${city.name} Business & Tax Data`}
                >
                  <span>💼</span> Business
                </a>
              </div>

              <!-- Button -->
              <a
                href={`/${city.slug}/`}
                class="w-full text-center py-3 rounded-2xl bg-[#152438] hover:bg-[#1D68F2] text-white font-bold text-xs transition duration-200 shadow-md block"
              >
                Explore {city.name} Guide →
