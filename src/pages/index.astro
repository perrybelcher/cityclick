              <div class="text-sm font-black text-white group-hover:text-blue-200 transition">Austin, TX vs. Nashville, TN</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Compare income, housing & taxes</div>
            </div>
            <span class="text-xl font-bold text-blue-400 group-hover:translate-x-1 transition">→</span>
          </a>

          <a
            href="/compare/ar-hot-springs-vs-ar-hot-springs-village/"
            class="p-5 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 transition flex items-center justify-between group"
