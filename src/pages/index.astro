  <!-- Section 8: Follow a City & Contributor Network -->
  <section id="contribute" class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center bg-gradient-to-br from-[#0F172A] via-[#1E293B] to-[#0B1120] rounded-3xl p-8 sm:p-12 text-white shadow-xl">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30 text-xs font-bold">
            Stay Connected
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Request a city audit or submit a verified correction
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Want your city promoted to our verified flagship tier next, or spotted an updated state tax notice? Reach our data audit desk directly with primary source documentation.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/15 space-y-4">
          <div class="text-xs font-bold text-white">Request city verification updates via email:</div>
          <form class="flex flex-col sm:flex-row gap-2" id="follow-city-form">
            <input
              type="text"
              id="follow-city-topic"
              placeholder="City & state (e.g. Little Rock, AR)"
              required
              class="flex-1 px-4 py-3 rounded-xl bg-white text-slate-800 text-xs outline-none font-medium placeholder-slate-400"
            />
            <button
              type="submit"
              class="px-5 py-3 rounded-xl bg-[#1D68F2] hover:bg-blue-600 text-white font-bold text-xs transition shrink-0 cursor-pointer shadow-md"
            >
              Email Audit Desk →
            </button>
          </form>
          <p id="follow-city-feedback" class="hidden text-xs text-emerald-300 font-semibold"></p>
          <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-white/10">
            <span>Verified public records only. Zero spam.</span>
            <a href="mailto:audit@cityclick.com" class="text-blue-300 hover:underline font-semibold">
              audit@cityclick.com →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Search Autocomplete Script (1,501 Cities, Live Query Handling) -->
  <script define:vars={{ searchIndex }}>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('city-search-input');
      const form = document.getElementById('hero-search-form');
      const dropdown = document.getElementById('search-results-dropdown');
      const urlResultsBox = document.getElementById('search-url-results');
      const followForm = document.getElementById('follow-city-form');
      const followTopic = document.getElementById('follow-city-topic');
      const followFeedback = document.getElementById('follow-city-feedback');

      if (followForm && followTopic) {
        followForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const cityVal = followTopic.value.trim();
          if (!cityVal) return;
          const subject = encodeURIComponent('CityClick Verification Request: ' + cityVal);
          const body = encodeURIComponent('Please notify me when primary-source verification is published for ' + cityVal + '.');
          if (followFeedback) {
            followFeedback.textContent = 'Opening your email client to contact audit@cityclick.com regarding ' + cityVal + '.';
            followFeedback.classList.remove('hidden');
          }
          window.location.href = 'mailto:audit@cityclick.com?subject=' + subject + '&body=' + body;
        });
      }

      function normalize(str) {
        return (str || '').toLowerCase().trim().replace(/[^a-z0-9]/g, '');
      }

      function searchCities(query) {
        const q = normalize(query);
        if (!q) return [];

        return searchIndex
          .filter((c) => {
            const nameNorm = normalize(c.n);
            const fullNorm = normalize(c.n + c.s);
            const slugNorm = normalize(c.u);
            return (
              nameNorm.startsWith(q) ||
              fullNorm.includes(q) ||
              slugNorm.includes(q) ||
              nameNorm.includes(q)
            );
          })
          .sort((a, b) => {
            const aExact = normalize(a.n) === q || normalize(a.n + a.s) === q ? 1 : 0;
            const bExact = normalize(b.n) === q || normalize(b.n + b.s) === q ? 1 : 0;
            if (aExact !== bExact) return bExact - aExact;
            if (a.v !== b.v) return b.v - a.v;
            const aStarts = normalize(a.n).startsWith(q) ? 1 : 0;
            const bStarts = normalize(b.n).startsWith(q) ? 1 : 0;
            if (aStarts !== bStarts) return bStarts - aStarts;
            return a.n.localeCompare(b.n);
          });
      }

      function renderDropdown(matches) {
        if (!dropdown) return;
        if (matches.length === 0) {
          dropdown.innerHTML = `
            <div class="px-4 py-3 text-xs text-slate-500">
              No matching city entry found. Try another city name or browse by state below.
            </div>
          `;
          dropdown.classList.remove('hidden');
          return;
        }

        dropdown.innerHTML = matches
          .slice(0, 8)
          .map(
            (c) => `
          <a href="/${c.u}/" class="block px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
            <span class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full ${c.v ? 'bg-emerald-500' : 'bg-slate-400'}"></span>
              <span>${c.n}, ${c.s}</span>
            </span>
            <span class="text-[10px] ${c.v ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-slate-600 bg-slate-100 border-slate-200'} font-extrabold uppercase px-2 py-0.5 rounded border">
              ${c.v ? 'Verified Guide →' : 'Preview →'}
            </span>
          </a>
        `
          )
          .join('');
        dropdown.classList.remove('hidden');
      }

      function renderPopular() {
        if (!dropdown) return;
        dropdown.innerHTML = `
          <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-100 flex items-center justify-between text-[11px] font-black uppercase tracking-wider text-slate-500">
            <span>⭐ Verified Flagship Guides</span>
            <span class="text-emerald-700 font-bold">7 Certified Cities</span>
          </div>
          <div class="divide-y divide-slate-100">
            <a href="/tx/austin/" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Austin, TX</span>
              <span class="text-[10px] text-emerald-700 font-extrabold uppercase bg-emerald-50 px-2 py-0.5 rounded">Verified →</span>
            </a>
            <a href="/tn/nashville/" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Nashville, TN</span>
              <span class="text-[10px] text-emerald-700 font-extrabold uppercase bg-emerald-50 px-2 py-0.5 rounded">Verified →</span>
            </a>
            <a href="/ar/hot-springs/" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Hot Springs, AR</span>
              <span class="text-[10px] text-emerald-700 font-extrabold uppercase bg-emerald-50 px-2 py-0.5 rounded">Verified →</span>
            </a>
            <a href="/ar/hot-springs-village/" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Hot Springs Village, AR</span>
              <span class="text-[10px] text-emerald-700 font-extrabold uppercase bg-emerald-50 px-2 py-0.5 rounded">Verified →</span>
            </a>
            <a href="/fl/tampa/" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Tampa, FL</span>
              <span class="text-[10px] text-emerald-700 font-extrabold uppercase bg-emerald-50 px-2 py-0.5 rounded">Verified →</span>
            </a>
            <a href="/id/boise/" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Boise, ID</span>
              <span class="text-[10px] text-emerald-700 font-extrabold uppercase bg-emerald-50 px-2 py-0.5 rounded">Verified →</span>
            </a>
            <a href="/az/scottsdale/" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Scottsdale, AZ</span>
              <span class="text-[10px] text-emerald-700 font-extrabold uppercase bg-emerald-50 px-2 py-0.5 rounded">Verified →</span>
            </a>
          </div>
        `;
        dropdown.classList.remove('hidden');
      }

      if (input) {
        input.addEventListener('focus', () => {
          if (!input.value.trim()) {
            renderPopular();
          }
        });

        input.addEventListener('input', () => {
          const val = input.value.trim();
          if (val.length < 1) {
            renderPopular();
            return;
          }
          const matches = searchCities(val);
          renderDropdown(matches);
        });

        document.addEventListener('click', (e) => {
          if (form && dropdown && !form.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.add('hidden');
          }
        });
      }

      if (form && input) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const query = input.value.trim();
          if (!query) return;

          const matches = searchCities(query);
          if (matches.length > 0) {
            window.location.href = `/${matches[0].u}/`;
          } else {
            renderDropdown([]);
          }
        });
      }

      const urlParams = new URLSearchParams(window.location.search);
      const searchParam = urlParams.get('search') || urlParams.get('q');
      if (searchParam && input) {
        input.value = searchParam;
        const matches = searchCities(searchParam);
        if (matches.length > 0 && urlResultsBox) {
          urlResultsBox.innerHTML = `
            <div class="font-bold text-slate-800 mb-2">Search results for "${searchParam}":</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              ${matches
                .slice(0, 6)
                .map(
                  (c) => `
                <a href="/${c.u}/" class="p-2.5 rounded-xl bg-white border border-blue-200 hover:border-blue-500 font-bold text-slate-800 flex justify-between items-center">
                  <span>${c.n}, ${c.s}</span>
                  <span class="text-[10px] ${c.v ? 'text-emerald-700' : 'text-blue-600'} uppercase font-extrabold">${c.v ? 'Verified →' : 'Preview →'}</span>
                </a>
              `
                )
                .join('')}
            </div>
          `;
          urlResultsBox.classList.remove('hidden');
        }
      }
    });
  </script>
</Layout>
