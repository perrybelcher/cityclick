---
import Layout from '../layouts/Layout.astro';
import manifest from '../data/index-manifest.json';

// Curated 6 Premier Hubs with High-Quality Photography & Discovery Focus
const FEATURED_CITIES = [
  {
    slug: 'tx/austin',
    name: 'Austin',
    state: 'Texas',
    stateCode: 'TX',
    image: '/images/austin-skyline.jpg',
    appeal: 'Live music capital, booming tech corridors, Lady Bird Lake recreation, and zero state income tax.',
    tagline: 'Urban Innovation & Culture'
  },
  {
    slug: 'ar/hot-springs-village',
    name: 'Hot Springs Village',
    state: 'Arkansas',
    stateCode: 'AR',
    image: '/images/hsv-hero.jpg',
    appeal: 'America’s largest gated community with 11 recreational lakes, 9 championship golf courses, and 0.62% property tax.',
    tagline: 'Scenic Lakeside Living'
  },
  {
    slug: 'id/boise',
    name: 'Boise',
    state: 'Idaho',
    stateCode: 'ID',
    image: '/images/boise-hero.jpg',
    appeal: 'High-growth Treasure Valley hub featuring the 25-mile Boise River Greenbelt and 2,704 ft mountain foothills.',
    tagline: 'Mountain West Boomtown'
  },
  {
    slug: 'fl/tampa',
    name: 'Tampa',
    state: 'Florida',
    stateCode: 'FL',
    image: '/images/tampa-hero.jpg',
    appeal: 'Gulf Coast waterfront metro with historic brick Ybor City, modern Water Street district, and 0% personal income tax.',
    tagline: 'Waterfront Gulf Metropolis'
  },
  {
    slug: 'az/scottsdale',
    name: 'Scottsdale',
    state: 'Arizona',
    stateCode: 'AZ',
    image: '/images/scottsdale-hero.jpg',
    appeal: 'Sonoran Desert luxury enclave renowned for world-class resorts, championship golf, and high purchasing power.',
    tagline: 'Desert Resort Corridor'
  },
  {
    slug: 'tn/nashville',
    name: 'Nashville',
    state: 'Tennessee',
    stateCode: 'TN',
    image: '/images/nashville-hero.jpg',
    appeal: 'Music City destination with legendary live entertainment, major healthcare systems, and 0% state income tax.',
    tagline: 'Music Capital & Healthcare'
  }
];

// Lightweight search index for all 1,501 cities (fast, client-side, zero lag)
const searchIndex = manifest.map(c => ({
  n: c.name,
  s: c.stateCode.toUpperCase(),
  u: c.slug
}));

// Group all 1,501 cities by state for the directory
const stateCounts: Record<string, { code: string; name: string; count: number }> = {};
manifest.forEach(c => {
  const code = c.stateCode.toLowerCase();
  if (!stateCounts[code]) {
    stateCounts[code] = { code, name: c.stateName, count: 0 };
  }
  stateCounts[code].count++;
});
const statesList = Object.values(stateCounts).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title="CityClick — Get to know your next city"
  description="Plan a visit, find a place to live, or research your next business location. Verified local guides across 1,501 American cities."
  image="https://cityclick.com/images/og-cityclick.jpg"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#EDF4FC] via-[#F8FAFC] to-white pt-14 pb-20 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Left Column: Simple Human Hero Copy & Powerful Search -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-xs font-bold text-[#1D68F2]">
            <span class="w-2 h-2 rounded-full bg-[#1D68F2] animate-pulse"></span>
            1,501 city guides available · More local information added every week
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#152438] tracking-tight leading-[1.12]">
            Get to know your next city.
          </h1>

          <p class="text-base sm:text-lg text-slate-600 max-w-xl leading-relaxed">
            Plan a visit, find a place to live, or research your next business location. Start with a city.
          </p>

          <!-- Search Interface with Persistent Visible Label -->
          <div class="space-y-2 max-w-xl">
            <label for="city-search-input" class="block text-xs font-black uppercase tracking-wider text-slate-700">
              Which city are you exploring?
            </label>

            <div class="relative">
              <form id="hero-search-form" class="bg-white p-2 sm:p-2.5 rounded-2xl shadow-xl border border-slate-200 flex items-center gap-3">
                <div class="pl-3 text-slate-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                <input
                  id="city-search-input"
                  type="text"
                  autocomplete="off"
                  placeholder="Enter a city and state (e.g. Boston, Austin, Boise)..."
                  class="flex-1 border-0 focus:ring-0 text-slate-800 placeholder-slate-400 text-sm sm:text-base outline-none bg-transparent"
                />
                <button
                  type="submit"
                  id="hero-search-btn"
                  class="px-5 py-3 rounded-xl bg-[#1D68F2] hover:bg-[#1555C7] text-white text-sm font-bold transition flex items-center gap-1 shrink-0 cursor-pointer shadow-md"
                >
                  Explore city
                </button>
              </form>

              <!-- Live Autocomplete & Search Results Dropdown -->
              <div
                id="search-results-dropdown"
                class="absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden z-50 hidden divide-y divide-slate-100 max-h-72 overflow-y-auto"
              ></div>
            </div>

            <!-- In-Page Search Results Container (When landing via ?search=...) -->
            <div id="search-url-results" class="hidden p-4 rounded-2xl bg-blue-50 border border-blue-200 text-xs"></div>
          </div>

          <!-- Featured Cities Quick Links -->
          <div class="flex items-center gap-2 text-xs text-slate-500 pt-1 flex-wrap">
            <span class="font-bold text-slate-400 uppercase tracking-wider text-[10px]">Featured cities:</span>
            <a href="/tx/austin" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Austin, TX</a>
            <a href="/ar/hot-springs-village" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Hot Springs Village, AR</a>
            <a href="/id/boise" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Boise, ID</a>
            <a href="/fl/tampa" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Tampa, FL</a>
            <a href="/ma/boston" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Boston, MA</a>
          </div>
        </div>

        <!-- Right Column: 3-Photo Authentic City Showcase Composition -->
        <div class="lg:col-span-5">
          <div class="grid grid-cols-2 gap-3.5 sm:gap-4">
            <!-- 1. Austin (Large Span) -->
            <a href="/tx/austin" class="col-span-2 group relative rounded-3xl overflow-hidden shadow-xl border border-slate-200 h-48 block">
              <img
                src="/images/austin-skyline.jpg"
                alt="Austin, Texas Downtown Skyline"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700 filter brightness-[0.75]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-5 text-white">
                <span class="text-[10px] font-black uppercase tracking-wider text-blue-300">Featured Urban Guide</span>
                <div class="text-xl font-black text-white group-hover:text-blue-200 transition">Austin, Texas</div>
                <div class="text-xs text-slate-300">Live music capital · Tech corridors · Hill Country</div>
              </div>
            </a>

            <!-- 2. Hot Springs Village (Lakeside) -->
            <a href="/ar/hot-springs-village" class="group relative rounded-3xl overflow-hidden shadow-lg border border-slate-200 h-44 block">
              <img
                src="/images/hsv-hero.jpg"
                alt="Hot Springs Village, Arkansas Lake & Mountains"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700 filter brightness-[0.80]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-4 text-white">
                <span class="text-[9px] font-black uppercase tracking-wider text-emerald-300">Lakeside Enclave</span>
                <div class="text-sm font-black text-white group-hover:text-emerald-200 transition">Hot Springs Village, AR</div>
                <div class="text-[11px] text-slate-300">11 Lakes · 9 Golf Courses</div>
              </div>
            </a>

            <!-- 3. Boise (Mountain West) -->
            <a href="/id/boise" class="group relative rounded-3xl overflow-hidden shadow-lg border border-slate-200 h-44 block">
              <img
                src="/images/boise-hero.jpg"
                alt="Boise, Idaho River Greenbelt & Skyline"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700 filter brightness-[0.80]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-4 text-white">
                <span class="text-[9px] font-black uppercase tracking-wider text-purple-300">Mountain West</span>
                <div class="text-sm font-black text-white group-hover:text-purple-200 transition">Boise, Idaho</div>
                <div class="text-[11px] text-slate-300">River Greenbelt · 2,704 ft</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Cities (Curated Discovery Cards) -->
  <section id="featured" class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-[#152438] tracking-tight">
            Featured Cities
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Explore complete guides covering places to visit, neighborhood living, and commercial intelligence.
          </p>
        </div>
        <div class="mt-4 md:mt-0 text-xs font-bold text-slate-400">
          Curated Discovery
        </div>
      </div>

      <!-- 6 Attractive Featured City Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {FEATURED_CITIES.map((city) => (
          <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:border-blue-400 transition duration-300 overflow-hidden flex flex-col justify-between group">
            <!-- Card Image Layer -->
            <a href={`/${city.slug}`} class="relative h-48 overflow-hidden block">
              <img
                src={city.image}
                alt={`${city.name}, ${city.state} Overview`}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700 filter brightness-[0.85]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent flex items-end p-4 text-white">
                <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-blue-200 border border-white/20">
                  {city.tagline}
                </span>
              </div>
            </a>

            <!-- Card Body -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <div class="flex justify-between items-start">
                  <div>
                    <h3 class="text-xl font-black text-[#152438] tracking-tight group-hover:text-[#1D68F2] transition">
                      {city.name}, {city.state}
                    </h3>
                  </div>
                </div>

                <p class="text-xs text-slate-600 leading-relaxed">
                  {city.appeal}
                </p>
              </div>

              <!-- 3 Interactive Direct Action Portals -->
              <div class="pt-3 border-t border-slate-100 flex items-center gap-1.5 flex-wrap">
                <a
                  href={`/${city.slug}?tab=travel`}
                  class="px-2.5 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-[#1D68F2] font-black text-[11px] transition flex items-center gap-1 border border-blue-200/60"
                  title={`View ${city.name} Visitor Guide`}
                >
                  <span>✈️</span> Visit
                </a>
                <a
                  href={`/${city.slug}?tab=moving`}
                  class="px-2.5 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-black text-[11px] transition flex items-center gap-1 border border-emerald-200/60"
                  title={`View ${city.name} Relocation Checklist & Schools`}
                >
                  <span>🏡</span> Live
                </a>
                <a
                  href={`/${city.slug}?tab=business`}
                  class="px-2.5 py-1.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 font-black text-[11px] transition flex items-center gap-1 border border-purple-200/60"
                  title={`Underwrite ${city.name} Commercial Trades & Rents`}
                >
                  <span>💼</span> Business
                </a>
              </div>

              <!-- Button -->
              <a
                href={`/${city.slug}`}
                class="w-full text-center py-3 rounded-2xl bg-[#152438] hover:bg-[#1D68F2] text-white font-bold text-xs transition duration-200 shadow-md block"
              >
                Explore {city.name} Guide →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Head-to-Head City Comparison Module -->
  <section id="compare" class="py-14 bg-gradient-to-b from-white to-[#F8FAFC] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-[#152438] via-slate-900 to-[#0F172A] rounded-3xl p-8 sm:p-12 text-white shadow-xl">
        <div class="max-w-2xl space-y-3 mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30 text-xs font-bold uppercase tracking-wider">
            <span>⚖️</span> Head-to-Head Comparison
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight">
            Compare Any Two Cities
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Side-by-side analysis of cost of living, effective tax burdens, median home prices, commercial asking rents, and climate normals.
          </p>
        </div>

        <!-- 3 Curated Comparison Presets -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a
            href="/compare/tx-austin-vs-fl-tampa"
            class="p-5 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 transition flex items-center justify-between group"
          >
            <div>
              <div class="text-[10px] uppercase font-bold text-blue-300 mb-1">0% State Income Tax Showdown</div>
              <div class="text-sm font-black text-white group-hover:text-blue-200 transition">Austin, TX vs. Tampa, FL</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Inland tech capital vs. Gulf Coast waterfront</div>
            </div>
            <span class="text-xl font-bold text-blue-400 group-hover:translate-x-1 transition">→</span>
          </a>

          <a
            href="/compare/id-boise-vs-az-scottsdale"
            class="p-5 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 transition flex items-center justify-between group"
          >
            <div>
              <div class="text-[10px] uppercase font-bold text-emerald-300 mb-1">Western Boomtown Comparison</div>
              <div class="text-sm font-black text-white group-hover:text-emerald-200 transition">Boise, ID vs. Scottsdale, AZ</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Pacific Northwest greenbelt vs. Sonoran resort</div>
            </div>
            <span class="text-xl font-bold text-emerald-400 group-hover:translate-x-1 transition">→</span>
          </a>

          <a
            href="/compare/tx-austin-vs-ar-hot-springs-village"
            class="p-5 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 transition flex items-center justify-between group"
          >
            <div>
              <div class="text-[10px] uppercase font-bold text-purple-300 mb-1">Urban Hub vs. Gated Enclave</div>
              <div class="text-sm font-black text-white group-hover:text-purple-200 transition">Austin vs. Hot Springs Village</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Metro density vs. 11 lakes and 9 golf courses</div>
            </div>
            <span class="text-xl font-bold text-purple-400 group-hover:translate-x-1 transition">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- See a Place Before You Choose It (Experience Previews) -->
  <section id="experience" class="py-16 bg-[#F8FAFC] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl sm:text-3xl font-black text-[#152438] tracking-tight">
          See a place before you choose it
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          Every city guide connects authentic visual orientation with practical data to help you decide and act.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 1. Walk a Neighborhood / Relocate -->
        <div id="relocate" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-3 scroll-mt-24">
          <div class="w-10 h-10 rounded-2xl bg-blue-100 text-[#1D68F2] flex items-center justify-center font-bold text-lg">
            🚶
          </div>
          <h3 class="text-base font-black text-[#152438]">Walk a Neighborhood</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            4K aerial drone tours and street-level footage let you see housing styles, parks, and retail corridors before traveling.
          </p>
          <a href="/ar/hot-springs-village/" class="inline-flex items-center text-xs font-bold text-[#1D68F2] hover:text-blue-700">
            Preview Video Experience →
          </a>
        </div>

        <!-- 2. Plan a Visit -->
        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg">
            📋
          </div>
          <h3 class="text-base font-black text-[#152438]">Plan a Visit</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Airport distance, highway transit corridors, drinking water potability, emergency trauma centers, and curated stays by district.
          </p>
          <a href="/id/boise/" class="inline-flex items-center text-xs font-bold text-emerald-700 hover:text-emerald-900">
            Preview Visitor Guide →
          </a>
        </div>

        <!-- 3. See What is Changing -->
        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-lg">
            🏗️
          </div>
          <h3 class="text-base font-black text-[#152438]">See the Business Numbers</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Commercial rent benchmarks, permit timelines, sales-tax rates, and SBA lender data for each city guide.
          </p>
          <a href="/tx/austin/" class="inline-flex items-center text-xs font-bold text-purple-700 hover:text-purple-900">
            Preview Austin Guide →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Recently Verified Updates (Visible Continuous Research) -->
  <section id="recent-updates" class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-50 text-[11px] font-bold text-emerald-700 mb-2 uppercase tracking-wider border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Continuous Research Wire
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-[#152438] tracking-tight">
            Recently verified updates
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Evidence of ongoing local research, public notices, and municipal record maintenance across our published guides.
          </p>
        </div>
        <div class="mt-3 md:mt-0 text-xs font-semibold text-slate-400">
          Source audits updated daily
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Update 1: Hot Springs Village -->
        <a href="/ar/hot-springs-village" class="p-5 rounded-3xl bg-[#F8FAFC] border border-slate-200/80 hover:border-emerald-400 hover:shadow-md transition flex flex-col justify-between group space-y-3">
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[11px]">
              <span class="font-extrabold text-[#152438] group-hover:text-emerald-700 transition">Hot Springs Village, AR</span>
              <span class="text-slate-400 font-medium">Updated yesterday</span>
            </div>
            <div class="text-xs font-bold text-slate-800">Water Compliance & Gated Access Protocols</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              Verified 100% EPA Safe Drinking Water Act compliance (PWSID AR0000208) and added 24/7 guarded gate access rules for East and West visitor checkpoints.
            </p>
          </div>
          <span class="text-[11px] font-bold text-emerald-700 flex items-center gap-1 group-hover:underline">
            View Verified Record →
          </span>
        </a>

        <!-- Update 2: Austin -->
        <a href="/tx/austin" class="p-5 rounded-3xl bg-[#F8FAFC] border border-slate-200/80 hover:border-blue-400 hover:shadow-md transition flex flex-col justify-between group space-y-3">
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[11px]">
              <span class="font-extrabold text-[#152438] group-hover:text-[#1D68F2] transition">Austin, Texas</span>
              <span class="text-slate-400 font-medium">Updated 2 days ago</span>
            </div>
            <div class="text-xs font-bold text-slate-800">Airport Rideshare & Pool Maintenance Schedule</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
              Updated Austin-Bergstrom (AUS) rideshare pickup protocol (Level 1 Rental Car Garage) and confirmed Barton Springs Pool Thursday cleaning hours (closed 9am–7pm).
            </p>
          </div>
          <span class="text-[11px] font-bold text-[#1D68F2] flex items-center gap-1 group-hover:underline">
            View Verified Record →
          </span>
        </a>

        <!-- Update 3: Boise -->
        <a href="/id/boise" class="p-5 rounded-3xl bg-[#F8FAFC] border border-slate-200/80 hover:border-purple-400 hover:shadow-md transition flex flex-col justify-between group space-y-3">
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[11px]">
              <span class="font-extrabold text-[#152438] group-hover:text-purple-700 transition">Boise, Idaho</span>
              <span class="text-slate-400 font-medium">Updated 3 days ago</span>
            </div>
            <div class="text-xs font-bold text-slate-800">Transit Corridor & Small-Business Lending</div>
            <p class="text-[11px] text-slate-600 leading-relaxed">
