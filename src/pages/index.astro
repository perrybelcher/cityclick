  <!-- Interactive Search Autocomplete Script (1,501 Cities, Live Query Handling) -->
  <script define:vars={{ searchIndex }}>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('city-search-input');
      const form = document.getElementById('hero-search-form');
      const dropdown = document.getElementById('search-results-dropdown');
      const urlResultsBox = document.getElementById('search-url-results');

      function normalize(str) {
        return (str || '').toLowerCase().trim().replace(/[^a-z0-9]/g, '');
      }

      function searchCities(query) {
        const q = normalize(query);
        if (!q) return [];

        return searchIndex.filter(c => {
          const nameNorm = normalize(c.n);
          const stateNorm = normalize(c.s);
          const fullNorm = normalize(c.n + c.s);
          const slugNorm = normalize(c.u);

          return nameNorm.startsWith(q) || 
                 fullNorm.includes(q) || 
                 slugNorm.includes(q) || 
                 nameNorm.includes(q);
        }).sort((a, b) => {
          // Exact name match first
          if (normalize(a.n) === q) return -1;
          if (normalize(b.n) === q) return 1;
          return a.n.localeCompare(b.n);
        });
      }

      function renderDropdown(matches) {
        if (!dropdown) return;
        if (matches.length === 0) {
          dropdown.innerHTML = `
            <div class="px-4 py-3 text-xs text-slate-500">
              No matching published guide found. Try another city name or explore by state below.
            </div>
          `;
          dropdown.classList.remove('hidden');
          return;
        }

        dropdown.innerHTML = matches.slice(0, 7).map(c => `
          <a href="/${c.u}" class="block px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
            <span class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              <span>${c.n}, ${c.s}</span>
            </span>
            <span class="text-[10px] text-blue-600 font-extrabold uppercase bg-blue-50 px-2 py-0.5 rounded border border-blue-100">Explore Guide →</span>
          </a>
        `).join('');
        dropdown.classList.remove('hidden');
      }

      function renderPopular() {
        if (!dropdown) return;
        dropdown.innerHTML = `
          <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-100 flex items-center justify-between text-[11px] font-black uppercase tracking-wider text-slate-500">
            <span>🔥 Popular Destinations</span>
            <span class="text-blue-600 font-bold">1,501 Guides Live</span>
          </div>
          <div class="divide-y divide-slate-100">
            <a href="/tx/austin" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Austin, TX</span>
              <span class="text-[10px] text-blue-600 font-extrabold uppercase bg-blue-50 px-2 py-0.5 rounded">Featured →</span>
            </a>
            <a href="/ar/hot-springs-village" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Hot Springs Village, AR</span>
              <span class="text-[10px] text-emerald-600 font-extrabold uppercase bg-emerald-50 px-2 py-0.5 rounded">Lakeside →</span>
            </a>
            <a href="/fl/tampa" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Tampa, FL</span>
              <span class="text-[10px] text-indigo-600 font-extrabold uppercase bg-indigo-50 px-2 py-0.5 rounded">Gulf Coast →</span>
            </a>
            <a href="/id/boise" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Boise, ID</span>
              <span class="text-[10px] text-purple-600 font-extrabold uppercase bg-purple-50 px-2 py-0.5 rounded">Mountain West →</span>
            </a>
            <a href="/az/scottsdale" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Scottsdale, AZ</span>
              <span class="text-[10px] text-amber-600 font-extrabold uppercase bg-amber-50 px-2 py-0.5 rounded">Desert Resort →</span>
            </a>
            <a href="/ma/boston" class="px-4 py-3 hover:bg-blue-50/60 text-xs font-bold text-slate-800 flex justify-between items-center transition">
              <span class="flex items-center gap-2"><span>⭐</span> Boston, MA</span>
              <span class="text-[10px] text-blue-600 font-extrabold uppercase bg-blue-50 px-2 py-0.5 rounded">New England →</span>
            </a>
          </div>
        `;
        dropdown.classList.remove('hidden');
      }

      if (input) {
        input.addEventListener('focus', () => {
          if (!input.value.trim()) {
            renderPopular();
          }
        });

        input.addEventListener('input', () => {
          const val = input.value.trim();
          if (val.length < 1) {
            renderPopular();
            return;
          }
          const matches = searchCities(val);
          renderDropdown(matches);
        });

        // Hide dropdown on outside click
        document.addEventListener('click', (e) => {
          if (!form.contains(e.target)) {
            dropdown.classList.add('hidden');
          }
        });
      }

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const query = input.value.trim();
          if (!query) return;

          const matches = searchCities(query);
          if (matches.length > 0) {
            // Instant redirect to top match (e.g. Boston, MA -> /ma/boston)
            window.location.href = `/${matches[0].u}`;
          } else {
            renderDropdown([]);
          }
        });
      }

      // Check URL query parameters (e.g. /?search=Boston or /?q=Boston)
      const urlParams = new URLSearchParams(window.location.search);
      const searchParam = urlParams.get('search') || urlParams.get('q');
      if (searchParam && input) {
        input.value = searchParam;
        const matches = searchCities(searchParam);
        if (matches.length > 0) {
          if (urlResultsBox) {
            urlResultsBox.innerHTML = `
              <div class="font-bold text-slate-800 mb-2">Search results for "${searchParam}":</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                ${matches.slice(0, 6).map(c => `
                  <a href="/${c.u}" class="p-2.5 rounded-xl bg-white border border-blue-200 hover:border-blue-500 font-bold text-slate-800 flex justify-between items-center">
                    <span>${c.n}, ${c.s}</span>
                    <span class="text-[10px] text-blue-600 uppercase font-extrabold">Open Guide →</span>
                  </a>
                `).join('')}
              </div>
            `;
            urlResultsBox.classList.remove('hidden');
          }
        }
      }
    });
  </script>
