---
import Layout from '../layouts/Layout.astro';
import manifest from '../data/index-manifest.json';

// Curated 7 Certified Flagship Hubs with Primary-Sourced Data & Photography
const FEATURED_CITIES = [
  {
    slug: 'tx/austin',
    name: 'Austin',
    state: 'Texas',
    stateCode: 'TX',
    image: '/images/austin-skyline.jpg',
    appeal: 'Census demographics, housing costs, Open-Meteo climate, CMS emergency hospitals, colleges, EV charging, and sales-tax data for Austin, Texas.',
    tagline: 'Texas Capital'
  },
  {
    slug: 'tn/nashville',
    name: 'Nashville',
    state: 'Tennessee',
    stateCode: 'TN',
    image: '/images/nashville-hero.jpg',
    appeal: 'Primary-sourced population, housing, elevation, airport, CMS hospital, university, and NAICS trade density guide for Nashville, Tennessee.',
    tagline: 'Middle Tennessee'
  },
  {
    slug: 'ar/hot-springs',
    name: 'Hot Springs',
    state: 'Arkansas',
    stateCode: 'AR',
    image: '/images/hot-springs-hero.jpg',
    appeal: 'Verified Census housing, Hot Springs National Park access, municipal water, CMS hospitals, and retail sales-tax guide for Hot Springs, Arkansas.',
    tagline: 'National Park City'
  },
  {
    slug: 'ar/hot-springs-village',
    name: 'Hot Springs Village',
    state: 'Arkansas',
    stateCode: 'AR',
    image: '/images/hsv-hero.jpg',
    appeal: 'Census ACS demographics, housing values, Ouachita foothills elevation, and Garland County infrastructure guide for Hot Springs Village, Arkansas.',
    tagline: 'Ouachita Foothills'
  },
  {
    slug: 'id/boise',
    name: 'Boise',
    state: 'Idaho',
    stateCode: 'ID',
    image: '/images/boise-hero.jpg',
    appeal: 'Primary-sourced demographics, Boise Airport proximity, USGS elevation, universities, and small-business trade counts for Boise, Idaho.',
    tagline: 'Mountain West'
  },
  {
    slug: 'fl/tampa',
    name: 'Tampa',
    state: 'Florida',
    stateCode: 'FL',
    image: '/images/tampa-hero.jpg',
    appeal: 'Verified Census housing, Tampa International Airport distance, Gulf Coast climate averages, and NAICS trade density for Tampa, Florida.',
    tagline: 'Gulf Coast'
  },
  {
    slug: 'az/scottsdale',
    name: 'Scottsdale',
    state: 'Arizona',
    stateCode: 'AZ',
    image: '/images/scottsdale-hero.jpg',
    appeal: 'Census income and home values, Sonoran Desert climate and elevation, CMS hospitals, and retail tax breakdown for Scottsdale, Arizona.',
    tagline: 'Sonoran Desert'
  }
];

const CERTIFIED_SET = new Set(FEATURED_CITIES.map((c) => c.slug));

// Lightweight search index for all 1,501 cities (fast, client-side, zero lag)
const searchIndex = manifest.map((c: any) => ({
  n: c.name,
  s: c.stateCode.toUpperCase(),
  u: c.slug,
  v: CERTIFIED_SET.has(c.slug) ? 1 : 0,
}));

// Group all 1,501 cities by state for the directory
const stateCounts: Record<string, { code: string; name: string; count: number }> = {};
manifest.forEach((c: any) => {
  const code = c.stateCode.toLowerCase();
  if (!stateCounts[code]) {
    stateCounts[code] = { code, name: c.stateName, count: 0 };
  }
  stateCounts[code].count++;
});
const statesList = Object.values(stateCounts).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title="CityClick — Get to know your next city"
  description="Plan a visit, find a place to live, or research your next business location. Primary-sourced guides for seven verified US cities, with 1,494 more in review."
  image="https://cityclick.com/images/og-cityclick.jpg"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#EDF4FC] via-[#F8FAFC] to-white pt-14 pb-20 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Left Column: Simple Human Hero Copy & Powerful Search -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-xs font-bold text-[#1D68F2]">
            <span class="w-2 h-2 rounded-full bg-[#1D68F2] animate-pulse"></span>
            7 verified city guides · 1,494 more in review, added as each passes our data checks
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#152438] tracking-tight leading-[1.12]">
            Get to know your next city.
          </h1>

          <p class="text-base sm:text-lg text-slate-600 max-w-xl leading-relaxed">
            Plan a visit, find a place to live, or research your next business location. Every published metric cites its primary federal, state, or municipal source.
          </p>

          <!-- Search Interface with Persistent Visible Label -->
          <div class="space-y-2 max-w-xl">
            <label for="city-search-input" class="block text-xs font-black uppercase tracking-wider text-slate-700">
              Which city are you exploring?
            </label>

            <div class="relative">
              <form id="hero-search-form" class="bg-white p-2 sm:p-2.5 rounded-2xl shadow-xl border border-slate-200 flex items-center gap-3">
                <div class="pl-3 text-slate-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                <input
                  id="city-search-input"
                  type="text"
                  autocomplete="off"
                  placeholder="Enter a city and state (e.g. Austin, Nashville, Hot Springs)..."
                  class="flex-1 border-0 focus:ring-0 text-slate-800 placeholder-slate-400 text-sm sm:text-base outline-none bg-transparent"
                />
                <button
                  type="submit"
                  id="hero-search-btn"
                  class="px-5 py-3 rounded-xl bg-[#1D68F2] hover:bg-[#1555C7] text-white text-sm font-bold transition flex items-center gap-1 shrink-0 cursor-pointer shadow-md"
                >
                  Explore city
                </button>
              </form>

              <!-- Live Autocomplete & Search Results Dropdown -->
              <div
                id="search-results-dropdown"
                class="absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden z-50 hidden divide-y divide-slate-100 max-h-80 overflow-y-auto"
              ></div>
            </div>

            <!-- In-Page Search Results Container (When landing via ?search=...) -->
            <div id="search-url-results" class="hidden p-4 rounded-2xl bg-blue-50 border border-blue-200 text-xs"></div>
          </div>

          <!-- Featured Cities Quick Links -->
          <div class="flex items-center gap-2 text-xs text-slate-500 pt-1 flex-wrap">
            <span class="font-bold text-slate-400 uppercase tracking-wider text-[10px]">Verified guides:</span>
            <a href="/tx/austin/" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Austin, TX</a>
            <a href="/tn/nashville/" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Nashville, TN</a>
            <a href="/ar/hot-springs/" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Hot Springs, AR</a>
            <a href="/ar/hot-springs-village/" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Hot Springs Village, AR</a>
            <a href="/id/boise/" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Boise, ID</a>
            <a href="/fl/tampa/" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Tampa, FL</a>
            <a href="/az/scottsdale/" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1D68F2] transition font-semibold">Scottsdale, AZ</a>
          </div>
        </div>

        <!-- Right Column: 3-Photo Authentic City Showcase Composition -->
        <div class="lg:col-span-5">
          <div class="grid grid-cols-2 gap-3.5 sm:gap-4">
            <!-- 1. Austin (Large Span) -->
            <a href="/tx/austin/" class="col-span-2 group relative rounded-3xl overflow-hidden shadow-xl border border-slate-200 h-48 block">
              <img
                src="/images/austin-skyline.jpg"
                alt="Austin, Texas Downtown Skyline"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700 filter brightness-[0.75]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-5 text-white">
                <span class="text-[10px] font-black uppercase tracking-wider text-blue-300">Featured Urban Guide</span>
                <div class="text-xl font-black text-white group-hover:text-blue-200 transition">Austin, Texas</div>
                <div class="text-xs text-slate-300">Verified Texas flagship guide</div>
              </div>
            </a>

            <!-- 2. Hot Springs, AR -->
            <a href="/ar/hot-springs/" class="group relative rounded-3xl overflow-hidden shadow-lg border border-slate-200 h-44 block">
              <img
                src="/images/hot-springs-hero.jpg"
                alt="Hot Springs, Arkansas National Park & Bathhouse Row"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700 filter brightness-[0.80]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-4 text-white">
                <span class="text-[9px] font-black uppercase tracking-wider text-emerald-300">National Park City</span>
                <div class="text-sm font-black text-white group-hover:text-emerald-200 transition">Hot Springs, AR</div>
                <div class="text-[11px] text-slate-300">Verified Arkansas guide</div>
              </div>
            </a>

            <!-- 3. Nashville, TN -->
            <a href="/tn/nashville/" class="group relative rounded-3xl overflow-hidden shadow-lg border border-slate-200 h-44 block">
              <img
                src="/images/nashville-hero.jpg"
                alt="Nashville, Tennessee Downtown Skyline"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700 filter brightness-[0.80]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-4 text-white">
                <span class="text-[9px] font-black uppercase tracking-wider text-purple-300">Middle Tennessee</span>
                <div class="text-sm font-black text-white group-hover:text-purple-200 transition">Nashville, TN</div>
                <div class="text-[11px] text-slate-300">Verified Tennessee guide</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Cities (Curated Discovery Cards) -->
  <section id="featured" class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-[#152438] tracking-tight">
            Verified Flagship City Guides
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Complete primary-sourced guides covering visitor logistics, housing and tax costs, and small-business trade density.
          </p>
        </div>
        <div class="mt-4 md:mt-0 text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
          7 Certified Cities
        </div>
      </div>

      <!-- 7 Attractive Featured City Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {FEATURED_CITIES.map((city) => (
          <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:border-blue-400 transition duration-300 overflow-hidden flex flex-col justify-between group">
            <!-- Card Image Layer -->
            <a href={`/${city.slug}/`} class="relative h-48 overflow-hidden block">
              <img
                src={city.image}
                alt={`${city.name}, ${city.state} Overview`}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700 filter brightness-[0.85]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent flex items-end justify-between p-4 text-white">
                <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-blue-200 border border-white/20">
                  {city.tagline}
                </span>
                <span class="px-2.5 py-1 rounded-full bg-emerald-500/80 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-white">
